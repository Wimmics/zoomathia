PREFIX oa:     <http://www.w3.org/ns/oa#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

SELECT DISTINCT ?paragraph ?name_animal ?name_ethology WHERE {
  ?annotation2 oa:hasBody ?ethology;
        oa:hasTarget [oa:hasSource ?paragraph;
                      oa:hasSelector [oa:exact ?mention_ethology]].

  ?ethology skos:prefLabel ?name_ethology.
  <https://opentheso.huma-num.fr/?idg=MT_13&idt=th310> skos:member ?ethology.

  ?annotation1 oa:hasBody ?animal;
               oa:hasTarget [oa:hasSource ?paragraph;
                             oa:hasSelector [oa:exact ?mention_animal]].

  ?animal a skos:Concept; skos:prefLabel ?name_animal.
  <https://opentheso.huma-num.fr/?idg=MT_7&idt=th310> skos:member ?animal.

  FILTER (lang(?name_animal) = "en").
  FILTER (lang(?name_ethology) = "en")
}
ORDER BY ?paragraph
