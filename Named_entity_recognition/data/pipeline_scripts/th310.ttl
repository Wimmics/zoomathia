    "Theophrastus"@en, "Theophrastus"@nl;
  skos:broader <https://opentheso.huma-num.fr/?idc=105302&idt=th310>, <https://opentheso.huma-num.fr/?idc=pcrtYRXe70hxrn&idt=th310>;
