  dcterms:identifier "pcrtTgttY2SfBr";
  dcterms:description "pcrtvWHPMsEEqO##pcrtEznNgQ3h63##pcrtxs8Kml8jLw##pcrtTgttY2SfBr";
  skos:definition "Fragment de roche arrondi par usure mécanique, éolienne, fluviatile, marine ou glaciaire. […] Les galets de quartzites ou quartz ont servi de matière première à de nombreuses industries lithiques pour le débitage ou pour la confection de galets aménagés ; ils peuvent aussi constituer des percuteurs durs utilisés pour le débitage en percussion directe, indirecte ou comme enclume. (La préhistoire)"@fr .

<https://opentheso.huma-num.fr/?idc=pcrta8Bnn8iMwS&idt=th310> a skos:Concept;
  skos:prefLabel "canto rodado retocado"@es, "chopping tool"@nl, "ciottolo scheggiato"@it,
    "einflächig retuschiertes Geröllgerät"@de, "flaked pebble"@en, "galet aménagé"@fr,
    "حصاة مشغولة"@ar;
  skos:altLabel "chopper"@it, "chopping tool"@it, "einseitig bearbeitetes Geröllgerät"@de;
  skos:broader <https://opentheso.huma-num.fr/?idc=pcrtxs8Kml8jLw&idt=th310>;
  skos:inScheme <https://opentheso.huma-num.fr/th310>;
