<https://opentheso.huma-num.fr/?idc=pcrtHvqpbVO9nH&idt=th310> a skos:Concept;
  skos:prefLabel "alabastre"@fr, "alabastro"@es, "alabastron"@en, "alabastron"@it, "alabastron"@nl,
    "Alabastron"@de, "زجاجة عِطر"@ar;
  skos:broader <https://opentheso.huma-num.fr/?idc=pcrtnJSrDq5ReO&idt=th310>;
  skos:inScheme <https://opentheso.huma-num.fr/th310>;
