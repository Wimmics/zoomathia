  skos:altLabel "pedis"@la, "peduculus"@la, "tinea"@la, "ἄχωρ"@gr, "βραύλα"@gr, "κάρ"@gr,
    "κάρνος"@gr, "κικνίον"@gr, "νίρμος"@gr, "νίρνος"@gr, "σθάραξ"@gr;
  skos:broader <https://opentheso.huma-num.fr/?idc=105780&idt=th310>, <https://opentheso.huma-num.fr/?idc=107515&idt=th310>,
