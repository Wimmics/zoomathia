<https://opentheso.huma-num.fr/?idc=pcrtTgttY2SfBr&idt=th310> a skos:Concept;
  skos:prefLabel "canto rodado"@es, "ciottolo"@it, "galet"@fr, "kei"@nl, "pebble"@en,
    "Pebble"@de, "حصاة ملساء"@ar;
  skos:altLabel "cobble"@en, "Geröll"@de, "Kiesel"@de;
  skos:broader <https://opentheso.huma-num.fr/?idc=pcrtxs8Kml8jLw&idt=th310>;
  skos:inScheme <https://opentheso.huma-num.fr/th310>;
