<https://opentheso.huma-num.fr/?idc=108545&idt=th310> a skos:Concept;
  skos:prefLabel "apus"@en, "apus"@es, "apus"@fr, "apus"@la, "ἄπους"@gr;
  skos:altLabel "cypselus"@la, "κύψελος"@gr;
  skos:broader <https://opentheso.huma-num.fr/?idc=5035&idt=th310>, <https://opentheso.huma-num.fr/?idc=5059&idt=th310>;
  skos:inScheme <https://opentheso.huma-num.fr/th310>;
  opentheso:memberOf <https://opentheso.huma-num.fr/?idg=MT_7&idt=th310>, <https://opentheso.huma-num.fr/?idg=MT_10&idt=th310>;
  dcterms:created "2016-03-02"^^xsd:date;
  dcterms:modified "2016-03-02"^^xsd:date;
  dcterms:identifier "108545";
  dcterms:description "5037##5035##108545", "4996##4998##5000##4978##5028##pcrtqbh6Y1DsXN##5057##5059##108545";
  skos:scopeNote "Footless . Plin. X 114 uses the information from Arist. H.A. 487b 24-31. André, Oiseaux, 1967, 31-32, identifies this bird as the house martin (Delichon urbicum), but he admits that the description includes elements of other species, as the crag martin (Ptyonoprogne rupestris) and the common swift (Apus apus)."@fr .

