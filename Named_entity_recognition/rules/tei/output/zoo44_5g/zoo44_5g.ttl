<http://ns.inria.fr/zoomathia/annotation/abe1e3a7da1480ede76214be43a7b8bbfa962abe>
      a       zoo:AutomaticAnnotation ;
      oa:hasBody <http://dbpedia.org/resource/Dance> ;
      oa:hasTarget
