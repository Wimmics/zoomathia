<http://ns.inria.fr/zoomathia/ARISTOTELES/de_respiratione/e/13/text/1>
      a       zoo:Paragraph ;
      zoo:hasAnnotation <http://ns.inria.fr/zoomathia/annotation/9d690db0826bbb16eb4ee43b34d87feb82737f61> , <http://ns.inria.fr/zoomathia/annotation/140cb77abf05fa2340a0c981301e37d9c3af7e21> , <http://ns.inria.fr/zoomathia/annotation/e1e29b531cf5ac957939a607995595dfb9fd2fee> , <http://ns.inria.fr/zoomathia/annotation/ef3a722ee44ad07de4be08784014be01b301d8f8> , <http://ns.inria.fr/zoomathia/annotation/5977584b14dffe860c91f6f3572f86cd90c33f1c> , <http://ns.inria.fr/zoomathia/annotation/157fc661ece21a9438ef3ea2b3f1d89879650610> , <http://ns.inria.fr/zoomathia/annotation/95d3289c1756c89f2ac13bb2bb9b43ae572bab3e> , <http://ns.inria.fr/zoomathia/annotation/238b1e411e7328a348d19cfd3c22c5b78899c04d> , <http://ns.inria.fr/zoomathia/annotation/d880749a9a8115dd7e26b531a9d079d21c199fbf> , <http://ns.inria.fr/zoomathia/annotation/f34668d5fcc4f3880afde682dd9d480b75d1afdc> , <http://ns.inria.fr/zoomathia/annotation/ca789acecc868f8893d81123caf2924496067839> , <http://ns.inria.fr/zoomathia/annotation/ab7e78b7d39030d924babbb10a5c7cf370c2016d> , <http://ns.inria.fr/zoomathia/annotation/d775f92862c66d762dc4522dd8d204d269037bf4> , <http://ns.inria.fr/zoomathia/annotation/9dcb7195e901f4095390cc5208ee462c1ad0261b> , <http://ns.inria.fr/zoomathia/annotation/c601d9605d81c0af58798ee18e2d6fd28ab23ffc> , <http://ns.inria.fr/zoomathia/annotation/2dbeaa1fd7b735d7ee77a4be30b6bab90b78d8c3> , <http://ns.inria.fr/zoomathia/annotation/6e52858450e355b09906dfd357384e4412250acb> , <http://ns.inria.fr/zoomathia/annotation/577928c538205b4ecf6df8ab72c35a66e321a58c> , <http://ns.inria.fr/zoomathia/annotation/e0377cb0d50fd0a9e531b671c201e9916beaecbb> , <http://ns.inria.fr/zoomathia/annotation/d247eac47bd378338c26b2e23f25ee48c3f24020> , <http://ns.inria.fr/zoomathia/annotation/8785afa79369aa82ac3f6cac1b6eca31a6530548> , <http://ns.inria.fr/zoomathia/annotation/491bf7286d77daeb821434fc69a196e62885365a> , <http://ns.inria.fr/zoomathia/annotation/d9c18c01c0bbcb948151e8fd82121ec0e365ac75> , <http://ns.inria.fr/z