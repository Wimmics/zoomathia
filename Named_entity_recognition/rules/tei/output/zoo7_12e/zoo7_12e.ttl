      a       zoo:Paragraph ;
      zoo:hasAnnotation <http://ns.inria.fr/zoomathia/annotation/28e6d0a4c4df9250b4145dd8e7d2822d34b23877> , <http://ns.inria.fr/zoomathia/annotation/2c5d33c28b353b3dd6c5573df5a397fef794a9b8> , <http://ns.inria.fr/zoomathia/annotation/fcbcf5e47b0289adfd36228f6f4a1e18801e6f8f> , <http://ns.inria.fr/zoomathia/annotation/ad221758336c35ded464251f7595226ee27aca6c> , <http://ns.inria.fr/zoomathia/annotation/f3675586ce9dde3929b4e8eb6c9e71250301b857> , <http://ns.inria.fr/zoomathia/annotation/c0827886893dbbdc17f63982424f3d90a32b754f> , <http://ns.inria.fr/zoomathia/annotation/c068368e136cee8862343811bff29ef57f028850> , <http://ns.inria.fr/zoomathia/annotation/c8d2007fdd0c08db5cffb8fe3c3fbd740e3c0326> , <http://ns.inria.fr/zoomathia/annotation/cc65047592fc19da9c663155bd675d5b90396d5c> , <http://ns.inria.fr/zoomathia/annotation/7fe6e2dce4a1f116d2d53100b4fef7d0fc4a4061> , <http://ns.inria.fr/zoomathia/annotation/71bdee353e700eef03db68a849f1adab222e46b6> , <http://ns.inria.fr/zoomathia/annotation/4ea1fcecf32824479d94bf1cb7d40a413c3ad7f1> , <http://ns.inria.fr/zoomathia/annotation/aeff873a50b415ca3d82cf213f8e446fb90eff97> , <http://ns.inria.fr/zoomathia/annotation/1f6c6944fb83f6ac2b06c2f0306958b5bda1fc08> , <http://ns.inria.fr/zoomathia/annotation/91a0b4756a94d3239e90ef1e2ddca62c4e073ccd> , <http://ns.inria.fr/zoomathia/annotation/3fc204172a729bf5c49d0a14028450e94963a346> , <http://ns.inria.fr/zoomathia/annotation/c8d5fcaa6c68cc62f7c0a25be7d17056dae16115> , <http://ns.inria.fr/zoomathia/annotation/21edbfbf6c967bba44fb1f6fc431004856988456> , <http://ns.inria.fr/zoomathia/annotation/bc7512ca147fe908f24a47adeae42caf91caac7b> , <http://ns.inria.fr/zoomathia/annotation/ae8b318085826c6aa9ea1e146666570782a3d1c7> , <http://ns.inria.fr/zoomathia/annotation/c1fa8f7e84bccf827108feb28355783aca108b67> , <http://ns.inria.fr/zoomathia/annotation/4dd3ad88f67c8261ef707fff2f09097f99d8c554> , <http://ns.inria.fr/zoomathia/annotation/89e47f186dffbc366633e04fb185366ac0e5ff6f> , <http://ns.inria.fr/zoomathia/annotation/ecde0128ce7ad467e6cce7795fca5a64f0f49f21> , <http://ns.inria.fr/zoomathia/annotation/e4abb7f831caa3629771279e6f9fafe2fb38fad1> , <http://ns.inria.fr/zoomathia/annotation/8c46b7b2075967ce27282c3c694606693926fca5> , <http://ns.inria.fr/zoomathia/annotation/214a0f82be07535d46d1f615447a1dfdd1d137a3> , <http://ns.inria.fr/zoomathia/annotation/81c0a3d4344c7548515bdca1a08af57ecdf6f1ad> , <http://ns.inria.fr/zoomathia/annotation/d1e2e09b83d84d330b434baeff89f59d73bb91ac> , <http://ns.inria.fr/zoomathia/annotation/1d0b682310e689a93c91e2a4f2a91bab4ed9ae4a> , <http://ns.inria.fr/zoomathia/annotation/441fa38a08d1e3e0806e94700e97ffbcda49c18b> , <http://ns.inria.fr/zoomathia/annotation/633070d421e739a00fe12afacab98c7dc4418f32> , <http://ns.inria.fr/zoomathia/annotation/7f28b9cb81906ee164ab1b06759775990d8aec5a> , <http://ns.inria.fr/zoomathia/annotation/3b8b5436f19b018f30bbca068fba4d09e97e1931> , <http://ns.inria.fr/zoomathia/annotation/c6067f8a676485383846d49248330abf70c53c96> .

