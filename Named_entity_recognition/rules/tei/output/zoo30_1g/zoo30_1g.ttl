      a       zoo:Paragraph ;
      zoo:identifier 17 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/5> ;
      zoo:text "ὁππότε θηλυτέρη γὰρ ἔχει κόπον κόπον Jacobs:τόκον MSS. Εἰλειθυίης," .

