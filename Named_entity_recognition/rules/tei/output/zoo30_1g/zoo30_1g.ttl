      a       zoo:Paragraph ;
      zoo:identifier 71 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/3> ;
      zoo:text "Μέμνονα κωκύουσι, κλυτὸν γόνον Ἠριγενείης," .

