      zoo:identifier 47 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/1> ;
      zoo:text "κοιρανικοῖς τʼ ἔμολεν διαπόμπιμος ὀφθαλμοῖσιν." .

