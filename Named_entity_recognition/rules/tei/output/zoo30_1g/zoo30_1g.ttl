      a       zoo:Paragraph ;
      zoo:identifier 43 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/14> ;
      zoo:text "ἕσπονται δʼ ἅμα πάντες, ὅτʼ ἄγρια κύματα τέμνει," .

