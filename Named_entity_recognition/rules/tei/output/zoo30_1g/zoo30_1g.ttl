      zoo:identifier 18 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/4> ;
      zoo:text "φρυκτοὺς αὐσταλέους πυριλαμπέας ἀμφὶς ἔχοντες·" .

