      a       zoo:Paragraph ;
      zoo:identifier 46 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/5> ;
      zoo:text "ἀΐσσει, παλάμῃ κραδάων πεφονωμένον ἔγχος," .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/6/text/27>
