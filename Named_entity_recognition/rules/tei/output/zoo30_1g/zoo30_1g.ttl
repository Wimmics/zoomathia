      zoo:identifier 27 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/6> ;
      zoo:text "λευγαλέην δειρήν· λευκοὺς δʼ ὑπέσηρεν ὀδόντας," .

