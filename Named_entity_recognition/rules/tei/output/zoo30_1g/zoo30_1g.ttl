      zoo:identifier 32 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/15> ;
      zoo:text "αἰχμὴν ἀστράπτουσαν ἔχων κρατερῇς παλάμῃσιν," .

