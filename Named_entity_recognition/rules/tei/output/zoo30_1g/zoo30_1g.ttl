      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/9> ;
      zoo:text "μείων εὐρυκέρωτος, ἀτὰρ δόρκου μέγʼ ἀρείων·" .

