      zoo:identifier 33 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/9> ;
      zoo:text "καὶ μελεϊστὶ τάμεν νέκυας δʼ ἔρριψεν ἔραζε," .

