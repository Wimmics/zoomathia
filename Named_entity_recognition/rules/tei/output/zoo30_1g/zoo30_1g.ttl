      zoo:identifier 62 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/5> ;
      zoo:text "πάντες ἐρεισάμενοι κρατεροῖσι δέουσʼ ὑπὸ δεσμοῖς" .

