      a       zoo:Paragraph ;
      zoo:identifier 38 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/5> ;
      zoo:text "ἆνερ, ἄνερ, τί νυ σεῖο προσώπατα τρηχύνονται," .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/3/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/3> ;
      zoo:text "οὐ γάρ τοι κρατερῇσιν ὑπὲρ κεφαλῆφι πέπηγε," .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/1/text/22>
