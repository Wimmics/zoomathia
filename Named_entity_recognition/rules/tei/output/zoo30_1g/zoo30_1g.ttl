      a       zoo:Paragraph ;
      zoo:identifier 21 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/19> ;
      zoo:text "γραπτὸν ἐπισκιάουσιν ἀριπρεπὲς αἰολόνωτον·" .

