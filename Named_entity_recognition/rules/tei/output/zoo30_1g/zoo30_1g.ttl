<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g>
      a       zoo:Oeuvre ;
      zoo:author "OPPIANUS-2" ;
      zoo:date "1928" ;
      zoo:editor "Unknown editor" ;
      zoo:file "../zoo/zoo30/1g.xml" ;
      zoo:identifier "cynegetica" ;
      zoo:title "Cynegetica" .


<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/13/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/13> ;
      zoo:text "ὅττι πάροιθεν ἔασιν ὀλιζότεροι πόδες αὐτοῖς." .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/1/text/50>
      a       zoo:Paragraph ;
      zoo:identifier 50 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/1> ;
      zoo:text "εἵματα πορφύρεα· ταὶ δὲ κλιδὸν ὄσσε βαλοῦσαι θυμὸν ἰαινόμεναι τίκτουσʼ ἁλιπόρφυρα τέκνα. ναὶ μὴν ὧδε Λάκωνες ἐπίφρονα μητίσαντο αἷσι φίλαις ἀλόχοις, ὅτε γαστέρα κυμαίνουσι· γράψαντες πινάκεσσι πέλας θέσαν ἀγλαὰ κάλλη, τοὺς πάρος ἀστράψαντας ἐν ἡμερίοισιν ἐφήβους, Νιρέα καί Νάρκισσον ἐϋμμελίην θʼ Ὑάκινθον," .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/6/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/6> ;
      zoo:text "κυανέῃς ἑκάτερθεν ἐπήτριμα ταινίῃσι·" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/1/text/15>
      a       zoo:Paragraph ;
      zoo:identifier 15 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/1> ;
      zoo:text "οἱ δʼ ἄρʼ, ἐπεὶ βουλῇσι θεοῦ μεροπηΐδα μορφὴν" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/2/text/20>
      a       zoo:Paragraph ;
      zoo:identifier 20 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/2> ;
      zoo:text "τί χρέος ἐκ μερόπων δὲ κλυτὰς ἤμειψε γυναῖκας" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/3/text/28>
      a       zoo:Paragraph ;
      zoo:identifier 28 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/3> ;
      zoo:text "καρτερόν ἀθλεύοντʼ ἀγέμεν πάρος ἐξ Ἐρυθείης," .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/1/text/16>
      a       zoo:Paragraph ;
      zoo:identifier 16 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/1> ;
      zoo:text "ἀμφεβάλοντο Κρόνοιο καὶ ἀμφιέσαντο λέοντας," .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/19/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/19> ;
      zoo:text "αὐτὰρ ἐπὴν ἔαρος πρῶται γελάσωσιν ὀπωπαί," .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/10/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/10> ;
      zoo:text "ὄφρα μιν, ὦ Διόνυσε, διὰ στόμα δαιτρεύσωμεν." .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/14/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/14> ;
      zoo:text "ἀλλὰ καὶ ὀθνείοις ἐπεμήνατο ὑψόθι φίλτροις." .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/17/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/17> ;
      zoo:text "καὶ νώτῳ ῥαθάμιγγες ἐπήτριμα πορφύρουσι." .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/5/text/56>
      a       zoo:Paragraph ;
      zoo:identifier 56 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/5> ;
      zoo:text "ἄντην ἀσσυτέρῃσιν ὐπʼ ὠτειλῇσι δαμασθείς," .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/9/text/49>
      a       zoo:Paragraph ;
      zoo:identifier 49 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/9> ;
      zoo:text "ἄλλοι Καδμεῖοί τε· θεοῦ δʼ οὐχ ἅπτετο δεσμά·" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/13/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/13> ;
      zoo:text "τοὔνεκα ῥηΐδιοι πτώκεσσι πέλουσι κολῶναι," .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/5/text/54>
      a       zoo:Paragraph ;
      zoo:identifier 54 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/5> ;
      zoo:text "ὡς δὲ βροτὸς πολλοῖσιν ἐρεψάμενος κοτίνοισι" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/1/text/51>
      a       zoo:Paragraph ;
      zoo:identifier 51 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/1> ;
      zoo:text "Κάστορά τʼ εὐκόρυθον καὶ Ἀμυκοφόνον Πολυδεύκην, ἠϊθέους τε νέους, τοί τʼ ἐν μακάρεσσιν ἀγητοί, Φοῖβον δαφνοκόμην καὶ κισσοφόρον Διόνυσον· αἱ δʼ ἐπιτέρπονται πολυήρατον εἶδος ἰδοῦσαι, τίκτουσίν τε καλοὺς ἐπὶ κάλλεϊ πεπτηυῖαι. τόσσα μὲν ἀμφʼ ἵπποισιν· ἀτὰρ κατάβηθι, φίλη φρήν, οἶμον ἐπὶ σκυλάκων· τόσσοι δʼ ἐπὶ πᾶσι κύνεσσιν" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/7/text/20>
      a       zoo:Paragraph ;
      zoo:identifier 20 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/7> ;
      zoo:text "λάθρη τʼ ἐμπελάει μάλα τʼ ἤρεμος, εἰσόκεν ἄγρῃ" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/14/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/14> ;
      zoo:text "ἀτταγέων· ὅσσος δὲ τανυκραίροις ἐπὶ δόρκοις" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/6/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/6> ;
      zoo:text "λαχνήεσσα κυρεῖ, κατὰ δʼ ἔγραπται δέμας αἰνὸν" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/2/text/21>
      a       zoo:Paragraph ;
      zoo:identifier 21 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/2> ;
      zoo:text "ἐς τόδε πορδαλίων γένος ἄγριον, αὖθις ἀείσω." .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/19/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/19> ;
      zoo:text "ἄνθεά τʼ ἐν λειμῶσι νέον γε μὲν ἡβήσειαν," .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/3/text/27>
      a       zoo:Paragraph ;
      zoo:identifier 27 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/3> ;
      zoo:text "κεῖνοι, τοὺς φάτις ἔσκε Διὸς γόνον Ἡρακλῆα" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/1/text/17>
      a       zoo:Paragraph ;
      zoo:identifier 17 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/1> ;
      zoo:text "δώροισιν μετόπισθε Διὸς μέγα κοιρανέουσι" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/14/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/14> ;
      zoo:text "οἷος μὲν πόθος ἐστὶν ἀριζήλοις ἐλάφοισι" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/10/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/10> ;
      zoo:text "ὠμοβόρους, ὀλοοῖσι κορυσσομένας ὀνύχεσσιν," .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/7/text/21>
      a       zoo:Paragraph ;
      zoo:identifier 21 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/7> ;
      zoo:text "ἐγχρίμψῃ· τὴν δʼ αἶψα θοοῖς ὀνύχεσσιν ἔμαρψεν." .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/5/text/55>
      a       zoo:Paragraph ;
      zoo:identifier 55 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/5> ;
      zoo:text "πυγμαχίης ἐν ἀγῶσιν, ὑπʼ ἀνέρος ἀλκήεντος" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/17/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/17> ;
      zoo:text "ἠρέμα δὲ ξανθοῖς ἐπὶ καλλικόμοισι μετώποις" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/6/text/16>
      a       zoo:Paragraph ;
      zoo:identifier 16 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/6> ;
      zoo:text "ῥινὸν δʼ ἀμφοτέροισιν ἐπικλείουσιν ἀοιδοὶ" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/2/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/2> ;
      zoo:text "ἀλλʼ ἄγε δὴ ταύρων ζηλήμονα πάγχυ γενέθλην" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/1/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/1> ;
      zoo:text "πρώτους ἀμφήλλαξε Διὸς ῥυτῆρας ἀγαυοὺς" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/13/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/13> ;
      zoo:text "αὐτίκα γὰρ σκύλακάς τε καὶ ἀνέρας ἀθρήσαντες" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/4/text/81>
      a       zoo:Paragraph ;
      zoo:identifier 81 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/4> ;
      zoo:text "τοῖά νύ που βένθεσσιν ἐν εὐρυπόροιο θαλάσσης" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/9/text/47>
      a       zoo:Paragraph ;
      zoo:identifier 47 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/9> ;
      zoo:text "οἱ μέν νυν Βρόμιον Πενθηϊάδαι φυλακῆες" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/7/text/22>
      a       zoo:Paragraph ;
      zoo:identifier 22 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/7> ;
      zoo:text "ἔστι δέ τις Ταύροιο νιφοβλήτους ὑπὲρ ἄκρας" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/10/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/10> ;
      zoo:text "ταῦρον μὲν Πενθῆα δυσώνυμον, ἄμμε δὲ θῆρας" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/17/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/17> ;
      zoo:text "πολλάκις ἐν κονίῃσι νέκυν τοιοῦτον ἔθηκεν." .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/5/text/58>
      a       zoo:Paragraph ;
      zoo:identifier 58 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/5> ;
      zoo:text "οἷα μεθυσφαλέων, ἑτεροκλινέων τε κάρηνον·" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/6/text/15>
      a       zoo:Paragraph ;
      zoo:identifier 15 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/6> ;
      zoo:text "στεινὴ τʼ ἐκτάδιός τε πέλει καὶ νῶτα καὶ οὐρήν·" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/13/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/13> ;
      zoo:text "πρὸς λόφον ἰθύνουσιν· ἐπεὶ μάλα γιγνώσκουσιν," .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/2/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/2> ;
      zoo:text "πρῶτον ἀείδωμεν καὶ μυρίον ἔξοχα νεῖκος" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/1/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/1> ;
      zoo:text "καὶ θῆρας ποίησεν ἀμειψάμενος Κουρῆτας." .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/4/text/80>
      a       zoo:Paragraph ;
      zoo:identifier 80 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/4> ;
      zoo:text "οἷά τʼ ἀμελγομένη, καὶ γαστρὸς ἔκλεψεν ἐρωήν." .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/3/text/29>
      a       zoo:Paragraph ;
      zoo:identifier 29 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/3> ;
      zoo:text "ὁππότʼ ἐπʼ Ὠκεανῷ δηρίσατο Γηρυονῆϊ" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/9/text/80>
      a       zoo:Paragraph ;
      zoo:identifier 80 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/9> ;
      zoo:text "μαρναμένη γενύεσσιν ἐτώσια λευγαλέῃσιν." .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/19/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/19> ;
      zoo:text "ᾗς νέκυες κεῖνται, δυσχείμερον οἶτον ἑλόντες." .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/14/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/14> ;
      zoo:text "ὀφθαλμοὺς ἐπέτασσεν ἔρον θʼ ὑπεδέξατο θυμῷ·" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/7/text/23>
      a       zoo:Paragraph ;
      zoo:identifier 23 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/7> ;
      zoo:text "ἐνδιάων Κίλικάς τε πάγους καὶ πρῶνας Ἀμανοῦ," .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/17/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/17> ;
      zoo:text "κεῖνος καὶ σθεναρῷ περ ἐφορμηθεὶς ἐλέφαντι" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/10/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/10> ;
      zoo:text "θὲς δὲ παρὰ σκοπιῇσι, πυρίσπορε, Πενθέα ταῦρον," .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/5/text/57>
      a       zoo:Paragraph ;
      zoo:identifier 57 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/5> ;
      zoo:text "ἔστη μὲν πρώτιστα λελουμένος αἵματι λάβρῳ," .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/9/text/48>
      a       zoo:Paragraph ;
      zoo:identifier 48 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/9> ;
      zoo:text "δεσμοῖσιν δοκέοντο σιδηρείοισιν ἄγεσθαι" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/5/text/51>
      a       zoo:Paragraph ;
      zoo:identifier 51 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/5> ;
      zoo:text "ὀψὲ βροτοῖσιν ἔδωκε βραβήϊα πάντα μόθοιο·" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/6/text/18>
      a       zoo:Paragraph ;
      zoo:identifier 18 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/6> ;
      zoo:text "εἰ φορέοις, φορέοις σκυλάκων μέγα δεῖμα κραταιῶν," .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/15/text/21>
      a       zoo:Paragraph ;
      zoo:identifier 21 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/15> ;
      zoo:text "ἢ σῦν χαυλιόδοντʼ ἢ καρχαρόδοντα λέοντα" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/8/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/8> ;
      zoo:text "τοίην μὲν πυρόεσσαν ὑπὸ βλεφάροισιν ὀπωπαὶ" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/2/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/2> ;
      zoo:text "οἷον ὑπὲρ θαλάμοιο πανάγρια δηρίσαντο." .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/1/text/59>
      a       zoo:Paragraph ;
      zoo:identifier 59 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/1> ;
      zoo:text "ὠδίνει σκύμνους, κατά θʼ ἑξείης ὑπένερθε" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/3/text/23>
      a       zoo:Paragraph ;
      zoo:identifier 23 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/3> ;
      zoo:text "ἀλλʼ οὐ πιαλέοι δέμας ἀμφιλαφὲς βαρύθουσιν," .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/1/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/1> ;
      zoo:text "κλεψιτόκος Ῥείη κόλποις ἐνικάτθετο Κρήτης." .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/19/text/15>
      a       zoo:Paragraph ;
      zoo:identifier 15 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/19> ;
      zoo:text "καὶ γλυκερῆς νεοτερπὲς ἐδητύος ἐμνήσαντο," .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/9/text/45>
      a       zoo:Paragraph ;
      zoo:identifier 45 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/9> ;
      zoo:text "σύρειν δʼ αἰνομόροισιν ἐβώστρεεν οἷς ἑτάροισι," .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/9/text/81>
      a       zoo:Paragraph ;
      zoo:identifier 81 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/9> ;
      zoo:text "ἀλλʼ οὐκ ἰχνεύμων τότʼ ἀρήϊος ἐν ψαμάθοισι" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/17/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/17> ;
      zoo:text "οὐτήσας βριαρήν τε διατμήξειε χαράδρην." .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/5/text/41>
      a       zoo:Paragraph ;
      zoo:identifier 41 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/5> ;
      zoo:text "γυμνά, τά τοι προπάροιθε μετήορον ἀείροντο." .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/6/text/17>
      a       zoo:Paragraph ;
      zoo:identifier 17 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/6> ;
      zoo:text "ῥιγεδανόν· τῆς τοῦ Brodaeus. μέν τε διατμήξας περὶ ποσσὶν" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/15/text/20>
      a       zoo:Paragraph ;
      zoo:identifier 20 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/15> ;
      zoo:text "ὁππότε δʼ ἀθρήσειεν ὄρυξ κρατερόφρονα θῆρα," .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/5/text/50>
      a       zoo:Paragraph ;
      zoo:identifier 50 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/5> ;
      zoo:text "ὣς ὅ γʼ ἀνηνύστοισιν ἀπειπάμενος καμάτοισιν" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/1/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/1> ;
      zoo:text "Οὐρανίδης δʼ ἐσιδὼν κρατερὸν νεοθηλέα παῖδα" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/2/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/2> ;
      zoo:text "εἷς βασιλεὺς ἀγέληφι τυραννεύων ὄχʼ ἄριστος" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/3/text/22>
      a       zoo:Paragraph ;
      zoo:identifier 22 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/3> ;
      zoo:text "μυκηταί, βλοσυροί, ζηλήμονες, εὐρυγένειοι·" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/9/text/46>
      a       zoo:Paragraph ;
      zoo:identifier 46 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/9> ;
      zoo:text "σύρειν τε κλείειν τε, χορόν τʼ ἐλάασκε γυναικῶν." .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/5/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/5> ;
      zoo:text "φῦλα δʼ ἀελλοπόδων ζηλήμονα πάμπαν ὀνάγρων" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/9/text/82>
      a       zoo:Paragraph ;
      zoo:identifier 82 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/9> ;
      zoo:text "δηθύνει, πικρῶν δὲ θορὼν ἐδράξατο λαιμῶν," .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/5/text/40>
      a       zoo:Paragraph ;
      zoo:identifier 40 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/5> ;
      zoo:text "αἰδόμενοι θήρεσσι καρήατα τοῖα φανῆναι," .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/17/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/17> ;
      zoo:text "κείνῳ μὲν χαλκόν τε διατρήσειεν ὀρούσας," .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/19/text/16>
      a       zoo:Paragraph ;
      zoo:identifier 16 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/19> ;
      zoo:text "αὖθις δὲ ζωοί τε πάλιν τʼ πάλιν t' Turnebus: πάλιν MSS. ἐγένοντο μυωξοί." .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/13/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/13> ;
      zoo:text "ῥηΐδιοι πτώκεσσι, δυσάντεες ἱππελάτῃσι." .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/5/text/53>
      a       zoo:Paragraph ;
      zoo:identifier 53 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/5> ;
      zoo:text "εἴκελος αἰδομένῳ δἐ ποτὶ χθόνα κανθὸν ἐρείδει." .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/2/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/2> ;
      zoo:text "βαιοτέροις ταύροις καὶ θηλυτέρῃσιν ἀνάσσει·" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/1/text/57>
      a       zoo:Paragraph ;
      zoo:identifier 57 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/1> ;
      zoo:text "βάξις δʼ ἀτρεκέως ἀνεμώλιος, ὡς ἕνα τίκτει." .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/3/text/25>
      a       zoo:Paragraph ;
      zoo:identifier 25 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/3> ;
      zoo:text "ὧδε θεῶν κλυτὰ δῶρα κερασσάμενοι φορέουσιν," .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/11/text/30>
      a       zoo:Paragraph ;
      zoo:identifier 30 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/11> ;
      zoo:text "ἀλλήλους ἑκάτερθεν ἀμοιβαδίοισι κυπέλλοις," .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/3/text/26>
      a       zoo:Paragraph ;
      zoo:identifier 26 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/3> ;
      zoo:text "ἀμφότερον κραιπνοί τε θέειν σθεναροί τε μάχεσθαι·" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/19/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/19> ;
      zoo:text "νωθρὸν κινήσαντο δέμας μυχάτης ἀπὸ λόχμης," .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/9/text/43>
      a       zoo:Paragraph ;
      zoo:identifier 43 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/9> ;
      zoo:text "οὐ Τυρίου Κάδμοιο καταιδόμενος τρίχα λευκήν," .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/9/text/83>
      a       zoo:Paragraph ;
      zoo:identifier 83 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/9> ;
      zoo:text "δαρδάπτει τε γένυσσιν ἑλισσομένην ἑκάτερθε," .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/10/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/10> ;
      zoo:text "Πενθέα μὲν δὴ ταῦρον ἐδείξατο φοίνιον ὄμμα," .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/15/text/24>
      a       zoo:Paragraph ;
      zoo:identifier 24 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/15> ;
      zoo:text "τεινάμενος, πήξας τε παρὰ χθονὶ πικρὰ βέλεμνα" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/17/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/17> ;
      zoo:text "ἀντέλλει κέρας αἰνόν, ἀκαχμένον, ἄγριον ἆορ·" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/5/text/52>
      a       zoo:Paragraph ;
      zoo:identifier 52 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/5> ;
      zoo:text "ἀφρὸν ἀποσταλάει δὲ ποτὶ σχερὸν αἱματόεντα·" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/2/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/2> ;
      zoo:text "γλαυκιόωσιν ὁμοῦ τε καὶ ἔνδοθι φοινίσσονται," .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/15/text/22>
      a       zoo:Paragraph ;
      zoo:identifier 22 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/15> ;
      zoo:text "ἢ κρυερῶν ἄρκτων ὀλοὸν θράσος, αὐτίκʼ ἄρʼ αἴῃ" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/13/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/13> ;
      zoo:text "ναὶ μὴν ἀτραπιτοῖο πολυστιβίην ἀλεείνειν" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/17/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/17> ;
      zoo:text "οὐ πολλὸν μείζων, ὀλίγον δʼ ὑπὲρ ἄκρια ῥινὸς" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/2/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/2> ;
      zoo:text "πέφρικεν δʼ ἀγέλη κεραὸν μέγαν ἡγεμονῆα·" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/9/text/85>
      a       zoo:Paragraph ;
      zoo:identifier 85 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/9> ;
      zoo:text "πευκεδανὸν θανάτοιο φίλον, ζαμενῆ χόλον, ἰόν." .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/1/text/58>
      a       zoo:Paragraph ;
      zoo:identifier 58 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/1> ;
      zoo:text "πέντε φέρει πρώτιστον· ἀτὰρ πίσυρας μετέπειτα" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/11/text/31>
      a       zoo:Paragraph ;
      zoo:identifier 31 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/11> ;
      zoo:text "ὀψὲ δʼ ἐλώφησαν· τοὺς δʼ ἔρριφεν ἄλλον ἐπʼ ἄλλῳ" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/3/text/24>
      a       zoo:Paragraph ;
      zoo:identifier 24 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/3> ;
      zoo:text "οὐδὲ πάλιν λιπόσαρκοι ἑὸν δέμας ἀδρανέουσιν·" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/6/text/19>
      a       zoo:Paragraph ;
      zoo:identifier 19 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/6> ;
      zoo:text "καί σε κύνες κείνοισιν ἐπεμβεβαῶτα πεδίλοις" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/1/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/1> ;
      zoo:text "ἀραμένη γενετῆρος ἀμειλίκτοιο Κρόνοιο" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/19/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/19> ;
      zoo:text "φάεά τʼ ἀμπετάσαντο καὶ ἔδρακον ἠελίου φῶς," .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/9/text/44>
      a       zoo:Paragraph ;
      zoo:identifier 44 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/9> ;
      zoo:text "οὐδὲ κυλινδομένην οἷσι πρὸ πόδεσσιν Ἀγαύην·" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/9/text/84>
      a       zoo:Paragraph ;
      zoo:identifier 84 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/9> ;
      zoo:text "καὶ νέκυν αὐτίκʼ ἔθηκʼ ἀποφώλιον ἐκπτύουσαν" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/10/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/10> ;
      zoo:text "ὣς φάσαν εὐχόμεναι· τάχα δʼ ἔκλυε Νύσιος ἀρῆς." .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/15/text/23>
      a       zoo:Paragraph ;
      zoo:identifier 23 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/15> ;
      zoo:text "νευστάζων κεφαλήν τε μέτωπά τε πάμπαν ἐρείδει" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/11/text/32>
      a       zoo:Paragraph ;
      zoo:identifier 32 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/11> ;
      zoo:text "καὶ φρεσὶ καὶ βλεφάροισιν ἐπιβρῖσαν μένος οἴνου·" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/14/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/14> ;
