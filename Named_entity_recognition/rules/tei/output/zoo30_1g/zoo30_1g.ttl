      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/6> ;
      zoo:text "καὶ πόντον περόωσιν, πατέουσι..περόωσιν IK: other MSS. περόωσι..πατέουσι. ὁμόστολον ἀλλήλοισι" .

