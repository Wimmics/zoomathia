      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/21> ;
      zoo:text "αὐταῖς δʼ ἀγκαλίδεσσιν ἑῶν τέθνηκε τέθνηκε Pauw: ἔθανε I: ἔκτεινε. τοκήων." .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/5/text/20>
      a       zoo:Paragraph ;
      zoo:identifier 20 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/5> ;
      zoo:text "μυκᾶται βρύχημα πελώριον, ὁππότε κρημνῶν" .

