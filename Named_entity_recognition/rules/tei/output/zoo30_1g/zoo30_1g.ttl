      zoo:identifier 30 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/15> ;
      zoo:text "ὡς δʼ ὅτʼ ἐνὶ ξυλόχοισιν ἐπεσσυμένοιο λέοντος," .

