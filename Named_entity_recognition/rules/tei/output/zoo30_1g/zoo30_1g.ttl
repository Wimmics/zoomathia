      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/4> ;
      zoo:text "μύρονται λιγέως ἀδινὸν γόον, ἐκ δʼ ἄρα τηλοῦ" .

