      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/4> ;
      zoo:text "εὔγληνοι λύγγες τε πυρίγληνοί περίγληνοι L. τε λέοντες" .

