      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/11> ;
      zoo:text "πολλὸν ὀλιζότεροι, κατά τʼ ὀκλάζουσιν ὁμοῖοι." .

