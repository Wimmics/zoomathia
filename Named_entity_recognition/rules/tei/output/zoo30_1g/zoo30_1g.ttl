      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/22> ;
      zoo:text "καὶ γλυκερὴν μελέοισι δόσαν στομάτεσσιν ἐδητύν." .

