      zoo:identifier 42 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/11> ;
      zoo:text "πρός σε Διὸς λιτόμεσθα, πρὸς αὐτῆς Ἰοχεαίρης," .

