      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/11> ;
      zoo:text "πιόμενον· τοὶ δʼ αἶψα κατὰ κνέφας ὁρμηθέντες" .

