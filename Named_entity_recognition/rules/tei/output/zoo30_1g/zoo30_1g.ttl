      zoo:identifier 68 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/6> ;
      zoo:text "αὐτὰρ ὁ γινώσκων θεόθεν τόπερ ἔλλαχε δῶρον," .

