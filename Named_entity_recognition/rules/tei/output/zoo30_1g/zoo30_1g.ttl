      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/12> ;
      zoo:text "ἀλλʼ ὁπότʼ ἀθρήσωσι κύνες σημήϊα ταρσῶν," .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/9/text/76>
