      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/11> ;
      zoo:text "Ζεῦ πάτερ, ὅσσα νόησας, ὅσʼ εἴδεα νῶϊ φύτευσας," .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/3/text/58>
