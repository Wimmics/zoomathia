      zoo:identifier 46 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/14> ;
      zoo:text "αὐτὰρ ὅ γʼ οὐκ ἀλέγων ξείνης φιλίης πανάθεσμος," .

