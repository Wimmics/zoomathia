      zoo:identifier 55 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/9> ;
      zoo:text "αἶψα δʼ ἄρʼ ἐν ψαμάθοισι καὶ ἐν πηλοῖσιν ἐλυσθεὶς" .

