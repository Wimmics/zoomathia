      zoo:identifier 34 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/2> ;
      zoo:text "οἶά τις ἀθλεύων· βριαρὸν δʼ ὅτε κάρτος ἴδηται" .

