      zoo:identifier 47 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/14> ;
      zoo:text "εἰναλίους ἑτάρους δάπτει στομάτεσσι δαφοινοῖς" .

