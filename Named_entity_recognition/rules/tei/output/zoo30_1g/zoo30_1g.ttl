      zoo:identifier 18 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/5> ;
      zoo:text "ἄγχι μάλʼ ἑζόμενος σφέτερον γόνον ἄντα δοκεύει·" .

