      a       zoo:Paragraph ;
      zoo:identifier 18 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/1> ;
      zoo:text "ὅσσα τʼ ἀπʼ ἀνθρώπων ἐδάην, τοῖσιν τὰ μέμηλεν," .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/10/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/10> ;
      zoo:text "τηλόθʼ ἀπʼ ἀλλήλων, μή μιν θηρήτορες ἄνδρες" .

