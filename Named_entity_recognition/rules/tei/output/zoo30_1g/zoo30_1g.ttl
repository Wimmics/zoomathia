      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/4> ;
      zoo:text "ἔξοχα δʼ αὖ τάδε φῦλα φίλην ἀγάσαντο γενέθλην" .

