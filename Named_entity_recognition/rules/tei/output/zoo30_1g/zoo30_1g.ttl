      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/21> ;
      zoo:text "τίς γὰρ ἂν οὐ στυγέοι τοῖον γένος, αἰσχρὸν ἰδέσθαι," .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/3/text/35>
      a       zoo:Paragraph ;
      zoo:identifier 35 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/3> ;
      zoo:text "ἵετʼ ἐπειγόμενος, χαροποῦ δʼ ἐπελήθετο πόντου," .

