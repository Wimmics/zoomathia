      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/7> ;
      zoo:text "ἄλλος δʼ αὖ μέγεθος μὲν ὑπέρτερος, ἅψεα δʼ αὖτε" .

