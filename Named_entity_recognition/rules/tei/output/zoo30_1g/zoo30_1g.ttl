      zoo:identifier 63 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/5> ;
      zoo:text "οὐδὲν ἀλευόμενον, μάλα δʼ ἤρεμον ἀτρεμέοντα." .

