      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/22> ;
      zoo:text "Ἀργώης ἐπὶ νηὸς Ἰήσονι συμπονέοντες" .

