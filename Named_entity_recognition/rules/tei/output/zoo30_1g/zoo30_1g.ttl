      zoo:identifier 53 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/4> ;
      zoo:text "αὐταὶ θηλύτεραι μάλʼ ἐπʼ ἄρσεσιν ὁρμαίνουσι," .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/12/text/71>
