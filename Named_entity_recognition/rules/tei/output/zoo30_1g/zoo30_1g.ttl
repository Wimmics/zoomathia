      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/3/10> ;
      zoo:text "γυμναὶ δʼ ἡμερίδες περὶ βότρυσιν ἰνδάλλονται," .

