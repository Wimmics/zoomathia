      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/4/9> ;
      zoo:text "αὐτὰρ ὅ γʼ αἰδεσθεὶς ἱεράς ὑπέδεκτο γυναῖκας." .

