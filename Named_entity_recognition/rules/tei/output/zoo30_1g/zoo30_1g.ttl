      a       zoo:Paragraph ;
      zoo:identifier 33 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/g/2/15> ;
      zoo:text "εὖ διαβὰς μίμνῃ, τὸν δʼ ἄγρια θυμαίνοντα" .

