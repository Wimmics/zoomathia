<http://ns.inria.fr/zoomathia/annotation/7004e7439671f4b56b46e05de0f569a2c2ac003b>
      a       zoo:AutomaticAnnotation ;
      oa:hasBody <http://dbpedia.org/resource/Line-crossing_ceremony> ;
      oa:hasTarget
              [ oa:hasSelector
