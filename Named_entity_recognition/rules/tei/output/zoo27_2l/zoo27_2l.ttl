<http://ns.inria.fr/zoomathia/NEMESIANUS,_MARCUS_AURELIUS_OLYMPUS/de_aucupio/l>
      a       zoo:Oeuvre ;
      zoo:author "NEMESIANUS, MARCUS AURELIUS OLYMPUS" ;
      zoo:date "2026-07-16" ;
      zoo:editor "Unknown editor" ;
      zoo:file "./zoo/zoo27/2l.xml" ;
      zoo:identifier "de_aucupio" ;
      zoo:title "De Aucupio" .


<http://ns.inria.fr/zoomathia/NEMESIANUS,_MARCUS_AURELIUS_OLYMPUS/de_aucupio/l/1/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/NEMESIANUS,_MARCUS_AURELIUS_OLYMPUS/de_aucupio/l/1> ;
      zoo:text "Tarpeiae est custos arcis non corpore maior nec qui te volucres docuit, Palamede, figuras." .

<http://ns.inria.fr/zoomathia/NEMESIANUS,_MARCUS_AURELIUS_OLYMPUS/de_aucupio/l/1/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/NEMESIANUS,_MARCUS_AURELIUS_OLYMPUS/de_aucupio/l/1> ;
      zoo:text "saepe ego nutantem sub iniquo pondere vidi mazonomi puerum, portat cum prandia, circo quae consul praetorve novus construxit ovanti." .

<http://ns.inria.fr/zoomathia/NEMESIANUS,_MARCUS_AURELIUS_OLYMPUS/de_aucupio/l/1/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/NEMESIANUS,_MARCUS_AURELIUS_OLYMPUS/de_aucupio/l/1> ;
      zoo:text "nam celer oppressi fallacia vincula colli excutit et rauca subsannat voce magistri consilium et laeta fruitur iam pace solutus." .

<http://ns.inria.fr/zoomathia/NEMESIANUS,_MARCUS_AURELIUS_OLYMPUS/de_aucupio/l/1/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/NEMESIANUS,_MARCUS_AURELIUS_OLYMPUS/de_aucupio/l/1> ;
      zoo:text "hic prope Peltinum ad radices Apennini nidificat, patulis qua se sol obicit agris, persimilis cineri collum, maculosasque terga inficiunt pullae cacabantis imagine guttae." .

<http://ns.inria.fr/zoomathia/NEMESIANUS,_MARCUS_AURELIUS_OLYMPUS/de_aucupio/l/1/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/NEMESIANUS,_MARCUS_AURELIUS_OLYMPUS/de_aucupio/l/1> ;
      zoo:text "illa sub aggeribus primis, qua proluit umor, pascitur, exiguos sectans obsonia vermes." .

<http://ns.inria.fr/zoomathia/NEMESIANUS,_MARCUS_AURELIUS_OLYMPUS/de_aucupio/l/1/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/NEMESIANUS,_MARCUS_AURELIUS_OLYMPUS/de_aucupio/l/1> ;
      zoo:text "at non illa oculis, quibus est obtusior, etsi sint nimium grandes, sed acutis naribus instat: impresso in terram rostri mucrone sequaces vermiculos trahit et vili dat praemia gulae." .

<http://ns.inria.fr/zoomathia/NEMESIANUS,_MARCUS_AURELIUS_OLYMPUS/de_aucupio/l/1/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/NEMESIANUS,_MARCUS_AURELIUS_OLYMPUS/de_aucupio/l/1> ;
      zoo:text "cum nemus omne suo viridi spoliatur honore, fultus equi niveis silvas pete protinus altas exuviis: praeda est facilis et amoena scolopax." .

<http://ns.inria.fr/zoomathia/NEMESIANUS,_MARCUS_AURELIUS_OLYMPUS/de_aucupio/l/1/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/NEMESIANUS,_MARCUS_AURELIUS_OLYMPUS/de_aucupio/l/1> ;
      zoo:text "corpore non Paphis avibus maiore videbis." .

<http://ns.inria.fr/zoomathia/NEMESIANUS,_MARCUS_AURELIUS_OLYMPUS/de_aucupio/l/1/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/NEMESIANUS,_MARCUS_AURELIUS_OLYMPUS/de_aucupio/l/1> ;
      zoo:text "et tetracem, Romae quem nunc vocitare taracem coeperunt. avium est multo stultissima; namque cum pedicas necti sibi contemplaverit adstans, immemor ipse sui tamen in dispendia currit." .

<http://ns.inria.fr/zoomathia/NEMESIANUS,_MARCUS_AURELIUS_OLYMPUS/de_aucupio/l/1/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/NEMESIANUS,_MARCUS_AURELIUS_OLYMPUS/de_aucupio/l/1> ;
      zoo:text "tu vero adductos laquei cum senseris orbes appropera et praedam pennis crepitantibus aufer." .


