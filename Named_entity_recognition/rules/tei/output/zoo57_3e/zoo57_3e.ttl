<http://ns.inria.fr/zoomathia/XENOPHON/on_the_art_of_horsemanship/e/1/7/text/1>
      a       zoo:Paragraph ;
      zoo:hasAnnotation <http://ns.inria.fr/zoomathia/annotation/91d46764880367073695134bef7e5a19c941b55f> , <http://ns.inria.fr/zoomathia/annotation/df87c1c67e19ca8c9850ce8bb6d576e1df69f289> , <http://ns.inria.fr/zoomathia/annotation/c135c62bcf5d65526cfbaa973516c4ef0ed50cea> , <http://ns.inria.fr/zoomathia/annotation/5847a8b49248e3e13b44fbd64a9ad6002c05e763> , <http://ns.inria.fr/zoomathia/annotation/3e026784d9006bc3e8b8414fbb8e791800b6b843> , <http://ns.inria.fr/zoomathia/annotation/d04311295c64f983621f08c7ade802f7d2c075cf> , <http://ns.inria.fr/zoomathia/annotation/f76fd14ae4d498a189ef3b53e9dd4c634ccfc53d> .

<http://ns.inria.fr/zoomathia/annotation/6ff0ee2f682caf54f65f318b391a388a5f97464a>
      a       zoo:AutomaticAnnotation ;
      oa:hasBody <http://dbpedia.org/resource/Lead> ;
      oa:hasTarget
              [ oa:hasSelector
                        [ a       oa:TextPositionSelector , oa:TextQuoteSelector ;
