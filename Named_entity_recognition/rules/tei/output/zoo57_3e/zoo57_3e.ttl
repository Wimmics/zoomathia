                        ] ;
                oa:hasSource <http://ns.inria.fr/zoomathia/XENOPHON/on_the_art_of_horsemanship/e/4/4/text/1>
              ] .

<http://ns.inria.fr/zoomathia/annotation/58e945551e92566e18f4a9c93303a200d2a49064>
      a       zoo:AutomaticAnnotation ;
      oa:hasBody <http://dbpedia.org/resource/Seat> ;
      oa:hasTarget
              [ oa:hasSelector
                        [ a       oa:TextPositionSelector , oa:TextQuoteSelector ;
                          oa:exact "seat"
                        ] ;
                oa:hasSource <http://ns.inria.fr/zoomathia/XENOPHON/on_the_art_of_horsemanship/e/1/12/text/1>
              ] .

