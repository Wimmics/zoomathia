<http://ns.inria.fr/zoomathia/XENOPHON/on_the_art_of_horsemanship/e/1/15/text/1>
      a       zoo:Paragraph ;
      zoo:hasAnnotation <http://ns.inria.fr/zoomathia/annotation/00d2158e96e303dc759f3ce36da85ed49020ff79> , <http://ns.inria.fr/zoomathia/annotation/dc7535750327d4c6e6d2acb6058630377039af04> , <http://ns.inria.fr/zoomathia/annotation/969ce04097e2f166130f3d7f9b4a5e39e82a70f8> , <http://ns.inria.fr/zoomathia/annotation/39903eddd5ab233a7b54c7c0a5ba9ab385776afc> , <http://ns.inria.fr/zoomathia/annotation/c0520e9eb100fcb3abb9b7c6effb3c31103d6b58> , <http://ns.inria.fr/zoomathia/annotation/ec0089eb7e54d996e276f16d018d3ab07236e2c1> , <http://ns.inria.fr/zoomathia/annotation/b0c3de17cba9b1dfce5d10f89c71d50c952c2324> , <http://ns.inria.fr/zoomathia/annotation/dff613f747d0de8cc1e6c062c48319eb5b17f1ab> , <http://ns.inria.fr/zoomathia/annotation/c48936de55851e6ed48981f8c789a895164d6d5c> , <http://ns.inria.fr/zoomathia/annotation/1aab608b7f6c680791962197b14239198f8b3a3e> , <http://ns.inria.fr/zoomathia/annotation/63fe8b78660d162d8b85fa7b31c83097eed25d82> , <http://ns.inria.fr/zoomathia/annotation/89c39abd09725a21fcf1ff1aa65d4c71fd44d765> , <http://ns.inria.fr/zoomathia/annotation/e096ac869fd641c8d2a874c3bd46ca01d66a2081> , <http://ns.inria.fr/zoomathia/annotation/ba9afff05a9d4d2210d834edab1ee9e9d0c2cd1d> .

<http://ns.inria.fr/zoomathia/annotation/125c868e010db3ebbc953034b3902221f6690c88>
      a       zoo:AutomaticAnnotation ;
