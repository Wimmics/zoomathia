              ] .

<http://ns.inria.fr/zoomathia/annotation/bbb492d03d5e26094c01c79b5a74a4bd8b0d9321>
      a       zoo:AutomaticAnnotation ;
      oa:hasBody <http://dbpedia.org/resource/Birmingham_Six> ;
      oa:hasTarget
              [ oa:hasSelector
                        [ a       oa:TextPositionSelector , oa:TextQuoteSelector ;
                          oa:exact "plenty"
                        ] ;
                oa:hasSource <http://ns.inria.fr/zoomathia/XENOPHON/on_the_art_of_horsemanship/e/11/1/text/1>
              ] .

