      zoo:identifier 84 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/VARRO/de_re_rustica/e/4> ;
      zoo:text "84 Swine, especially, eat it eagerly; but the use of bird-dung for feed has no place in modern practice." .

<http://ns.inria.fr/zoomathia/VARRO/de_re_rustica/e/4/text/72>
