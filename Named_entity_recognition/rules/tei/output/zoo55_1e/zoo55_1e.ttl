<http://ns.inria.fr/zoomathia/VARRO/de_re_rustica/e/4/text/106>
      a       zoo:Paragraph ;
      zoo:identifier 106 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/VARRO/de_re_rustica/e/4> ;
      zoo:text "108 Cotonea (mala) are the κυδώνια of the Greeks, our quinces; the struthea were a smaller variety of the same. In the absence of scientific descriptions, it is impossible to identify varieties which have only local names." .

