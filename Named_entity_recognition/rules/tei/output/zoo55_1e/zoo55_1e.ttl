      zoo:identifier 67 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/VARRO/de_re_rustica/e/4> ;
      zoo:text "67 Cato, 11.1." .

<http://ns.inria.fr/zoomathia/VARRO/de_re_rustica/e/4/text/220>
      a       zoo:Paragraph ;
      zoo:identifier 220 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/VARRO/de_re_rustica/e/4> ;
