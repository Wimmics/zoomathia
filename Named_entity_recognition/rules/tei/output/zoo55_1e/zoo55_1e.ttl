<http://ns.inria.fr/zoomathia/VARRO/de_re_rustica/e/4/text/283>
      a       zoo:Paragraph ;
      zoo:identifier 283 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/VARRO/de_re_rustica/e/4> ;
