<http://ns.inria.fr/zoomathia/VARRO/de_re_rustica/e/4/text/117>
      a       zoo:Paragraph ;
      zoo:identifier 117 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/VARRO/de_re_rustica/e/4> ;
