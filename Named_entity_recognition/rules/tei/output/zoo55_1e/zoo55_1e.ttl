      zoo:isPartOf <http://ns.inria.fr/zoomathia/VARRO/de_re_rustica/e/4> ;
      zoo:text "72 This seems to be a Latin variation of the Greek sevenfold division given by Hippocrates and Galen." .

<http://ns.inria.fr/zoomathia/VARRO/de_re_rustica/e/4/text/60>
