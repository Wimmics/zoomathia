<http://ns.inria.fr/zoomathia/VARRO/de_re_rustica/e/3/17/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/VARRO/de_re_rustica/e/3/17> ;
