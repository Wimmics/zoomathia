      a       zoo:Paragraph ;
      zoo:identifier 200 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/VARRO/de_re_rustica/e/4> ;
      zoo:text "50 Fircellius Pavo ('Peacock'), whose full name was given, III .2.2 ." .

