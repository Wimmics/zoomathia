      zoo:isPartOf <http://ns.inria.fr/zoomathia/VARRO/de_re_rustica/e/4> ;
      zoo:text "89 θηροτροφεῖον, 'a place for rearing game.'" .

<http://ns.inria.fr/zoomathia/VARRO/de_re_rustica/e/4/text/325>
      a       zoo:Paragraph ;
      zoo:identifier 325 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/VARRO/de_re_rustica/e/4> ;
      zoo:text "77 Columella's goose-pens (VIII.14.1) were walled enclosures, nine feet high, with three-foot coops built into the walls." .

<http://ns.inria.fr/zoomathia/VARRO/de_re_rustica/e/4/text/313>
