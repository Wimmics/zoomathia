      zoo:identifier 19 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/VARRO/de_re_rustica/e/1/2> ;
      zoo:text "13 For I observe that those who have written on agriculture, whether in Punic, or Greek, or Latin, have wandered too far from the subject.'" .

