      zoo:isPartOf <http://ns.inria.fr/zoomathia/VARRO/de_re_rustica/e/4> ;
      zoo:text "52 A small island, now Pianosa, about 20 miles due south of Elba." .

<http://ns.inria.fr/zoomathia/VARRO/de_re_rustica/e/4/text/73>
