                        [ a       oa:TextPositionSelector , oa:TextQuoteSelector ;
                          oa:exact "called"
                        ] ;
                oa:hasSource <http://ns.inria.fr/zoomathia/VARRO/de_re_rustica/e/1/54/text/5>
              ] .

<http://ns.inria.fr/zoomathia/VARRO/de_re_rustica/e/3/16/text/3>
      a       zoo:Paragraph ;
      zoo:hasAnnotation <http://ns.inria.fr/zoomathia/annotation/c52c20226957ab8a9f2bcc6c717a0b28b25db4ef> , <http://ns.inria.fr/zoomathia/annotation/d7e296f5181239d3cbbcb3eea87da3c748457580> , <http://ns.inria.fr/zoomathia/annotation/a64279840c9b13f482b978e0c7a9f4d453ecad2c> , <http://ns.inria.fr/zoomathia/annotation/8cedf585ebb3607c3ed2ad060f98b899b45f0efd> , <http://ns.inria.fr/zoomathia/annotation/9180e955c6d568234cd66759a74ce3ea6db82a15> , <http://ns.inria.fr/zoomathia/annotation/e9cbe34d0bd154589e72204f3da70f01fd86baf9> , <http://ns.inria.fr/zoomathia/annotation/6e78fc6ef393dc6220894b31b0c799a286066324> .

