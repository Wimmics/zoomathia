<http://ns.inria.fr/zoomathia/VARRO/de_re_rustica/e/4/text/116>
      a       zoo:Paragraph ;
      zoo:identifier 116 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/VARRO/de_re_rustica/e/4> ;
