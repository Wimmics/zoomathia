      zoo:identifier 145 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/VARRO/de_re_rustica/e/4> ;
      zoo:text "34 See Cato, 2.7." .

<http://ns.inria.fr/zoomathia/VARRO/de_re_rustica/e/4/text/266>
      a       zoo:Paragraph ;
      zoo:identifier 266 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/VARRO/de_re_rustica/e/4> ;
