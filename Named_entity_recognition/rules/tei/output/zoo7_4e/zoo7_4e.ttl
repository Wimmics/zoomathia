<http://ns.inria.fr/zoomathia/annotation/f2fcd9ca237ada8d18abff9371764989c8c5c881>
      a       zoo:AutomaticAnnotation ;
      oa:hasBody <http://dbpedia.org/resource/Qualitative_property> ;
      oa:hasTarget
