<http://ns.inria.fr/zoomathia/annotation/3d2060c91706ead65aa6c04dfe7b7f796fbfc091>
      a       zoo:AutomaticAnnotation ;
      oa:hasBody <http://dbpedia.org/resource/Insect> ;
      oa:hasTarget
              [ oa:hasSelector
                        [ a       oa:TextPositionSelector , oa:TextQuoteSelector ;
