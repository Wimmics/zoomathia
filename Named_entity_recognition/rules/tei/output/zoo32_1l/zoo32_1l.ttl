      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/16> ;
      zoo:text "At ille lentus: Quaeso, num binas mihi" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13/text/30>
      a       zoo:Paragraph ;
      zoo:identifier 30 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13> ;
      zoo:text "Ne subeat ille poenas neglegentiae." .

