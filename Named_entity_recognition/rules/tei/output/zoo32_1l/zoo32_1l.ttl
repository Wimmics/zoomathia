      zoo:identifier 34 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8> ;
      zoo:text "Rogare populus hunc coronam existimat." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/9/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/9> ;
      zoo:text "Cum castitatem Iuno laudaret suam," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/4/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/4> ;
      zoo:text "Ut iura posset inter homines reddere." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21/text/23>
      a       zoo:Paragraph ;
      zoo:identifier 23 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21> ;
      zoo:text "Qui dum quadrantes aggeras patrimonio" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/14/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/14> ;
      zoo:text "Et aequitatis vellet famam consequi," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/17/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/17> ;
      zoo:text "Nuper donavit; si non fastidis, veni;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/32>
      a       zoo:Paragraph ;
      zoo:identifier 32 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Habebunt certe quo se oblectent posteri." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6/text/20>
      a       zoo:Paragraph ;
      zoo:identifier 20 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6> ;
      zoo:text "Nihil est repertum, multis onerant lancibus" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/26/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/26> ;
      zoo:text "Non intellexit seque e conspectu abstulit." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/9/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/9> ;
      zoo:text "In officinam fabri venit vipera." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/29/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/29> ;
      zoo:text "En cuncta: levitas putris et volito cinis!" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/24/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/24> ;
      zoo:text "Odiosa cornix super ovem consederat;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/13/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/13> ;
      zoo:text "Hoc illis narro, qui me non intellegunt." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/3/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/3> ;
      zoo:text "Mustela cum annis et senecta debilis" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8/text/33>
      a       zoo:Paragraph ;
      zoo:identifier 33 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8> ;
      zoo:text "Totum prosternit. Plaudit illudens eques." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/13/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/13> ;
      zoo:text "In qua retentis impeditus cornibus" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/16/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/16> ;
      zoo:text "Id esse verum parva haec fabella indicat." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/29/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/29> ;
      zoo:text "Totamque flammis arborem circumdedit," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/17/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/17> ;
      zoo:text "Potare est animus nectar, quod Pallas mihi" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/14/text/17>
      a       zoo:Paragraph ;
      zoo:identifier 17 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/14> ;
      zoo:text "Si pactam fuci non recusassent fidem." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/4/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/4> ;
      zoo:text "Subito accersitus nuntio magni Iovis" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/29/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/29> ;
      zoo:text "Quorum ex reliquiis animam nos accepimus," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/10/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/10> ;
      zoo:text "Tace inquit ante hoc novi quam tu natus es." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/33>
      a       zoo:Paragraph ;
      zoo:identifier 33 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Nunc fabularum cur sit inventum genus," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/5/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/5> ;
      zoo:text "Derepit ad cubile setosae suis:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/22/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/22> ;
      zoo:text "Sive hoc ineptum sive laudandum est opus," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21/text/26>
      a       zoo:Paragraph ;
      zoo:identifier 26 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21> ;
      zoo:text "Libitina ne quid de tuo faciat lucri." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/6/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/6> ;
      zoo:text "Vacca et capella et patiens ovis iniuriae" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19/text/16>
      a       zoo:Paragraph ;
      zoo:identifier 16 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19> ;
      zoo:text "Post aliquod tempus alios ascribi iubent." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/14/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/14> ;
      zoo:text "Probanda cunctis est quidem sententia," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/13/text/15>
      a       zoo:Paragraph ;
      zoo:identifier 15 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/13> ;
      zoo:text "Et quae laudaram quantum luctus habuerint." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/16/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/16> ;
      zoo:text "Suadebat asino fugere, ne possent capi." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6> ;
      zoo:text "Habere res desierint, quas acceperint," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3/text/30>
      a       zoo:Paragraph ;
      zoo:identifier 30 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3> ;
      zoo:text "Malum perferte. — Vos quoque, o cives, ait," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/13/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/13> ;
      zoo:text "Olim redisses ad splendorem pristinum." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13/text/31>
      a       zoo:Paragraph ;
      zoo:identifier 31 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13> ;
      zoo:text "Sic turpitudo laudis obsedit locum." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/9/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/9> ;
      zoo:text "Sic ut concedas pedibus aliquid scalpere." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/3/text/15>
      a       zoo:Paragraph ;
      zoo:identifier 15 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/3> ;
      zoo:text "Alter similiter, deinde perit et tertius." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/4/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/4> ;
      zoo:text "Uvam appetebat summis saliens viribus;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/22/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/22> ;
      zoo:text "Invenit ille, nostra perfecit manus." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/27/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/27> ;
      zoo:text "Quanto poetae sunt molesti validius." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/14/text/16>
      a       zoo:Paragraph ;
      zoo:identifier 16 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/14> ;
      zoo:text "Hanc praeterissem fabulam silentio," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/14/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/14> ;
      zoo:text "Sed ad perniciem solet agi sinceritas." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/4/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/4> ;
      zoo:text "Commendat officinam fallaci Dolo," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/29/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/29> ;
      zoo:text "Ego eloquens in pace, fortis proeliis," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/5/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/5> ;
      zoo:text "Terrore offuso et perturbatis sensibus" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/10/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/10> ;
      zoo:text "Monstrabat vitulus quo se pacto plecteret." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/34>
      a       zoo:Paragraph ;
      zoo:identifier 34 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Brevi docebo. Servitus obnoxia," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19/text/17>
      a       zoo:Paragraph ;
      zoo:identifier 17 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19> ;
      zoo:text "Rumor legatos superiores prodidit." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21/text/25>
      a       zoo:Paragraph ;
      zoo:identifier 25 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21> ;
      zoo:text "Qui circumcidis omnem impensam funeri" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/16/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/16> ;
      zoo:text "Cui serviam clitellas cum portem meas?" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/6/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/6> ;
      zoo:text "Testatur haec fabella propositum meum." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/16/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/16> ;
      zoo:text "Is hostium clamore subito territus" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/9/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/9> ;
      zoo:text "Respondit illa: Quicquid dederis, satis erit," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6> ;
      zoo:text "Ni data possideant aut fruantur; tum: simul" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/24/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/24> ;
      zoo:text "Ideo senectam mille in annos prorogo." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/3/text/16>
      a       zoo:Paragraph ;
      zoo:identifier 16 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/3> ;
      zoo:text "Mox venit aliquot saeculis retorridus" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/13/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/13> ;
      zoo:text "Ego quod te inveni, potior cui multo est cibus," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/4/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/4> ;
      zoo:text "Quam tangere ut non potuit, discedens ait:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/35>
      a       zoo:Paragraph ;
      zoo:identifier 35 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Quia quae volebat non audebat dicere," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/11/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/11> ;
      zoo:text "Victorem forte gymnici certaminis" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/22/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/22> ;
      zoo:text "Sed exsequamur coepti propositum ordinem." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8/text/39>
      a       zoo:Paragraph ;
      zoo:identifier 39 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8> ;
      zoo:text "Ab universis capite est protrusus foras." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/29/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/29> ;
      zoo:text "Papilio vespam praetervolitans viderat." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/19>
      a       zoo:Paragraph ;
      zoo:identifier 19 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Simulavit iter ad villam clamque in oppido" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/5/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/5> ;
      zoo:text "Ut nostram in plano facile progeniem opprimat." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/10/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/10> ;
      zoo:text "Cum vix intrare posset ad praesepia," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/17/text/19>
      a       zoo:Paragraph ;
      zoo:identifier 19 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/17> ;
      zoo:text "Sic viva quod negarat tribuit mortua." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19/text/18>
      a       zoo:Paragraph ;
      zoo:identifier 18 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19> ;
      zoo:text "Timentes rursus aliquid ne simile accidat," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/18/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/18> ;
      zoo:text "Divi legerunt arbores. Quercus Iovi" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/4/text/19>
      a       zoo:Paragraph ;
      zoo:identifier 19 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/4> ;
      zoo:text "At trunca species haesit in vestigio." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/1/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/1> ;
      zoo:text "Quod arbores loquantur, non tantum ferae," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/6/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/6> ;
      zoo:text "Hi cum cepissent cervum vasti corporis," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/3/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/3> ;
      zoo:text "Abiecit neglegenter. Mus escam putans" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6> ;
      zoo:text "Athenas rumor implet. Mater sedula" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/13/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/13> ;
      zoo:text "O me infelicem! qui nunc demum intellego" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/9/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/9> ;
      zoo:text "Dic sodes quanto possis satiari cibo." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/24/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/24> ;
      zoo:text "Scio quem lacessam, cui dolosa blandiar;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/13/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/13> ;
      zoo:text "Iaces indigno quanta res inquit loco!" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/36>
      a       zoo:Paragraph ;
      zoo:identifier 36 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Affectus proprios in fabellas transtulit" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/27/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/27> ;
      zoo:text "Si non ingenium, certe brevitatem approba," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/16/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/16> ;
      zoo:text "Clitellas impositurum victorem putas?" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8/text/38>
      a       zoo:Paragraph ;
      zoo:identifier 38 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8> ;
      zoo:text "Superbiens honore divinae domus," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/4/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/4> ;
      zoo:text "In disciplinam nuper quem receperat." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/29/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/29> ;
      zoo:text "O sortem iniquam! dum vivebant corpora," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/10/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/10> ;
      zoo:text "Angusto in aditu taurus luctans cornibus" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/11/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/11> ;
      zoo:text "Tu non videris perdidisse quod petis;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/17/text/18>
      a       zoo:Paragraph ;
      zoo:identifier 18 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/17> ;
      zoo:text "Trepidantem consectata est et leto dedit." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/18/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/18> ;
      zoo:text "Olim quas vellent esse in tutela sua," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19/text/19>
      a       zoo:Paragraph ;
      zoo:identifier 19 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19> ;
      zoo:text "Odore canibus anum, sed multo, replent." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/4/text/18>
      a       zoo:Paragraph ;
      zoo:identifier 18 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/4> ;
      zoo:text "Modesto gressu sancta incessit Veritas;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/1/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/1> ;
      zoo:text "Fictis iocari nos meminerit fabulis." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/14/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/14> ;
      zoo:text "Utilius homini nihil est quam recte loqui:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/6/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/6> ;
      zoo:text "Socii fuere cum leone in saltibus." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/9/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/9> ;
      zoo:text "Interrogasse sic gallinam dicitur:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/13/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/13> ;
      zoo:text "Utilia mihi quam fuerint quae despexeram," .

