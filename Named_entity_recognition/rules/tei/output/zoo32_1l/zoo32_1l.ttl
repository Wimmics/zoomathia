      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/20> ;
      zoo:text "Invenit ille, nostra perfecit manus." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/52>
      a       zoo:Paragraph ;
      zoo:identifier 52 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Si Phryx Aesopus potuit, Anacharsis Scytha" .

