      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/18> ;
      zoo:text "Haec inquit merces fraudis a superis datur." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3/text/17>
      a       zoo:Paragraph ;
      zoo:identifier 17 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3> ;
      zoo:text "Forte una tacite profert e stagno caput" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23> ;
      zoo:text "In capite regis sedeo cum visum est mihi," .

