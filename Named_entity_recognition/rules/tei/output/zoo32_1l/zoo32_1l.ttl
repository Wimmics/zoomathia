      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/6> ;
      zoo:text "Patriam, parentes, natos, castas coniuges" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Ut liber animus sentiat vim carminis." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/1/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/1> ;
      zoo:text "Quare, Particulo, quoniam caperis fabulis," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/26/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/26> ;
      zoo:text "Usus poeta moris est licentia" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6/text/18>
      a       zoo:Paragraph ;
      zoo:identifier 18 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6> ;
      zoo:text "Postquam consumpta est temporis longi mora," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/25/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/25> ;
      zoo:text "Cum servus nequam Socrati malediceret," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/51>
      a       zoo:Paragraph ;
      zoo:identifier 51 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Rem me professum dicet fors aliquis gravem." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/7/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/7> ;
      zoo:text "Nam et ubi tricandum et ubi sit currendum scio." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/1/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/1> ;
      zoo:text "Quartum libellum, cum vacarit, perleges." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/35>
      a       zoo:Paragraph ;
      zoo:identifier 35 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Romamque pertraxerunt ad centumviros." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21/text/20>
      a       zoo:Paragraph ;
      zoo:identifier 20 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21> ;
      zoo:text "Qui tristis audis musicum citharae sonum," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/3/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/3> ;
      zoo:text "Quod quaeque optarit. Mater suppliciter rogat" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/22/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/22> ;
      zoo:text "Rogare coepit ne se domino proderet." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/17/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/17> ;
      zoo:text "Faciebat, solitae victum in tenebris quaerere" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/4/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/4> ;
      zoo:text "Hic pertinere ad domini respondet caput" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/18/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/18> ;
      zoo:text "Haec inquit merces fraudis a superis datur." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3/text/17>
      a       zoo:Paragraph ;
      zoo:identifier 17 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3> ;
      zoo:text "Forte una tacite profert e stagno caput" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23> ;
      zoo:text "Redire in patriam voluit cursu pelagio;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/28/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/28> ;
      zoo:text "Et indiderunt bestiae nomen dei," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/5/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/5> ;
      zoo:text "Et quem tenebat ore dimisit cibum," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/16/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/16> ;
      zoo:text "Et masculina membra applicuit feminis." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/12/text/20>
      a       zoo:Paragraph ;
      zoo:identifier 20 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/12> ;
      zoo:text "Novissime interdicit ne cum malefico" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/26/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/26> ;
      zoo:text "Atque interposuit gemina Ledae sidera," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/25/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/25> ;
      zoo:text "Places tibi inquit quia cui non debes places;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Verum inquis tanti non est ingenium tuum," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/3/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/3> ;
      zoo:text "Barbatum ut videat natum quam primum suum;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/7/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/7> ;
      zoo:text "Quapropter aufer frivolam insolentiam;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/28/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/28> ;
      zoo:text "Illi qui iactant se verborum copia)," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/52>
      a       zoo:Paragraph ;
      zoo:identifier 52 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Si Phryx Aesopus potuit, Anacharsis Scytha" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/36>
      a       zoo:Paragraph ;
      zoo:identifier 36 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Maligna insontem deprimit suspicio," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/1/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/1> ;
      zoo:text "Usus vetusto genere, sed rebus novis)," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/17/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/17> ;
      zoo:text "Cicada acerbum noctuae convicium" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3/text/16>
      a       zoo:Paragraph ;
      zoo:identifier 16 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3> ;
      zoo:text "Hoc mersum limo cum iaceret diutius," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23> ;
      zoo:text "Erat autem, ut aiunt, natus in Cia insula:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/21/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/21> ;
      zoo:text "Periere quam quod petierant contingerent." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/4/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/4> ;
      zoo:text "Ad consulendos currit maerens hariolos." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/22/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/22> ;
      zoo:text "Pastor capellae cornu baculo fregerat:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/15/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/15> ;
      zoo:text "Ebibere iussit ipsum posito praemio." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23> ;
      zoo:text "Ascendit navem, quam tempestas horrida" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/7/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/7> ;
      zoo:text "Gravi nequiquam te lassabit pondere." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/16/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/16> ;
      zoo:text "Applicuit virginale generi masculo" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/5/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/5> ;
      zoo:text "Nec quem petebat potuit adeo adtingere." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/12/text/21>
      a       zoo:Paragraph ;
      zoo:identifier 21 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/12> ;
      zoo:text "Usum bonus consociet ullius rei." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/25/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/25> ;
      zoo:text "Idque ille sciret notum circumstantibus:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Momentum ut horae pereat officiis meis." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/28/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/28> ;
      zoo:text "Trivio conceptus, educatus stercore." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6> ;
      zoo:text "Ad paenitendum rebus manifestis agi." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/6/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/6> ;
      zoo:text "Tripodes moventur, mugit adytis Religio," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/33>
      a       zoo:Paragraph ;
      zoo:identifier 33 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Et ferro incubuit, quod credulitas strinxerat." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Ergo exploranda est veritas multum, prius" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3/text/19>
      a       zoo:Paragraph ;
      zoo:identifier 19 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3> ;
      zoo:text "Illae timore posito certatim adnatant" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/18/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/18> ;
      zoo:text "Quod non debebat solvit. Post paucos dies" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23> ;
      zoo:text "Mercede accepta laudem victorum canens." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9/text/26>
      a       zoo:Paragraph ;
      zoo:identifier 26 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9> ;
      zoo:text "Quem convocata iubet occidi familia" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/8/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/8> ;
      zoo:text "Hoc illis dictum est, quibus honorem et gloriam" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/26/text/20>
      a       zoo:Paragraph ;
      zoo:identifier 20 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/26> ;
      zoo:text "Splendebat hilare poculis convivium," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/24/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/24> ;
      zoo:text "Namque ista subita me iubet benignitas" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6> ;
      zoo:text "Et, pro iudicio dum stant erroris sui," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/34>
      a       zoo:Paragraph ;
      zoo:identifier 34 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Accusatores postularunt mulierem" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/28/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/28> ;
      zoo:text "Qui concupisti subito regales opes," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Quam stulta prave iudicet sententia." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/6/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/6> ;
      zoo:text "Tremuntque lauri et ipse pallescit dies." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/18/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/18> ;
      zoo:text "Bidens iacentem in fovea conspexit lupum:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3/text/18>
      a       zoo:Paragraph ;
      zoo:identifier 18 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3> ;
      zoo:text "Et explorato rege cunctas evocat." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23> ;
      zoo:text "Hoc genere quaestus postquam locuples factus est," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8/text/20>
      a       zoo:Paragraph ;
      zoo:identifier 20 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8> ;
      zoo:text "Crepusculo solutus, qua visum est, vagor." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9/text/25>
      a       zoo:Paragraph ;
      zoo:identifier 25 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9> ;
      zoo:text "Cervi quoque alta conspicatur cornua;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/8/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/8> ;
      zoo:text "O quanta species, inquit, cerebrum non habet!" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/26/text/21>
      a       zoo:Paragraph ;
      zoo:identifier 21 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/26> ;
      zoo:text "Magno apparatu laeta resonabat domus," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/24/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/24> ;
      zoo:text "Ne latrem pro re domini? Multum falleris." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6> ;
      zoo:text "Proposito cunctos invitavit praemio" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/6/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/6> ;
      zoo:text "Voces resolvit icta Python numine:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/18/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/18> ;
      zoo:text "Deberi dixit, verum affirmavit decem." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/31>
      a       zoo:Paragraph ;
      zoo:identifier 31 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Sopita primo quae nil somno senserat;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23> ;
      zoo:text "Quo paupertatem sustineret facilius," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Hippolytus obiit, quia novercae creditum est;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8/text/21>
      a       zoo:Paragraph ;
      zoo:identifier 21 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8> ;
      zoo:text "Affertur ultro panis; de mensa sua" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9/text/28>
      a       zoo:Paragraph ;
      zoo:identifier 28 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9> ;
      zoo:text "Dominum videre plurimum in rebus suis." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/5/text/17>
      a       zoo:Paragraph ;
      zoo:identifier 17 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/5> ;
      zoo:text "Consulto involvit veritatem antiquitas," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/24/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/24> ;
      zoo:text "Heus inquit linguam vis meam praecludere," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/26/text/22>
      a       zoo:Paragraph ;
      zoo:identifier 22 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/26> ;
      zoo:text "Repente duo cum iuvenes sparsi pulvere," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6> ;
      zoo:text "Facturus ludos dives quidam nobilis" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23> ;
      zoo:text "Circum ire coepit urbes Asiae nobiles," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/6/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/6> ;
      zoo:text "Audite, gentes, Delii monitus dei:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/32>
      a       zoo:Paragraph ;
      zoo:identifier 32 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Repraesentavit in se poenam facinoris" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Cassandrae quia non creditum, ruit Ilium." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/18/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/18> ;
      zoo:text "Ovis damnata falso testimonio" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/5/text/18>
      a       zoo:Paragraph ;
      zoo:identifier 18 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/5> ;
      zoo:text "Ut sapiens intellegeret, erraret rudis." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8/text/22>
      a       zoo:Paragraph ;
      zoo:identifier 22 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8> ;
      zoo:text "Dat ossa dominus; frusta iactat familia" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/24/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/24> ;
      zoo:text "Obiecto temptans an cibo posset capi:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9/text/27>
      a       zoo:Paragraph ;
      zoo:identifier 27 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9> ;
      zoo:text "Praedamque tollit. Haec significat fabula" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/8/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/8> ;
      zoo:text "Fortuna tribuit, sensum communem abstulit." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Phaedri libellos legere si desideras," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/26/text/23>
      a       zoo:Paragraph ;
      zoo:identifier 23 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/26> ;
      zoo:text "Sudore multo diffluentes corpora," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/28/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/28> ;
      zoo:text "Omittit ipsum persequi et vocat canes." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/18/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/18> ;
      zoo:text "Quem commendasse panem se contenderet," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23> ;
      zoo:text "Homo doctus in se semper divitias habet." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8/text/23>
      a       zoo:Paragraph ;
      zoo:identifier 23 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8> ;
      zoo:text "Et, quod fastidit quisque, pulmentarium." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/9/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/9> ;
      zoo:text "Licet horreum mi pateat, ego scalpam tamen." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/24/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/24> ;
      zoo:text "Nocturnus cum fur panem misisset cani," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9/text/22>
      a       zoo:Paragraph ;
      zoo:identifier 22 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9> ;
      zoo:text "Accedit ad praesepe: Cur frondis parum est," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/1/text/19>
      a       zoo:Paragraph ;
      zoo:identifier 19 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/1> ;
      zoo:text "Dignumque longa iudicatis memoria." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/30>
      a       zoo:Paragraph ;
      zoo:identifier 30 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Sanctamque uxorem dormientem cubiculo," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/18/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/18> ;
      zoo:text "Lupus citatus testis non unum modo" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23> ;
      zoo:text "Simonides, qui scripsit egregium melos," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/6/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/6> ;
      zoo:text "Utilius nobis quid sit dic, Phoebe, obsecro," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8/text/24>
      a       zoo:Paragraph ;
      zoo:identifier 24 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8> ;
      zoo:text "Sic sine labore venter impletur meus." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/24/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/24> ;
      zoo:text "Verum peritis irritos tendit dolos." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/9/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/9> ;
      zoo:text "Tum denique illa fassa est naturae malum:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9/text/21>
      a       zoo:Paragraph ;
      zoo:identifier 21 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9> ;
      zoo:text "Et quia corruptos viderat nuper boves," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6> ;
      zoo:text "Pravo favore labi mortales solent" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6/text/19>
      a       zoo:Paragraph ;
      zoo:identifier 19 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6> ;
      zoo:text "Et excuti iuberent. Quo facto simul" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Sed fabulosa ne vetustate elevem," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/6/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/6> ;
      zoo:text "Qui Delphos et formosum Parnasum incolis." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/9/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/9> ;
      zoo:text "Ex toto, ne quid scalpas, quid desideras?" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/24/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/24> ;
      zoo:text "Repente liberalis stultis gratus est," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/18/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/18> ;
      zoo:text "Solent mendaces luere poenas malefici." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9/text/24>
      a       zoo:Paragraph ;
      zoo:identifier 24 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9> ;
      zoo:text "Quantum est laboris? Dum scrutatur singula," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/8/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/8> ;
      zoo:text "Personam tragicam forte vulpes viderat:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/7/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/7> ;
      zoo:text "Musca in temone sedit et mulam increpans:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8/text/25>
      a       zoo:Paragraph ;
      zoo:identifier 25 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8> ;
      zoo:text "Age, si quo abire est animus, est licentia?" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Narrabo tibi memoria quod factum est mea." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/18/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/18> ;
      zoo:text "Calumniator ab ove cum peteret canis," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/6/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/6> ;
      zoo:text "Quid hoc? sacratae vatis horrescunt comae," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Maritus quidam cum diligeret coniugem" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9/text/23>
      a       zoo:Paragraph ;
      zoo:identifier 23 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9> ;
      zoo:text "Stramenta desunt? Tollere haec aranea" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8/text/26>
      a       zoo:Paragraph ;
      zoo:identifier 26 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8> ;
      zoo:text "Non plane est inquit. Fruere, quae laudas, canis:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/12/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/12> ;
      zoo:text "Ignotos fallit, notis est derisui." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/26/text/29>
      a       zoo:Paragraph ;
      zoo:identifier 29 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/26> ;
      zoo:text "Ruina camerae subito oppressit ceteros;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/7/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/7> ;
      zoo:text "Aegre recepti tamen evaserunt necem." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/19/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/19> ;
      zoo:text "Lacrimis obortis: Ite felices ait;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/13/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/13> ;
      zoo:text "Cum gratulantes persalutasset deos," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21/text/18>
      a       zoo:Paragraph ;
      zoo:identifier 18 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21> ;
      zoo:text "Tibi dico, avare, gaudium heredis tui," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6/text/17>
      a       zoo:Paragraph ;
      zoo:identifier 17 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6> ;
      zoo:text "Et sic porcelli vocem est imitatus sua," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/19/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/19> ;
      zoo:text "Tibi forma, vires aquilae, luscinio melos," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/19/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/19> ;
      zoo:text "Augurium corvo, laeva cornici omina," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/10/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/10> ;
      zoo:text "Devenit hircus sitiens in eundem locum;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/7/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/7> ;
      zoo:text "Si vero accessit consiliator maleficus," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/5/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/5> ;
      zoo:text "Pertusa nec complere possunt dolia;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/14/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/14> ;
      zoo:text "Tunc demum ingemuit corvi deceptus stupor." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/12/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/12> ;
      zoo:text "Virtutis expers, verbis iactans gloriam," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/7/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/7> ;
      zoo:text "Duces eorum, qui capitibus cornua" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/19/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/19> ;
      zoo:text "Celebrate sine me cursu sollemnem diem;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/13/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/13> ;
      zoo:text "Veniente Pluto, qui Fortunae est filius," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6/text/18>
      a       zoo:Paragraph ;
      zoo:identifier 18 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6> ;
      zoo:text "Verum ut subesse pallio contenderent" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21/text/17>
      a       zoo:Paragraph ;
      zoo:identifier 17 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21> ;
      zoo:text "Quid mente caeca miserum torques spiritum?" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/19/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/19> ;
      zoo:text "Omnesque propriis sunt contentae dotibus." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/10/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/10> ;
      zoo:text "Et altiore clauderetur margine," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/14/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/14> ;
      zoo:text "Hac re probatur quantum ingenium valet;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/27/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/27> ;
      zoo:text "Quae cum lagonae collum frustra lamberet," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/5/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/5> ;
      zoo:text "Immo luxuriae quicquid dederis perfluet." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/7/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/7> ;
      zoo:text "Vis et nequitia quicquid oppugnant, ruit." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/13/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/13> ;
      zoo:text "Avertit oculos. Causam quaesivit pater." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/12/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/12> ;
      zoo:text "Asinus iacentem vidit in prato lyram." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/7/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/7> ;
      zoo:text "Suis ligarant, ut conspicuum in proelio" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/19/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/19> ;
      zoo:text "Ego quo scelesta furis attraxit manus," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/31/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/31> ;
      zoo:text "Paludis in secreta veniet latibula" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/10/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/10> ;
      zoo:text "Descende, amice; tanta bonitas est aquae" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/6/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/6> ;
      zoo:text "Comprensus namque poenas persolvit cruce." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6/text/15>
      a       zoo:Paragraph ;
      zoo:identifier 15 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6> ;
      zoo:text "Silentium ipsa fecit exspectatio." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/12/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/12> ;
      zoo:text "Contexit illum frutice et admonuit simul," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/19/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/19> ;
      zoo:text "Noli affectare quod tibi non est datum," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/9/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/9> ;
      zoo:text "Quia per gallinam denotarit feminas." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/31/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/31> ;
      zoo:text "Expulsus regno nemoris qui profugerit," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/14/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/14> ;
      zoo:text "Virtute semper praevalet sapientia." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13/text/29>
      a       zoo:Paragraph ;
      zoo:identifier 29 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13> ;
      zoo:text "Virique corpus tradit figendum cruci," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/13/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/13> ;
      zoo:text "Odi inquit illum, quia malis amicus est" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/12/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/12> ;
      zoo:text "Venari asello comite cum vellet leo," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/2/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/2> ;
      zoo:text "Ad rivum eundem lupus et agnus venerant" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/19/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/19> ;
      zoo:text "Ibi sorte tristi fata deflebo mea." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/3/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/3> ;
      zoo:text "Canos puella, nigros anus evellerat." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21/text/19>
      a       zoo:Paragraph ;
      zoo:identifier 19 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21> ;
      zoo:text "Qui ture superos, ipsum te fraudas cibo," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/10/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/10> ;
      zoo:text "Et copiosus. Illa fraudem moliens:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6/text/16>
      a       zoo:Paragraph ;
      zoo:identifier 16 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6> ;
      zoo:text "Ille in sinum repente demisit caput" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/19/text/15>
      a       zoo:Paragraph ;
      zoo:identifier 15 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/19> ;
      zoo:text "Delusa ne spes ad querelam reccidat." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/9/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/9> ;
      zoo:text "Risisse Iuno dicitur Veneris iocos," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/10/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/10> ;
      zoo:text "Simul rogavit esset an dulcis liquor" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/31/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/31> ;
      zoo:text "Est statio separata ac diversum genus;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/7/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/7> ;
      zoo:text "Contra potentes nemo est munitus satis;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/5/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/5> ;
      zoo:text "Urnis scelestas Danaides portant aquas," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/7/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/7> ;
      zoo:text "Haberent signum quod sequerentur milites," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6> ;
      zoo:text "In scaena vero postquam solus constitit" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/2/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/2> ;
      zoo:text "Siti compulsi; superior stabat lupus" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/7/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/7> ;
      zoo:text "Nec ullo pacto laedi posset condita," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/15/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/15> ;
      zoo:text "Aesopus turpi cum serviret feminae," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/19/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/19> ;
      zoo:text "Abegit quidam et in pistrinum vendidit." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/12/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/12> ;
      zoo:text "Fugientes ipse exciperet. Hic auritulus" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/3/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/3> ;
      zoo:text "Constantior fuissem vera existimans." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/10/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/10> ;
      zoo:text "Homo in periclum simul ac venit callidus," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/31/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/31> ;
      zoo:text "Sed haec simpliciter; illa tacite irascitur." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/17/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/17> ;
      zoo:text "Habitu esse similes qui sint virtute impares." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/5/text/15>
      a       zoo:Paragraph ;
      zoo:identifier 15 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/5> ;
      zoo:text "Quo quis maiorem possidet terrae locum," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/26/text/24>
      a       zoo:Paragraph ;
      zoo:identifier 24 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/26> ;
      zoo:text "Humanam supra formam, cuidam servulo" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/15/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/15> ;
      zoo:text "Et obiurgari iussit servum garrulum." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/7/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/7> ;
      zoo:text "Haesere in portis suntque capti ab hostibus;" .

