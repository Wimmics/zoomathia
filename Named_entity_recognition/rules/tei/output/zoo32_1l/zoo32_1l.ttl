      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/16> ;
      zoo:text "Feles habebat gallus lecticarios." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8/text/34>
