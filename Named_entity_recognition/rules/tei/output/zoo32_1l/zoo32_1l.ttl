      zoo:identifier 40 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Ut adiuvaret iuris iurandi fidem," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/31/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/31> ;
      zoo:text "Heu quanta nobis instat pernicies! ait." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/6/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/6> ;
      zoo:text "Amicos sublevate; miseris parcite;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/12/text/17>
      a       zoo:Paragraph ;
      zoo:identifier 17 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/12> ;
      zoo:text "Tibi inveniri maxime contrarios;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/26/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/26> ;
      zoo:text "Cum venatorem celeri pede fugeret lepus" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/3/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/3> ;
      zoo:text "Id forte meretrix cum rideret validius," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/3/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/3> ;
      zoo:text "At illa, vires ut refecit languidas," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23/text/21>
      a       zoo:Paragraph ;
      zoo:identifier 21 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23> ;
      zoo:text "Eratque absentis admirator maximus," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/16/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/16> ;
      zoo:text "Novissime prolapsam effundit sarcinam;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9> ;
      zoo:text "Frondem bubulcus affert, nil ideo videt." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/6/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/6> ;
      zoo:text "Erat destricta, cirris dependentibus," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/17/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/17> ;
      zoo:text "Quod dignitatem feminae aequassent suam." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/4/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/4> ;
      zoo:text "Fugantque rostris. Male mulcatus graculus" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/30/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/30> ;
      zoo:text "Respondit contra: Tu quidem bene praedicas;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/26/text/17>
      a       zoo:Paragraph ;
      zoo:identifier 17 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/26> ;
      zoo:text "Fraudatus quamvis et dolens iniuria," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/9/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/9> ;
      zoo:text "Nec gloriantis sustinet fratris iocos," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/2/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/2> ;
      zoo:text "Unguento delibutus, vestitu fluens," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21/text/18>
      a       zoo:Paragraph ;
      zoo:identifier 18 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21> ;
      zoo:text "Cum iam desierit esse beneficium utile" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19/text/36>
      a       zoo:Paragraph ;
      zoo:identifier 36 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19> ;
      zoo:text "Novum et venire qui videt culum olfacit." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/7/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/7> ;
      zoo:text "Confectus ille pessimo volumine:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/1/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/1> ;
      zoo:text "Sua cuique cum sit animi cogitatio" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3> ;
      zoo:text "Omnino insuetis), onus et coepissent queri," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Ut assuetam fortius praestes vicem?" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/1/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/1> ;
      zoo:text "Quicumque fuerit ergo narrandi iocus," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/16/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/16> ;
      zoo:text "Quae ratio procreasset. Exposuit senex:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/26/text/16>
      a       zoo:Paragraph ;
      zoo:identifier 16 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/26> ;
      zoo:text "Hodie invitare, quorum es in numero mihi." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/15/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/15> ;
      zoo:text "Arcum retensum posuit in media via:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/9/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/9> ;
      zoo:text "Magno dolore victus coepit singulos" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13/text/19>
      a       zoo:Paragraph ;
      zoo:identifier 19 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13> ;
      zoo:text "Et uritur impudentis sensim cupiditas." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/30/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/30> ;
      zoo:text "In campo non sum, sed par sub divo tibi." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/26/text/18>
      a       zoo:Paragraph ;
      zoo:identifier 18 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/26> ;
      zoo:text "Ne male dimissam gratiam corrumperet," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/9/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/9> ;
      zoo:text "Hic se formosum iactat: illa irascitur" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/2/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/2> ;
      zoo:text "Et admiratus fuerat ingenium viri," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21/text/17>
      a       zoo:Paragraph ;
      zoo:identifier 17 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21> ;
      zoo:text "Frustra adiuvare bonitas nitetur tua," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/7/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/7> ;
      zoo:text "Ego inquit quod te laudas vehementer probo," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3> ;
      zoo:text "Aesopus talem tum fabellam rettulit." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/1/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/1> ;
      zoo:text "Ut illud ipsum cupiat famae tradere," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/10/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/10> ;
      zoo:text "Aesopi ingenio statuam posuere Attici" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13> ;
      zoo:text "Custodes dantur milites cadaverum" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/16/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/16> ;
      zoo:text "Idem Prometheus, auctor vulgi fictilis" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/15>
      a       zoo:Paragraph ;
      zoo:identifier 15 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Mutandum tibi propositum est ut vitae genus," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/1/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/1> ;
      zoo:text "Acuatque sese diligens industria." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/15/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/15> ;
      zoo:text "Heus! inquit sapiens, expedi quid fecerim." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/9/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/9> ;
      zoo:text "Os devoratum fauce cum haereret lupi," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13> ;
      zoo:text "Cruci suffixi luerunt poenas numini." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/26/text/19>
      a       zoo:Paragraph ;
      zoo:identifier 19 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/26> ;
      zoo:text "Promisit. Rediit hora dicta, recubuit." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/7/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/7> ;
      zoo:text "Numquid tibi inquit visus sum superbior?" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/10/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/10> ;
      zoo:text "Non ut labores dico, sed ut istum domes," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/2/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/2> ;
      zoo:text "Hunc ubi tyrannus vidit extremo agmine:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/1/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/1> ;
      zoo:text "Quo pacto divinabit quidnam omiserim," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/15/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/15> ;
      zoo:text "Et quasi delirum risit. Quod sensit simul" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/9/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/9> ;
      zoo:text "Ergo ad patrem decurrit laesura invicem" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/30/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/30> ;
      zoo:text "Gravi destringunt alios contumelia" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/1/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/1> ;
      zoo:text "Re commendatur, non auctoris nomine." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13> ;
      zoo:text "Horum reliquias ne quis posset tollere," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/16>
      a       zoo:Paragraph ;
      zoo:identifier 16 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Intrare si Musarum limen cogitas." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13/text/17>
      a       zoo:Paragraph ;
      zoo:identifier 17 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13> ;
      zoo:text "Videtque et aegram et facie pulchra feminam." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/9/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/9> ;
      zoo:text "Impune abire deinde quia iam non potest." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3> ;
      zoo:text "Cum tristem servitutem flerent Attici," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9/text/20>
      a       zoo:Paragraph ;
      zoo:identifier 20 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9> ;
      zoo:text "Haec inter ipse dominus a cena redit" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13> ;
      zoo:text "Interea fanum qui compilarant Iovis," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/2/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/2> ;
      zoo:text "Veniebat gressu delicato et languido." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21/text/19>
      a       zoo:Paragraph ;
      zoo:identifier 19 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21> ;
      zoo:text "Et mors vicina flagitabit debitum." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/6/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/6> ;
      zoo:text "Malo afficietur si quis quartam tetigerit." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/7/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/7> ;
      zoo:text "Haud vana nobis ingeni fiducia est." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/13/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/13> ;
      zoo:text "Canes elusit. Silva tum excepit ferum," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/10/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/10> ;
      zoo:text "Qui calce et cornu multos reddit debiles." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/15/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/15> ;
      zoo:text "Derisor potius quam deridendus senex," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/1/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/1> ;
      zoo:text "Nam si quis talis etiam tituli est appetens," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/30/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/30> ;
      zoo:text "Plerumque stulti risum dum captant levem," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/9/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/9> ;
      zoo:text "Accipiens, quid enim? cuncta in contumeliam." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/1/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/1> ;
      zoo:text "Dum capiat aurem et servet propositum suum," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/16/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/16> ;
      zoo:text "Rogavit alter, tribadas et molles mares" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/17>
      a       zoo:Paragraph ;
      zoo:identifier 17 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Ego, quem Pierio mater enixa est iugo," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3> ;
      zoo:text "(Non quia crudelis ille, sed quoniam gravis" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13/text/18>
      a       zoo:Paragraph ;
      zoo:identifier 18 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13> ;
      zoo:text "Corruptus animus ilico succenditur" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/9/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/9> ;
      zoo:text "Bis peccat: primum quoniam indignos adiuvat;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13> ;
      zoo:text "Claram assecuta est famam castae virginis." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/10/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/10> ;
      zoo:text "Et tu nisi istum tecum assidue detines" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/7/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/7> ;
      zoo:text "In quis inepte multum se iactaverat." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/9/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/9> ;
      zoo:text "Idemque insignem pulchra facie filium." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/6/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/6> ;
      zoo:text "Sic totam praedam sola improbitas abstulit." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21> ;
      zoo:text "Fruar diutius, si celerius coepero." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Periculosum est credere et non credere." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/30/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/30> ;
      zoo:text "Asellus apro cum fuisset obvius:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19/text/31>
      a       zoo:Paragraph ;
      zoo:identifier 31 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19> ;
      zoo:text "Non veto dimitti, verum cruciari fame," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/9/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/9> ;
      zoo:text "Effectus impediret ne segnis mora," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/10/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/10> ;
      zoo:text "Nec generi tribui, sed virtuti gloriam." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/16/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/16> ;
      zoo:text "Cum separatim toto finxisset die," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/15/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/15> ;
      zoo:text "Novissime succumbit. Tum victor sophus:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13/text/15>
      a       zoo:Paragraph ;
      zoo:identifier 15 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13> ;
      zoo:text "Et usque in serum vigilias perduxerat." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/9/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/9> ;
      zoo:text "Qui pretium meriti ab improbis desiderat," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/18>
      a       zoo:Paragraph ;
      zoo:identifier 18 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "In quo tonanti sancta Mnemosyne Iovi" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/1/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/1> ;
      zoo:text "Exemplis continetur Aesopi genus;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/26/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/26> ;
      zoo:text "Accepit partem. Cum reliquum posceret:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13> ;
      zoo:text "Et in sepulcro lugens vitam degeret," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/7/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/7> ;
      zoo:text "Scire ergo cupiens quidnam sentiret senex," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/10/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/10> ;
      zoo:text "Feroxque ingenium comprimis clementia," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/9/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/9> ;
      zoo:text "Habebat quidam filiam turpissimam" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Utriusque exemplum breviter exponam rei." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21> ;
      zoo:text "Si cito rem perages, usus fiet longior:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19/text/32>
      a       zoo:Paragraph ;
      zoo:identifier 32 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19> ;
      zoo:text "Ne ventrem continere non possint suum." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/10/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/10> ;
      zoo:text "Quoniam occuparat alter ne primus foret," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/9/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/9> ;
      zoo:text "Finxere antiqui talem effigiem Temporis." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/16/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/16> ;
      zoo:text "Aptare mox ut posset corporibus suis," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/30/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/30> ;
      zoo:text "Et sibi nocivum concitant periculum." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/26/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/26> ;
      zoo:text "Illi inquit reddent quorum sunt laudis duae." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13/text/16>
      a       zoo:Paragraph ;
      zoo:identifier 16 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13> ;
      zoo:text "Paulum reclusis foribus miles prospicit" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/19>
      a       zoo:Paragraph ;
      zoo:identifier 19 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Fecunda novies artium peperit chorum," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13> ;
      zoo:text "A quo revelli nullo cum posset modo" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/9/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/9> ;
      zoo:text "Pueriliter ludentes forte inspexerunt." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/10/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/10> ;
      zoo:text "Vide ne querela maior accrescat domus." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/2/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/2> ;
      zoo:text "Quas, ipsum ignorans, legerat Demetrius" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21/text/16>
      a       zoo:Paragraph ;
      zoo:identifier 16 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21> ;
      zoo:text "Auxilio locus est: olim senio debilem" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/27/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/27> ;
      zoo:text "Plenam lagonam posuit: huic rostrum inserens" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/30/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/30> ;
      zoo:text "Officium et quaerit, cur sic mentiri velit." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/23/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/23> ;
      zoo:text "Hoc in se dictum debent illi agnoscere," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19/text/33>
      a       zoo:Paragraph ;
      zoo:identifier 33 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19> ;
      zoo:text "Illi autem qui miserunt vos tam futtiles" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/10/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/10> ;
      zoo:text "Servumque collocarunt aeterna in basi," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/18/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/18> ;
      zoo:text "Servus profugiens dominum naturae asperae," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13> ;
      zoo:text "Quae forte dominae tunc assistebat suae" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/16/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/16> ;
      zoo:text "Qui simul offendit ad fortunam frangitur," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/26/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/26> ;
      zoo:text "Verum ut ne irate te dimissum sentiant," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/1/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/1> ;
      zoo:text "Quam corrigatur error ut mortalium" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/1/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/1> ;
      zoo:text "Sed certa ratio causam scribendi dedit." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/15/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/15> ;
      zoo:text "Concurrit populus. Ille se torquet diu" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13> ;
      zoo:text "Amisit et sarcophago corpus condidit;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/7/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/7> ;
      zoo:text "Aesopo quidam scripta recitarat mala," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/9/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/9> ;
      zoo:text "Hi, speculum in cathedra matris ut positum fuit," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/10/text/15>
      a       zoo:Paragraph ;
      zoo:identifier 15 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/10> ;
      zoo:text "Atrocitati mansuetudo est remedium." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19/text/35>
      a       zoo:Paragraph ;
      zoo:identifier 35 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19> ;
      zoo:text "Ita nunc legatos exspectant et posteri" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21/text/15>
      a       zoo:Paragraph ;
      zoo:identifier 15 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21> ;
      zoo:text "Languentis aevi dum sunt aliquae reliquiae," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/27/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/27> ;
      zoo:text "Satiatur ipsa et torquet convivam fame." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/30/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/30> ;
      zoo:text "Salve inquit frater. Ille indignans repudiat" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/1/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/1> ;
      zoo:text "Colorque proprius? Ergo non levitas mihi," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19/text/34>
      a       zoo:Paragraph ;
      zoo:identifier 34 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19> ;
      zoo:text "Numquam carebunt hominis contumelia." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/9/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/9> ;
      zoo:text "Incolume abstuleris et mercedem postules." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/16/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/16> ;
      zoo:text "Naturae partis veste quas celat pudor," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/10/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/10> ;
      zoo:text "Patere honoris scirent ut cuncti viam" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13> ;
      zoo:text "Dormitum eunti; namque lucubraverat" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/26/text/15>
      a       zoo:Paragraph ;
      zoo:identifier 15 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/26> ;
      zoo:text "Ad cenam mihi promitte; cognatos volo" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/1/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/1> ;
      zoo:text "Nec aliud quicquam per fabellas quaeritur" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/15/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/15> ;
      zoo:text "Nec quaestionis positae causam intellegit." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/27/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/27> ;
      zoo:text "Gustare esuriens potuerit ciconia." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/53>
      a       zoo:Paragraph ;
      zoo:identifier 53 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Aeternam famam condere ingenio suo:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/30/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/30> ;
      zoo:text "Aper, cum vellet facere generosum impetum," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/23/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/23> ;
      zoo:text "Et meritum inane iactant imprudentibus." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/9/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/9> ;
      zoo:text "Ingrata es inquit ore quae nostro caput" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6/text/31>
      a       zoo:Paragraph ;
      zoo:identifier 31 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6> ;
      zoo:text "Quam graviter ferret, quod voluntatem suam" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/22/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/22> ;
      zoo:text "Defectus annis et desertus viribus" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/18/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/18> ;
      zoo:text "Quid tu confusus?—Dicam tibi clare, pater," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13> ;
      zoo:text "Aliquando sitiens unus de custodibus" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/9/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/9> ;
      zoo:text "Calvus, comosa fronte, nudo corpore," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/30/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/30> ;
      zoo:text "Quasi non abunde sit mihi in prato cibus," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8> ;
      zoo:text "Ad sanitatem dum venit curatio." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/20/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/20> ;
      zoo:text "Respondit: Ne quis discat prodesse improbis." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/27/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/27> ;
      zoo:text "Quae vulpem cum revocasset, intrito cibo" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/11/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/11> ;
      zoo:text "Hoc cur, Philete, scripserim, pulchre vides." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/54>
      a       zoo:Paragraph ;
      zoo:identifier 54 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Ego, litteratae qui sum propior Graeciae," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/30/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/30> ;
      zoo:text "Tibi me esse, certe simile est hoc rostro tuo." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/23/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/23> ;
      zoo:text "Quorum privata servit utilitas sibi," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/9/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/9> ;
      zoo:text "Pro quo cum pactum flagitaret praemium:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/30/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/30> ;
      zoo:text "Asinus demisso pene: Similem si negas" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8> ;
      zoo:text "Domum refertur. Aliquot menses transeunt," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/6/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/6> ;
      zoo:text "Est ardalionum quaedam Romae natio," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/18/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/18> ;
      zoo:text "Aesopo occurrit notus e vicinia." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/30/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/30> ;
      zoo:text "Salve inquit illa cur me fugisti, obsecro?" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6/text/30>
      a       zoo:Paragraph ;
      zoo:identifier 30 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6> ;
      zoo:text "O si maneret condito sensus patri," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13> ;
      zoo:text "Aquam rogavit media nocte ancillulam," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/9/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/9> ;
      zoo:text "(Quem si occuparis, teneas; elapsum semel" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/22/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/22> ;
      zoo:text "Ignavis etiam iocus est in casu gravi." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/4/text/17>
      a       zoo:Paragraph ;
      zoo:identifier 17 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/4> ;
      zoo:text "Uxores inquit da tuis pastoribus." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/20/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/20> ;
      zoo:text "Hanc alia cum rogaret causam facinoris," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/27/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/27> ;
      zoo:text "Prior invitasse et illi in patina liquidam" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/55>
      a       zoo:Paragraph ;
      zoo:identifier 55 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Cur somno inerti deseram patriae decus?" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/9/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/9> ;
      zoo:text "Praecepto monitus saepe te considera." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/30/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/30> ;
      zoo:text "Nihil est quod metuas: ego te multum diligo" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6/text/33>
      a       zoo:Paragraph ;
      zoo:identifier 33 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6> ;
      zoo:text "Rogatus deinde solvit errorem omnium:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/9/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/9> ;
      zoo:text "Non ipse possit Iuppiter reprehendere)," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/16/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/16> ;
      zoo:text "Ad cenam est invitatus subito a Libero." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8> ;
      zoo:text "Inter manus sublatus et multum gemens" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/6/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/6> ;
      zoo:text "Trepide concursans, occupata in otio," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/4/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/4> ;
      zoo:text "Calvi momordit musca nudatum caput;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/4/text/16>
      a       zoo:Paragraph ;
      zoo:identifier 16 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/4> ;
      zoo:text "Si procurare vis ostentum, rustice," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/22/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/22> ;
      zoo:text "Quicumque amisit dignitatem pristinam," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/18/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/18> ;
      zoo:text "Tuto querela quia apud te deponitur." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/20/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/20> ;
      zoo:text "Namque ut refecta est necuit hominem protinus." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/27/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/27> ;
      zoo:text "Posuisse sorbitionem, quam nullo modo" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/56>
      a       zoo:Paragraph ;
      zoo:identifier 56 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Threissa cum gens numeret auctores suos," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/30/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/30> ;
      zoo:text "Grilli, scarabaei, locustarum copia:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/16/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/16> ;
      zoo:text "Ubi irrigatus multo venas nectare," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6/text/32>
      a       zoo:Paragraph ;
      zoo:identifier 32 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6> ;
      zoo:text "Interpretari non potuissent Attici!" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/18/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/18> ;
      zoo:text "Hoc namque es dignus appellari nomine," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13> ;
      zoo:text "Monumentum iuxta mulier quo se incluserat." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/9/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/9> ;
      zoo:text "Occasionem rerum significat brevem." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/6/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/6> ;
      zoo:text "Gratis anhelans, multa agendo nihil agens," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/57>
      a       zoo:Paragraph ;
      zoo:identifier 57 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Linoque Apollo sit parens, Musa Orpheo," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/4/text/15>
      a       zoo:Paragraph ;
      zoo:identifier 15 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/4> ;
      zoo:text "Natura numquam verba cui potuit dare:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/1/text/20>
      a       zoo:Paragraph ;
      zoo:identifier 20 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/1> ;
      zoo:text "Illitteratum plausum nec desidero." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/20/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/20> ;
      zoo:text "Sinuque fovit contra se ipse misericors:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/27/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/27> ;
      zoo:text "Multandum simili iure fabella admonet." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/6/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/6> ;
      zoo:text "Sibi molesta et aliis odiosissima." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/5/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/5> ;
      zoo:text "Paucis temeritas est bono, multis malo." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/30/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/30> ;
      zoo:text "Avis quam dicunt terraneolam rustici," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/2/text/16>
      a       zoo:Paragraph ;
      zoo:identifier 16 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/2> ;
      zoo:text "Audet venire? Responderunt proximi:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/22/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/22> ;
      zoo:text "Infestis taurus mox confodit cornibus" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6/text/35>
      a       zoo:Paragraph ;
      zoo:identifier 35 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6> ;
      zoo:text "Et vina vetera date lanificae rusticae;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/4/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/4> ;
      zoo:text "Usu peritus hariolo vel doctior" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/1/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/1> ;
      zoo:text "Sed si libuerit aliquid interponere," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/4/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/4> ;
      zoo:text "Aesopus ibi stans, naris emunctae senex," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/18/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/18> ;
      zoo:text "Subinde ad villam mittor sine viatico." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/58>
      a       zoo:Paragraph ;
      zoo:identifier 58 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Qui saxa cantu movit et domuit feras" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/4/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/4> ;
      zoo:text "Tunc illa irridens: Punctum volucris parvulae" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/7/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/7> ;
      zoo:text "Hac derideri fabula merito potest," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/20/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/20> ;
      zoo:text "Gelu rigentem quidam colubram sustulit" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8/text/16>
      a       zoo:Paragraph ;
      zoo:identifier 16 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8> ;
      zoo:text "Erat facturus ludos quidam nobilis," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Legesne, quaeso, potius viles nenias," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/27/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/27> ;
      zoo:text "Vulpes ad cenam dicitur ciconiam" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/6/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/6> ;
      zoo:text "Hanc emendare, si tamen possum, volo" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/2/text/15>
      a       zoo:Paragraph ;
      zoo:identifier 15 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/2> ;
      zoo:text "Quisnam cinaedus ille in conspectum meum" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6/text/34>
      a       zoo:Paragraph ;
      zoo:identifier 34 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6> ;
      zoo:text "Domum et ornamenta cum venustis hortulis" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/22/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/22> ;
      zoo:text "Et vindicavit ictu veterem iniuriam." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/1/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/1> ;
      zoo:text "Equidem omni cura morem servabo senis;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8/text/15>
      a       zoo:Paragraph ;
      zoo:identifier 15 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8> ;
      zoo:text "Solebat excitari saltantis vigor." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/4/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/4> ;
      zoo:text "Quam opprimere captans alapam sibi duxit gravem." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/18/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/18> ;
      zoo:text "Plagae supersunt, desunt mihi cibaria;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/59>
      a       zoo:Paragraph ;
      zoo:identifier 59 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Hebrique tenuit impetus dulci mora." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/20/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/20> ;
      zoo:text "Qui fert malis auxilium post tempus dolet." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/7/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/7> ;
      zoo:text "Qui sine virtute vanas exercet minas." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/4/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/4> ;
      zoo:text "Hominisque curam cura maiore aggravant." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/30/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/30> ;
      zoo:text "Quin sequere: salutem tibi non committo meam." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/2/text/18>
      a       zoo:Paragraph ;
      zoo:identifier 18 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/2> ;
      zoo:text "Homo inquit fieri non potest formosior." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/4/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/4> ;
      zoo:text "Iniuriae qui addideris contumeliam?" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Impendas curam quam rei domesticae," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/6/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/6> ;
      zoo:text "Vera fabella: pretium est operae attendere." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/30/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/30> ;
      zoo:text "Qua visa, pennis altius se sustulit." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/22/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/22> ;
      zoo:text "Aper fulmineis venit ad eum dentibus" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8> ;
      zoo:text "Desiderari coepit, cuius flatibus" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/4/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/4> ;
      zoo:text "Quid multa? Variis dissident sententiis" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6/text/37>
      a       zoo:Paragraph ;
      zoo:identifier 37 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6> ;
      zoo:text "Illi assignate vitam quae luxu trahit;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/18/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/18> ;
      zoo:text "Sive est vocatus, iaceo ad lucem in semita." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/27/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/27> ;
      zoo:text "Nulli nocendum: si quis vero laeserit," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Reddas amicis tempora, uxori vaces," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/6/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/6> ;
      zoo:text "Caesar Tiberius cum petens Neapolim" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/30/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/30> ;
      zoo:text "In terra nidum quia componit scilicet," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/2/text/17>
      a       zoo:Paragraph ;
      zoo:identifier 17 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/2> ;
      zoo:text "Hic est Menander scriptor. Mutatus statim:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6/text/36>
      a       zoo:Paragraph ;
      zoo:identifier 36 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6> ;
      zoo:text "Vestem, uniones, pedisequos et cetera" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/30/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/30> ;
      zoo:text "Forte occucurrit improbae vulpeculae;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/22/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/22> ;
      zoo:text "Leo cum iaceret spiritum extremum trahens," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Animum relaxes, otium des corpori," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/18/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/18> ;
      zoo:text "Domi si cenat, totis persto noctibus," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/9/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/9> ;
      zoo:text "Cursu volucri, pendens in novacula," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8> ;
      zoo:text "Ut spectatorum mos est et lepidum genus," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/4/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/4> ;
      zoo:text "Voluisti morte ulcisci; quid facies tibi," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/4/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/4> ;
      zoo:text "Sed expiari posse maiore hostia." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/1/text/16>
      a       zoo:Paragraph ;
      zoo:identifier 16 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/1> ;
      zoo:text "Imitari dum non possit, obtrectet licet." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/28/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/28> ;
      zoo:text "Abripere morsu fertur testiculos sibi," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/21/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/21> ;
      zoo:text "Stultum consilium non modo effectu caret," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/4/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/4> ;
      zoo:text "Agnos humano capite. Monstro territus" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3> ;
      zoo:text "Ranae vagantes liberis paludibus" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/32/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/32> ;
      zoo:text "Et exercere imperium saevis unguibus." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8/text/27>
      a       zoo:Paragraph ;
      zoo:identifier 27 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8> ;
      zoo:text "Regnare nolo, liber ut non sim mihi." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/7/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/7> ;
      zoo:text "Vide ne dolone collum compungam tibi." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Non ergo causa est manibus id tangi tuis," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6/text/15>
      a       zoo:Paragraph ;
      zoo:identifier 15 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6> ;
      zoo:text "Quo pacto non possideant, quod fuerit datum," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/28/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/28> ;
      zoo:text "Quia propter illos sentiat sese peti." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/1/text/15>
      a       zoo:Paragraph ;
      zoo:identifier 15 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/1> ;
      zoo:text "Hunc obtrectare si volet malignitas," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/17/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/17> ;
      zoo:text "Nullum esse auxilium et verba contemni sua," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/4/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/4> ;
      zoo:text "Habenti cuidam pecora pepererunt oves" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6> ;
      zoo:text "Iuris peritos consulit; nemo expedit" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/16/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/16> ;
      zoo:text "Ita nunc libido pravo fruitur gaudio." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/32/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/32> ;
      zoo:text "Tunc de reliquis una: Merito plectimur." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/25/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/25> ;
      zoo:text "Sed non impune, quia cui debes non places." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Quod occupatis auribus non convenit." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/7/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/7> ;
      zoo:text "Quam tarda es! inquit non vis citius progredi?" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/1/text/18>
      a       zoo:Paragraph ;
      zoo:identifier 18 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/1> ;
      zoo:text "Vestras in chartas verba transfertis mea," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/28/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/28> ;
      zoo:text "Divina quod ratione fieri non negem;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/39>
      a       zoo:Paragraph ;
      zoo:identifier 39 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "A Divo Augusto tunc petierunt iudices," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/17/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/17> ;
      zoo:text "Accensa magis est. Noctua ut vidit sibi" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/21/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/21> ;
      zoo:text "Corium depressum in fluvio viderunt canes." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3> ;
      zoo:text "Pater deorum risit atque illis dedit" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/5/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/5> ;
      zoo:text "Numeremus agedum qui deprensi perierunt:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/4/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/4> ;
      zoo:text "Notescet quae nunc primum fabella mea." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Fortasse dices: Aliquae venient feriae," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/9/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/9> ;
      zoo:text "Plane, immo nimium est, sed permittes scalpere?" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3> ;
      zoo:text "Qui dissolutos mores vi compesceret." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/32/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/32> ;
      zoo:text "Illae credentes tradunt sese miluo;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6/text/17>
      a       zoo:Paragraph ;
      zoo:identifier 17 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6> ;
      zoo:text "Quanam ratione conferant pecuniam." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/7/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/7> ;
      zoo:text "Sed istum timeo sella qui prima sedens" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/1/text/17>
      a       zoo:Paragraph ;
      zoo:identifier 17 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/1> ;
      zoo:text "Mihi parta laus est quod tu, quod similes tui" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/17/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/17> ;
      zoo:text "Clamare occepit. Rursus admota prece" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/28/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/28> ;
      zoo:text "Venator namque simul invenit remedium," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/10/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/10> ;
      zoo:text "Qui doctiorem emendat sibi dici putet." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/21/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/21> ;
      zoo:text "Sed ad perniciem quoque mortalis devocat." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/5/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/5> ;
      zoo:text "Maiorem turbam punitorum reperies." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/4/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/4> ;
      zoo:text "Vulgo esse fertur, causa sed non dicitur," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Quae me soluto pectore ad studium vocent." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/9/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/9> ;
      zoo:text "Ne scalpas inquit satis est modius tritici?" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3> ;
      zoo:text "Clamore magno regem petiere a Iove," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/32/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/32> ;
      zoo:text "Qui regnum adeptus coepit vesci singulas" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6/text/16>
      a       zoo:Paragraph ;
      zoo:identifier 16 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6> ;
      zoo:text "Fructumve capiant; deinde quae tulerint nihil," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/7/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/7> ;
      zoo:text "Respondit illa: Verbis non moveor tuis;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/7/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/7> ;
      zoo:text "Et ora frenis continet spumantibus." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/1/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/1> ;
      zoo:text "Quia paucas ille ostendit, ego plures fero," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/37>
      a       zoo:Paragraph ;
      zoo:identifier 37 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Quod bona possideat. Stant patroni fortiter" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3/text/15>
      a       zoo:Paragraph ;
      zoo:identifier 15 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3> ;
      zoo:text "Motu sonoque terruit pavidum genus." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/17/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/17> ;
      zoo:text "Rogata est ut taceret. Multo validius" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/21/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/21> ;
      zoo:text "Aquam coepere ebibere: sed rupti prius" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/22/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/22> ;
      zoo:text "Sed res clamabit ipsa quid deliqueris." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/4/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/4> ;
      zoo:text "Ille autem affirmat coniugem esse adulteram" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/28/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/28> ;
      zoo:text "Canes effugere cum iam non possit fiber," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/16/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/16> ;
      zoo:text "Tum semisomno corde et errore ebrio" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/6/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/6> ;
      zoo:text "Pietatem colite; vota superis reddite;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Vaces oportet, Eutyche, a negotiis," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/1/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/1> ;
      zoo:text "(Quas Aesopias, non Aesopi, nomino," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6/text/19>
      a       zoo:Paragraph ;
      zoo:identifier 19 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6> ;
      zoo:text "Nec testamenti potuit sensus colligi," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/26/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/26> ;
      zoo:text "Exigua cum frenaret materia impetum," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/25/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/25> ;
      zoo:text "Uxorem domini qui corrupisset sui," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/38>
      a       zoo:Paragraph ;
      zoo:identifier 38 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Causam tuentes innocentis feminae." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/7/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/7> ;
      zoo:text "Iugum flagello temperat lento meum" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/50>
      a       zoo:Paragraph ;
      zoo:identifier 50 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Verum ipsam vitam et mores hominum ostendere." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/20/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/20> ;
      zoo:text "Aesopus domino solus cum esset familia," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/4/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/4> ;
      zoo:text "Et avertendum victima periculum." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/22/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/22> ;
      zoo:text "Quamvis indigne laesa, reticebo tamen;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3> ;
      zoo:text "Parvum tigillum, missum quod subito vadi" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/17/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/17> ;
      zoo:text "Cavoque ramo capere somnum interdiu." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/21/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/21> ;
      zoo:text "Id ut comesse extractum possent facilius," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/28/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/28> ;
      zoo:text "(Graeci loquaces quem dixerunt castorem" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/16/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/16> ;
      zoo:text "Sero domum est reversus titubanti pede." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/6/text/9>
