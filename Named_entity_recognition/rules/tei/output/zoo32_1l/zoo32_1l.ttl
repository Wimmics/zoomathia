<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l>
      a       zoo:Oeuvre ;
      zoo:author "PHAEDRUS" ;
      zoo:date "1876" ;
      zoo:editor "L. Mueller" ;
      zoo:file "./zoo/zoo32/1l.xml" ;
      zoo:identifier "fabulae_aesopiae" ;
      zoo:title "Fabulae Aesopiae" .


<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/17>
      a       zoo:Paragraph ;
      zoo:identifier 17 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Stuproque turpi pollui famam domus." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/5/text/16>
      a       zoo:Paragraph ;
      zoo:identifier 16 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/5> ;
      zoo:text "Hunc quoque timore postquam complevit locum," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9> ;
      zoo:text "Infelix, ultro qui ad necem cucurreris" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24/text/26>
      a       zoo:Paragraph ;
      zoo:identifier 26 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24> ;
      zoo:text "Illius interesse, ne faciat moram." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/15/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/15> ;
      zoo:text "Habitu esse similes qui sint virtute impares." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/16/text/16>
      a       zoo:Paragraph ;
      zoo:identifier 16 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/16> ;
      zoo:text "Cur hac sit potior quae iacentis miserita est" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/6/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/6> ;
      zoo:text "In Misenensem villam venisset suam," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/2/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/2> ;
      zoo:text "Qui natus est infelix, non vitam modo" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14> ;
      zoo:text "Ut nuptiarum dictus advenit dies," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/18/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/18> ;
      zoo:text "Respondit: Ne quis discat prodesse improbis." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/6/text/22>
      a       zoo:Paragraph ;
      zoo:identifier 22 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/6> ;
      zoo:text "Donationis alacer certae gaudio." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/32/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/32> ;
      zoo:text "Et celeritate pennae vitassent necem," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/11/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/11> ;
      zoo:text "Valuisset eius. Ille: Ne istud dixeris;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/4/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/4> ;
      zoo:text "Et insitivos significari liberos," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6/text/39>
      a       zoo:Paragraph ;
      zoo:identifier 39 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6> ;
      zoo:text "Donate moechae. Nulla poterit perpeti," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/17/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/17> ;
      zoo:text "Premente partu scrofa cum gemeret iacens," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/3/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/3> ;
      zoo:text "Calvus repente factus est; nam funditus" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/5/text/15>
      a       zoo:Paragraph ;
      zoo:identifier 15 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/5> ;
      zoo:text "Aquila est parata rapere porcellos tibi." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/12/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/12> ;
      zoo:text "Sed ne ignis noster facinori praeluceat," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/11/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/11> ;
      zoo:text "Quod inquit ergo, stulte, meruisti decus," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/18>
      a       zoo:Paragraph ;
      zoo:identifier 18 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Incensus ille falso uxoris crimine" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24/text/27>
      a       zoo:Paragraph ;
      zoo:identifier 27 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24> ;
      zoo:text "Homo perturbatus excitat Simonidem." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14> ;
      zoo:text "Vicit locuples genus et formam pauperis." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/6/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/6> ;
      zoo:text "Quae monte summo posita Luculli manu" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/16/text/15>
      a       zoo:Paragraph ;
      zoo:identifier 15 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/16> ;
      zoo:text "Cuius potestas nulla in gignendo fuit," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/3/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/3> ;
      zoo:text "Qui se putaret fingi cura mulierum," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/16/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/16> ;
      zoo:text "Ut exspectarem lanium in horas singulas!" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/5/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/5> ;
      zoo:text "Equus sedare solitus quo fuerat sitim," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/6/text/23>
      a       zoo:Paragraph ;
      zoo:identifier 23 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/6> ;
      zoo:text "Tum sic iocata est tanta maiestas ducis:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/32/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/32> ;
      zoo:text "Columbae saepe cum fugissent miluum" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9> ;
      zoo:text "Hominumque tecto spiritum commiseris?" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8/text/19>
      a       zoo:Paragraph ;
      zoo:identifier 19 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8> ;
      zoo:text "Ipso ludorum ostenderet sese die." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/11/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/11> ;
      zoo:text "Multo fuere vires maiores meae." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6/text/38>
      a       zoo:Paragraph ;
      zoo:identifier 38 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6> ;
      zoo:text "Agros, buvile et pecora cum pastoribus" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23/text/19>
      a       zoo:Paragraph ;
      zoo:identifier 19 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23> ;
      zoo:text "Aestate me lacessis; cum bruma est siles." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/12/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/12> ;
      zoo:text "Olim cum ascriptus venerit poenae dies." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/2/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/2> ;
      zoo:text "Nec plus conemur quam sinit mortalitas." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/5/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/5> ;
      zoo:text "Nam, simul exieris pastum cum tenero grege," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9> ;
      zoo:text "Et opportuno se bovili condidit." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24/text/28>
      a       zoo:Paragraph ;
      zoo:identifier 28 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24> ;
      zoo:text "Unum promorat vix pedem triclinio," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8/text/20>
      a       zoo:Paragraph ;
      zoo:identifier 20 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8> ;
      zoo:text "Et voce molli: Licet? Enimvero eici" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/15>
      a       zoo:Paragraph ;
      zoo:identifier 15 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Adiecit id, quod sentiebat maxime" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14> ;
      zoo:text "Maerens propinquos contulit se in hortulos," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/16/text/18>
      a       zoo:Paragraph ;
      zoo:identifier 18 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/16> ;
      zoo:text "Facit parentes bonitas, non necessitas." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/2/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/2> ;
      zoo:text "Persequitur illum dura fati miseria." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/18/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/18> ;
      zoo:text "Namque ut refecta est necuit hominem protinus." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/5/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/5> ;
      zoo:text "Dum sese aper volutat turbavit vadum." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/6/text/20>
      a       zoo:Paragraph ;
      zoo:identifier 20 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/6> ;
      zoo:text "Id ut putavit esse nescio quid boni:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8/text/18>
      a       zoo:Paragraph ;
      zoo:identifier 18 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8> ;
      zoo:text "Reducem tum adducit prece, pretio ut tantummodo" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/11/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/11> ;
      zoo:text "Iactantiorem cum vidisset Phryx sophus," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/2/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/2> ;
      zoo:text "Fatalis annos decurramus temporis," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/32/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/32> ;
      zoo:text "Et genus inerme tali decepit dolo:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/16>
      a       zoo:Paragraph ;
      zoo:identifier 16 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Doliturum amanti, ventitare adulterum" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9> ;
      zoo:text "Hic bos latenti: Quidnam voluisti tibi," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8/text/21>
      a       zoo:Paragraph ;
      zoo:identifier 21 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8> ;
      zoo:text "Virum ut in re atroci Magnus stomachans imperat." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24/text/29>
      a       zoo:Paragraph ;
      zoo:identifier 29 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24> ;
      zoo:text "Ruina camerae subito oppressit ceteros;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/5/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/5> ;
      zoo:text "Magno inquit in periclo sunt nati tui;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14> ;
      zoo:text "Amans dolorem quia non poterat perpeti," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/16/text/17>
      a       zoo:Paragraph ;
      zoo:identifier 17 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/16> ;
      zoo:text "Dulcemque sponte praestat benevolentiam?" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/18/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/18> ;
      zoo:text "Hanc alia cum rogaret causam facinoris," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/2/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/2> ;
      zoo:text "Tristem decurrit, verum post obitum quoque" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/32/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/32> ;
      zoo:text "Consilium raptor vertit ad fallaciam" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/2/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/2> ;
      zoo:text "Ergo contenti munere invicti Iovis" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/5/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/5> ;
      zoo:text "Hinc orta lis est. Sonipes iratus fero" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/6/text/21>
      a       zoo:Paragraph ;
      zoo:identifier 21 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/6> ;
      zoo:text "Heus! inquit dominus. Ille enimvero assilit," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8/text/17>
      a       zoo:Paragraph ;
      zoo:identifier 17 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8> ;
      zoo:text "Et incipiebat a se Princeps ingredi:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/11/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/11> ;
      zoo:text "Interrogavit an plus adversarius" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/11/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/11> ;
      zoo:text "Superasse, melior qui fuisset viribus." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Qui cum de puero multa mentitus foret" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9> ;
      zoo:text "Ut venatorum effugeret instantem necem," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8/text/22>
      a       zoo:Paragraph ;
      zoo:identifier 22 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8> ;
      zoo:text "Tum quidam senior ex amicis principis:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/9/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/9> ;
      zoo:text "Amplexus ille utrumque et carpens oscula" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14> ;
      zoo:text "Erat acceptura virginem e matris sinu," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/8/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/8> ;
      zoo:text "Et hoc iocorum legere fastidis genus," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/18/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/18> ;
      zoo:text "Gelu rigentem quidam colubram sustulit" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/20/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/20> ;
      zoo:text "Intempestive qui occupato alluserit." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23/text/16>
      a       zoo:Paragraph ;
      zoo:identifier 16 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23> ;
      zoo:text "Nihil laboras? ideo, cum opus est, nil habes." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9> ;
      zoo:text "Caeco timore proximam villam petit" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/9/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/9> ;
      zoo:text "Dulcemque in ambos caritatem partiens:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Et plura de flagitiis castae mulieris," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8/text/23>
      a       zoo:Paragraph ;
      zoo:identifier 23 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8> ;
      zoo:text "Hunc ego committi satius fortunae arbitror," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14> ;
      zoo:text "Quos ultra paulo villa splendida divitis" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/16/text/19>
      a       zoo:Paragraph ;
      zoo:identifier 19 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/16> ;
      zoo:text "His demonstrare voluit auctor versibus" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/8/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/8> ;
      zoo:text "Parva libellum sustine patientia," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/5/text/19>
      a       zoo:Paragraph ;
      zoo:identifier 19 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/5> ;
      zoo:text "Ubi esca se replevit et prolem suam," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/18/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/18> ;
      zoo:text "Sinuque fovit contra se ipse misericors:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/30/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/30> ;
      zoo:text "Propter quietos mores et vitam probam." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23/text/15>
      a       zoo:Paragraph ;
      zoo:identifier 15 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23> ;
      zoo:text "Super etiam iactas tegere quod debet pudor." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/11/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/11> ;
      zoo:text "Minus valentem si vicisti fortior?" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/3/text/15>
      a       zoo:Paragraph ;
      zoo:identifier 15 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/3> ;
      zoo:text "Qui re secunda fortis est, dubia fugax." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/59>
      a       zoo:Paragraph ;
      zoo:identifier 59 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Haec exsecutus sum propterea pluribus" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/9/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/9> ;
      zoo:text "Magnaque invidia criminatur filium," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8/text/24>
      a       zoo:Paragraph ;
      zoo:identifier 24 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8> ;
      zoo:text "In quo iactura levis est, quam fortem virum," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Seductus in secretum a liberto est suo," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/5/text/18>
      a       zoo:Paragraph ;
      zoo:identifier 18 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/5> ;
      zoo:text "Inde evagata noctu suspenso pede," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/20/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/20> ;
      zoo:text "Par inquit esse potueris, cedam loco." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/20/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/20> ;
      zoo:text "Hoc si molestus ille ad animum rettulit," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/32/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/32> ;
      zoo:text "Auxilia dum requirit, exitium invenit." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23/text/18>
      a       zoo:Paragraph ;
      zoo:identifier 18 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23> ;
      zoo:text "Te circa murum pasci video stercore." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/11/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/11> ;
      zoo:text "Ferendus esses, forte si te diceres" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/5/text/17>
      a       zoo:Paragraph ;
      zoo:identifier 17 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/5> ;
      zoo:text "Dolosa tuto condidit sese cavo." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Sperante heredem suffici se proximum." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9> ;
      zoo:text "Cervus nemorosis excitatus latibulis," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/3/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/3> ;
      zoo:text "Illi assignari debet haec narratio" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8/text/25>
      a       zoo:Paragraph ;
      zoo:identifier 25 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8> ;
      zoo:text "Qui casu victus temeritatis te arguat." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14> ;
      zoo:text "Parum ampla in urbe visa quod fuerat domus." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/9/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/9> ;
      zoo:text "Vir natus quod rem feminarum tetigerit." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/8/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/8> ;
      zoo:text "Tu qui, nasute, scripta destringis mea" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/18/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/18> ;
      zoo:text "Qui fert malis auxilium post tempus dolet." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/32/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/32> ;
      zoo:text "Qui se committit homini tutandum improbo," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/20/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/20> ;
      zoo:text "Sensit profecto se hominem non visum seni," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14> ;
      zoo:text "Pompa explicatur, turba concurrit frequens," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23/text/17>
      a       zoo:Paragraph ;
      zoo:identifier 17 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23> ;
      zoo:text "Ego granum in hiemem cum studiose congero," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21/text/22>
      a       zoo:Paragraph ;
      zoo:identifier 22 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21> ;
      zoo:text "Saepe impetravit veniam confessus reus:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/57>
      a       zoo:Paragraph ;
      zoo:identifier 57 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Aut gratiae subscribit aut odio suo." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/13/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/13> ;
      zoo:text "Et in liquore vidit effigiem suam." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/8/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/8> ;
      zoo:text "Utinam nec umquam Pelii nemoris iugo" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8> ;
      zoo:text "Dum pegma rapitur, concidit casu gravi" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/10/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/10> ;
      zoo:text "Plures habebit, quos opponat Graeciae." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8/text/26>
      a       zoo:Paragraph ;
      zoo:identifier 26 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8> ;
      zoo:text "Assensit Magnus et permisit militi" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/10/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/10> ;
      zoo:text "Quod si labori faverit Latium meo," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/1/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/1> ;
      zoo:text "Contegere honeste posset ut nudas nates;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/2/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/2> ;
      zoo:text "Quidnam fecissent, hoc locuti sunt modo:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/3/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/3> ;
      zoo:text "A feminis utcumque spoliari viros," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/12/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/12> ;
      zoo:text "Lucernam fur accendit ex ara Iovis" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/19/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/19> ;
      zoo:text "Nemo libenter recolit qui laesit locum." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23> ;
      zoo:text "Sed illi qui invitatur, non qui invisus est." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21/text/21>
      a       zoo:Paragraph ;
      zoo:identifier 21 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21> ;
      zoo:text "Proclivis ultro cum sit misericordia." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/13/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/13> ;
      zoo:text "Ad fontem cervus, cum bibisset, restitit" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/58>
      a       zoo:Paragraph ;
      zoo:identifier 58 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Erit ille notus quem per te cognoveris." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/8/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/8> ;
      zoo:text "Pinus bipenni concidisset Thessala," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Togamque puram iam pararet filio," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8/text/27>
      a       zoo:Paragraph ;
      zoo:identifier 27 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8> ;
      zoo:text "Prodire contra; qui mirante exercitu," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/1/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/1> ;
      zoo:text "Cui sic maligna: Longior fiat licet," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8> ;
      zoo:text "Is forte ludis (non satis memini quibus)" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23> ;
      zoo:text "Est gloriosus sane convictus deum," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/2/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/2> ;
      zoo:text "Rogati mox a quodam, delicio suo" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/19/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/19> ;
      zoo:text "Instante partu mulier actis mensibus" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3> ;
      zoo:text "Athenae cum florerent aequis legibus," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/8/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/8> ;
      zoo:text "Patefecit in perniciem Graium et barbarum!" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/19/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/19> ;
      zoo:text "Humi iacebat flebilis gemitus ciens." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/13/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/13> ;
      zoo:text "Saepe inveniri haec asserit narratio." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/55>
      a       zoo:Paragraph ;
      zoo:identifier 55 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Opinione alterius ne quid ponderent:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/8/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/8> ;
      zoo:text "Severitatem frontis dum placo tuae" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21/text/24>
      a       zoo:Paragraph ;
      zoo:identifier 24 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21> ;
      zoo:text "Tuae sunt partes; fuerunt aliorum prius," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8/text/28>
      a       zoo:Paragraph ;
      zoo:identifier 28 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8> ;
      zoo:text "Dicto celerius hostis abscidit caput" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/10/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/10> ;
      zoo:text "Ne solus esset studui; quod superfuit:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8> ;
      zoo:text "Duas cum dextras maluisset perdere." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/3/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/3> ;
      zoo:text "Aetatis mediae quendam mulier non rudis" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24> ;
      zoo:text "Quantum valerent inter homines litterae," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23> ;
      zoo:text "Reges commemoras et matronarum oscula?" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/12/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/12> ;
      zoo:text "Onustus qui sacrilegio cum discederet," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21/text/23>
      a       zoo:Paragraph ;
      zoo:identifier 23 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21> ;
      zoo:text "Quanto innocenti iustius debet dari?" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/8/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/8> ;
      zoo:text "Inhospitalis prima quae ponti sinus" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/56>
      a       zoo:Paragraph ;
      zoo:identifier 56 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Ambitio namque dissidens mortalium" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/13/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/13> ;
      zoo:text "Laudatis utiliora quae contempseris" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/19/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/19> ;
      zoo:text "Vir est hortatus, corpus lecto reciperet," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/8/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/8> ;
      zoo:text "Et in cothurnis prodit Aesopus novis." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8> ;
      zoo:text "Nec opinans, et sinistram fregit tibiam," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8/text/29>
      a       zoo:Paragraph ;
      zoo:identifier 29 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8> ;
      zoo:text "Victorque rediit. His tunc Pompeius super:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/10/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/10> ;
      zoo:text "Nec haec invidia, verum est aemulatio." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/1/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/1> ;
      zoo:text "Vulpem rogabat partem caudae simius," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/3/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/3> ;
      zoo:text "Ament, amentur, nempe exemplis discimus." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24> ;
      zoo:text "Dixi superius: quantus nunc illis honos" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23> ;
      zoo:text "Aras frequentas? nempe abigeris, quom venis." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/12/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/12> ;
      zoo:text "Ipsumque compilavit ad lumen suum." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14/text/21>
      a       zoo:Paragraph ;
      zoo:identifier 21 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14> ;
      zoo:text "Asellus notum proximum tectum subit" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/26/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/26> ;
      zoo:text "Nisi esse scirem carnis te cupidum meae." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/19/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/19> ;
      zoo:text "Onus naturae melius quo deponeret." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/13/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/13> ;
      zoo:text "Per campum fugere coepit et cursu levi" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/53>
      a       zoo:Paragraph ;
      zoo:identifier 53 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Et qui non peccant, impugnantur fraudibus." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/2/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/2> ;
      zoo:text "Quin etiam resides et sequentes otium," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/16/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/16> ;
      zoo:text "Age porro: parere si voluisset feminam," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/15/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/15> ;
      zoo:text "Puerorum in turba quidam ludentem Atticus" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/3/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/3> ;
      zoo:text "Animosque eiusdem pulchra iuvenis ceperat." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/2/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/2> ;
      zoo:text "Asinum solebant baiulantem sarcinas." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24> ;
      zoo:text "A superis sit tributus tradam memoriae." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/12/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/12> ;
      zoo:text "Malorum quamvis ista fuerint munera" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/32/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/32> ;
      zoo:text "Quam regem me creatis icto foedere," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3> ;
      zoo:text "Hic conspiratis factionum partibus" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14/text/20>
      a       zoo:Paragraph ;
      zoo:identifier 20 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14> ;
      zoo:text "Sibi quemque cogens petere praesidium fuga." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/19/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/19> ;
      zoo:text "Minime, inquit, illo posse confido loco" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/13/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/13> ;
      zoo:text "Venantum subito vocibus conterritus" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/54>
      a       zoo:Paragraph ;
      zoo:identifier 54 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Hoc admonere simplices etiam potest," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/2/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/2> ;
      zoo:text "Tacite gementes tristem fortunae vicem." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/15/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/15> ;
      zoo:text "Aesopum nucibus cum vidisset, restitit" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/2/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/2> ;
      zoo:text "Galli Cybebes circum in quaestus ducere" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/3/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/3> ;
      zoo:text "Tenebat annos celans elegantia," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24> ;
      zoo:text "Simonides idem ille de quo rettuli," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/16/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/16> ;
      zoo:text "Unde illa scivit niger an albus nascerer?" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/12/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/12> ;
      zoo:text "Repente vocem sancta misit Religio:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/32/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/32> ;
      zoo:text "Quare sollicitum potius aevum ducitis," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3> ;
      zoo:text "Arcem tyrannus occupat Pisistratus." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/19/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/19> ;
      zoo:text "Malum finiri, quo conceptum est initio." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21/text/20>
      a       zoo:Paragraph ;
      zoo:identifier 20 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21> ;
      zoo:text "Stultum admovere tibi preces existimo," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/2/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/2> ;
      zoo:text "In quis Menander, nobilis comoediis" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/13/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/13> ;
      zoo:text "Crurumque nimiam tenuitatem vituperat," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/1/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/1> ;
      zoo:text "Tamen illam citius per lutum et spinas traham," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14> ;
      zoo:text "Unam expetebant virginem iuvenes duo;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14/text/23>
      a       zoo:Paragraph ;
      zoo:identifier 23 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14> ;
      zoo:text "Procurrunt pueri, pulchram aspiciunt virginem" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/51>
      a       zoo:Paragraph ;
      zoo:identifier 51 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Nil spernat auris, nec tamen credat statim." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/3/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/3> ;
      zoo:text "Capillos homini legere coepere invicem." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/16/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/16> ;
      zoo:text "Beneficium sane magnum natali dedit," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/2/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/2> ;
      zoo:text "Detracta pelle sibi fecerunt tympana." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24> ;
      zoo:text "Victori laudem cuidam pyctae ut scriberet" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23> ;
      zoo:text "Quid horum simile tibi contingit, rustica?" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/8/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/8> ;
      zoo:text "Nec ad professae mortis audacem viam" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3> ;
      zoo:text "Procax libertas civitatem miscuit" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9> ;
      zoo:text "At ille supplex: Vos modo inquit parcite;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/6/text/24>
      a       zoo:Paragraph ;
      zoo:identifier 24 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/6> ;
      zoo:text "Non multum egisti et opera nequiquam perit:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/12/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/12> ;
      zoo:text "Tamen, sceleste, spiritu culpam lues," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14/text/22>
      a       zoo:Paragraph ;
      zoo:identifier 22 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14> ;
      zoo:text "Et voce magna sese venisse indicat." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/2/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/2> ;
      zoo:text "Ni defuisse noceat, repunt ultimi;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/52>
      a       zoo:Paragraph ;
      zoo:identifier 52 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Quandoquidem et illi peccant, quos minime putes," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/20/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/20> ;
      zoo:text "Hoc quoque consumpto flagitari validius" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/13/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/13> ;
      zoo:text "Ibi dum ramosa mirans laudat cornua" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/25/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/25> ;
      zoo:text "Inflare sese, rupto iacuit corpore." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/1/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/1> ;
      zoo:text "Quam parvam quamvis partem impertiar tibi." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/16/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/16> ;
      zoo:text "Quid profecisset, cum crearer masculus?" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/3/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/3> ;
      zoo:text "Ambae, videri dum volunt illi pares," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24> ;
      zoo:text "Certo conduxit pretio, secretum petit." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/20/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/20> ;
      zoo:text "Cubile coepit. Si mihi et turbae meae" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/2/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/2> ;
      zoo:text "Is cum labore et plagis esset mortuus," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/8/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/8> ;
      zoo:text "Fabricasset Argus opere Palladio ratem," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3> ;
      zoo:text "Frenumque solvit pristinum licentia." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/12/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/12> ;
      zoo:text "Mihique invisa, ut non offendar surripi," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/32/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/32> ;
      zoo:text "Qui vos ab omni tutas praestem iniuria?" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9> ;
      zoo:text "Occasione rursus erumpam data." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/6/text/25>
      a       zoo:Paragraph ;
      zoo:identifier 25 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/6> ;
      zoo:text "Multo maioris alapae mecum veneunt." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/5/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/5> ;
      zoo:text "Quidam immolasset verrem cum sancto Herculi," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/8/text/17>
      a       zoo:Paragraph ;
      zoo:identifier 17 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/8> ;
      zoo:text "Quid tibi videtur? Hoc quoque insulsum est ait" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/23/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/23> ;
      zoo:text "Quam devorare patula cum vellet gula," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14/text/25>
      a       zoo:Paragraph ;
      zoo:identifier 25 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14> ;
      zoo:text "Inter sodales ille paucos accubans" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19/text/24>
      a       zoo:Paragraph ;
      zoo:identifier 24 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19> ;
      zoo:text "Caelum fatigas sordido periurio," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/26/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/26> ;
      zoo:text "A corcodilis ne rapiantur, traditum est." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/12/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/12> ;
      zoo:text "Id demum est homini turpe, quod meruit pati." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/11/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/11> ;
      zoo:text "Canis cum domino semper fecisset satis," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/23/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/23> ;
      zoo:text "Gratum esset et dedissem veniam supplici." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/18/text/19>
      a       zoo:Paragraph ;
      zoo:identifier 19 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/18> ;
      zoo:text "Tali consilio est a fuga deterritus." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19/text/23>
      a       zoo:Paragraph ;
      zoo:identifier 23 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19> ;
      zoo:text "Qui dum quadrantes aggeras patrimonio" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/26>
      a       zoo:Paragraph ;
      zoo:identifier 26 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Docto labori dulce praeponens lucrum?" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/20/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/20> ;
      zoo:text "In terram abripiens excutit praedam maris" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/20/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/20> ;
      zoo:text "Pilosa crura sensim demittit vado;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21/text/29>
      a       zoo:Paragraph ;
      zoo:identifier 29 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21> ;
      zoo:text "Sed difficulter continetur spiritus," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/23/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/23> ;
      zoo:text "Serpens lacertam forte aversam prenderat;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19/text/25>
      a       zoo:Paragraph ;
      zoo:identifier 25 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19> ;
      zoo:text "Qui circumcidis omnem impensam funeri" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/26/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/26> ;
      zoo:text "Igitur cum currens bibere coepisset canis," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/50>
      a       zoo:Paragraph ;
      zoo:identifier 50 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Non evertisset scelere funesto domum." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/11/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/11> ;
      zoo:text "Adversus omnes fortis veloces feras" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14/text/24>
      a       zoo:Paragraph ;
      zoo:identifier 24 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14> ;
      zoo:text "Et admirantur: deinde domino nuntiant." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/8/text/16>
      a       zoo:Paragraph ;
      zoo:identifier 16 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/8> ;
      zoo:text "Hic caede patris Peliadum infecit manus." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/23/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/23> ;
      zoo:text "Respondit ille: Faceres si causa mea," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/27>
      a       zoo:Paragraph ;
      zoo:identifier 27 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Sed iam quodcumque fuerit, ut dixit Sinon," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/20/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/20> ;
      zoo:text "Quorum inter villos simul haeserunt canceres," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/20/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/20> ;
      zoo:text "Scopulosum ad littus currit et prendens petram" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/11/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/11> ;
      zoo:text "Aliquando obiectus hispidi pugnae suis" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/8/text/19>
      a       zoo:Paragraph ;
      zoo:identifier 19 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/8> ;
      zoo:text "Aegaea Minos classe perdomuit freta" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14/text/27>
      a       zoo:Paragraph ;
      zoo:identifier 27 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14> ;
      zoo:text "Ubi nuntiatum est, recreatus gaudiis" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8> ;
      zoo:text "Ubi vanus animus aura captus frivola" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/26/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/26> ;
      zoo:text "Sic corcodilus: Quamlibet lambe otio;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/23/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/23> ;
      zoo:text "Et pertinaci morsu transversum tenens," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19/text/26>
      a       zoo:Paragraph ;
      zoo:identifier 26 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19> ;
      zoo:text "Libitina ne quid de tuo faciat lucri." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/18/text/17>
      a       zoo:Paragraph ;
      zoo:identifier 17 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/18> ;
      zoo:text "Haec experiris, ut refers, incommoda;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/23/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/23> ;
      zoo:text "Quas sunt rosuri, simul et ipsos devores," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/5/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/5> ;
      zoo:text "Pendere ad lanium quidam vidit simium," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/28>
      a       zoo:Paragraph ;
      zoo:identifier 28 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Ad regem cum Dardaniae perductus foret," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21> ;
      zoo:text "Erat autem, ut aiunt, natus in Cia insula:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/20/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/20> ;
      zoo:text "Si quando in silvis urso desunt copiae," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/26/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/26> ;
      zoo:text "Noli vereri. At ille: Facerem mehercule," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/11/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/11> ;
      zoo:text "Languere coepit annis ingravantibus." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/8/text/18>
      a       zoo:Paragraph ;
      zoo:identifier 18 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/8> ;
      zoo:text "Falsoque dictum; longe quia vetustior" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/23/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/23> ;
      zoo:text "Arripuit illa prope iacentem surculum," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14/text/26>
      a       zoo:Paragraph ;
      zoo:identifier 26 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14> ;
      zoo:text "Amorem crebris avocabat poculis." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/23/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/23> ;
      zoo:text "Nunc quia laboras ut fruaris reliquiis," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/18/text/18>
      a       zoo:Paragraph ;
      zoo:identifier 18 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/18> ;
      zoo:text "Quid si peccaris? quae te passurum putas?" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/29>
      a       zoo:Paragraph ;
      zoo:identifier 29 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Librum exarabo tertium Aesopi stilo," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21> ;
      zoo:text "Ascendit navem, quam tempestas horrida" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/5/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/5> ;
      zoo:text "Libenter istum prorsus appeterem cibum," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8> ;
      zoo:text "Quam dulcis sit libertas, breviter proloquar." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14/text/29>
      a       zoo:Paragraph ;
      zoo:identifier 29 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14> ;
      zoo:text "Aequalitatis inter plausus nuptias." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8> ;
      zoo:text "Facile ad derisum stulta levitas ducitur." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/12/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/12> ;
      zoo:text "Damnum insectatus est amissi corporis." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/8/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/8> ;
      zoo:text "Et regna Peliae scelere Medeae iacent," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6/text/37>
      a       zoo:Paragraph ;
      zoo:identifier 37 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6> ;
      zoo:text "Turpemque aperto pignore errorem probans:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21/text/26>
      a       zoo:Paragraph ;
      zoo:identifier 26 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21> ;
      zoo:text "Decerne quod religio, quod patitur fides," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/23/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/23> ;
      zoo:text "Praedam dimisit ore serpens irritam." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8/text/20>
      a       zoo:Paragraph ;
      zoo:identifier 20 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8> ;
      zoo:text "Qui simul advenit, rumor de tibicine" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/23/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/23> ;
      zoo:text "Mustela ab homine prensa cum instantem necem" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/10/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/10> ;
      zoo:text "Qui modo securus nostra irridebas mala," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/5/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/5> ;
      zoo:text "Quas aspernatus ille sic locutus est:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/8/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/8> ;
      zoo:text "Namque et superbi luget Aeetae domus," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/12/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/12> ;
      zoo:text "En ait hoc unum est, cur laborem validius," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/26/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/26> ;
      zoo:text "Consilia qui dant prava cautis hominibus," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14/text/28>
      a       zoo:Paragraph ;
      zoo:identifier 28 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14> ;
      zoo:text "Hortante Baccho et Venere, dulces perficit" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8> ;
      zoo:text "Arripuit insolentem sibi fiduciam," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/23/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/23> ;
      zoo:text "Avidum sollerti rictum frenavit mora." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21/text/25>
      a       zoo:Paragraph ;
      zoo:identifier 25 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21> ;
      zoo:text "Dein simili gyro venient aliorum vices." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6/text/38>
      a       zoo:Paragraph ;
      zoo:identifier 38 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6> ;
      zoo:text "En hic declarat quales sitis iudices!" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19/text/20>
      a       zoo:Paragraph ;
      zoo:identifier 20 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19> ;
      zoo:text "Qui tristis audis musicum citharae sonum," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6/text/35>
      a       zoo:Paragraph ;
      zoo:identifier 35 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6> ;
      zoo:text "Imitatum, et cogit rusticum trudi foras." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/5/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/5> ;
      zoo:text "Asello iussit reliquias poni hordei." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/12/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/12> ;
      zoo:text "Integritatis testes quia desunt mihi." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/26/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/26> ;
      zoo:text "Et perdunt operam et deridentur turpiter." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21/text/28>
      a       zoo:Paragraph ;
      zoo:identifier 28 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21> ;
      zoo:text "Excedit animus quem proposuit terminum;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8> ;
      zoo:text "Operam Bathyllo solitus in scaena dare." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/8/text/15>
      a       zoo:Paragraph ;
      zoo:identifier 15 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/8> ;
      zoo:text "Illic per artus fratris explicuit fugam," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19/text/21>
      a       zoo:Paragraph ;
      zoo:identifier 21 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19> ;
      zoo:text "Quem tibiarum macerat iucunditas," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6/text/41>
      a       zoo:Paragraph ;
      zoo:identifier 41 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6> ;
      zoo:text "Deformis cultum vendet ut vinum paret;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/20/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/20> ;
      zoo:text "Ergo etiam stultis acuit ingenium fames." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/23/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/23> ;
      zoo:text "Quae tibi molestis muribus purgo domum." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/4/text/22>
      a       zoo:Paragraph ;
      zoo:identifier 22 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/4> ;
      zoo:text "Pedes habere facile et ipse assentio." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/5/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/5> ;
      zoo:text "Cui pro salute votum debebat sua," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8> ;
      zoo:text "Princeps tibicen notior paulo fuit," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21/text/27>
      a       zoo:Paragraph ;
      zoo:identifier 27 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21> ;
      zoo:text "Et graviter me tutare iudicio tuo." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6/text/36>
      a       zoo:Paragraph ;
      zoo:identifier 36 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6> ;
      zoo:text "At ille profert ipsum porcellum e sinu," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/8/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/8> ;
      zoo:text "Quae saevum ingenium variis involvens modis" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/12/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/12> ;
      zoo:text "Sed quid fortunae, stulte, delictum arguis?" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/26/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/26> ;
      zoo:text "Canes currentes bibere in Nilo flumine," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19/text/22>
      a       zoo:Paragraph ;
      zoo:identifier 22 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19> ;
      zoo:text "Obsoniorum pretia cui gemitum exprimunt," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6/text/40>
      a       zoo:Paragraph ;
      zoo:identifier 40 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6> ;
      zoo:text "Ut moribus quid teneat alienum suis." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/23/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/23> ;
      zoo:text "Effugere vellet: Parce, quaeso inquit mihi," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/20/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/20> ;
      zoo:text "Escaque fruitur passim collecta vafer." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6/text/33>
      a       zoo:Paragraph ;
      zoo:identifier 33 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6> ;
      zoo:text "Et cum dolore vocem naturae exprimit." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/19/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/19> ;
      zoo:text "Sed forma vincis, vincis magnitudine;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/10/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/10> ;
      zoo:text "Dum loquitur, ipsum accipiter necopinum rapit" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/3/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/3> ;
      zoo:text "Scio quam virtuti non sit credendum tuae." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21> ;
      zoo:text "Homo doctus in se semper divitias habet." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/9/text/16>
      a       zoo:Paragraph ;
      zoo:identifier 16 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/9> ;
      zoo:text "Tu faciem ut istam moribus vincas bonis." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/5/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/5> ;
      zoo:text "Nam praedam cepi et didici quam sis utilis." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/5/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/5> ;
      zoo:text "Et turpi facie multos cognovi optimos." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/18/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/18> ;
      zoo:text "Emerui libertatem, canus servio." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/7/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/7> ;
      zoo:text "Quidnam futurum est, si crearit liberos?" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24/text/30>
      a       zoo:Paragraph ;
      zoo:identifier 30 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24> ;
      zoo:text "Nec ulli iuvenes sunt reperti ad ianuam." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6/text/43>
      a       zoo:Paragraph ;
      zoo:identifier 43 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6> ;
      zoo:text "At illa gaudens pecore et lanae dedita" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/28/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/28> ;
      zoo:text "Vellent carere, tuti posthac viverent;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8/text/24>
      a       zoo:Paragraph ;
      zoo:identifier 24 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8> ;
      zoo:text "Di sunt locuti more translaticio." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/5/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/5> ;
      zoo:text "Sed dicis: Qui rapuere divitias, habent." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/5/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/5> ;
      zoo:text "Atque ita coegit frenos invitum pati." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/19/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/19> ;
      zoo:text "Tunc consolandi gratia dixit dea:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/15/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/15> ;
      zoo:text "Barbam capellae cum impetrassent ab Iove," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/3/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/3> ;
      zoo:text "Ego qui sum expertus quantis fugias viribus," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/28/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/28> ;
      zoo:text "Haec res avaris esse conveniens potest" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6/text/34>
      a       zoo:Paragraph ;
      zoo:identifier 34 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6> ;
      zoo:text "Acclamat populus scurram multo similius" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/10/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/10> ;
      zoo:text "Nota inquit illa est? Quid ita cessarunt pedes?" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21> ;
      zoo:text "Simonides, qui scripsit egregium melos," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/18/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/18> ;
      zoo:text "Ullius essem culpae mihi si conscius," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/5/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/5> ;
      zoo:text "Quando et formosos saepe inveni pessimos," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/15/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/15> ;
      zoo:text "Ad cogitandum melior ut redeat tibi." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/7/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/7> ;
      zoo:text "Cogitque miseras arida sede emori." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24/text/31>
      a       zoo:Paragraph ;
      zoo:identifier 31 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24> ;
      zoo:text "Ut est vulgatus ordo narratae rei," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/17/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/17> ;
      zoo:text "Pari dolore fata deflesset sua." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6/text/42>
      a       zoo:Paragraph ;
      zoo:identifier 42 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6> ;
      zoo:text "Agros abiciet moecha ut ornatum gerat;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/28/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/28> ;
      zoo:text "Hoc si praestare possent homines, ut suo" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8/text/23>
      a       zoo:Paragraph ;
      zoo:identifier 23 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8> ;
      zoo:text "Aulaeo misso, devolutis tonitribus" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/5/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/5> ;
      zoo:text "Periculosum semper vitavi lucrum." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/3/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/3> ;
      zoo:text "Ut possis alios ignorantes fallere," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/10/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/10> ;
      zoo:text "Lepus semianimus mortis in solacio:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/15/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/15> ;
      zoo:text "Hirci maerentes indignari coeperunt" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/28/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/28> ;
      zoo:text "Et qui humiles nati dici locupletes student." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/12/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/12> ;
      zoo:text "Eunuchus litigabat cum quodam improbo," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/9/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/9> ;
      zoo:text "Cotidie inquit speculo vos uti volo:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6/text/31>
      a       zoo:Paragraph ;
      zoo:identifier 31 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6> ;
      zoo:text "Sed, in priore quia nil compererant, latens)" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/19/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/19> ;
      zoo:text "Se derideri simul ac vocem miserit." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/7/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/7> ;
      zoo:text "Nunc inquit omnes unus exurit lacus" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/15/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/15> ;
      zoo:text "Sic lusus animo debent aliquando dari," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24/text/32>
      a       zoo:Paragraph ;
      zoo:identifier 32 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24> ;
      zoo:text "Omnes scierunt numinum praesentiam" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6/text/45>
      a       zoo:Paragraph ;
      zoo:identifier 45 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6> ;
      zoo:text "Sic nulla possidebit quod fuerit datum," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/17/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/17> ;
      zoo:text "Quod si perfidiae se commisisset lupi," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8/text/22>
      a       zoo:Paragraph ;
      zoo:identifier 22 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8> ;
      zoo:text "Quidam in conspectum proditurum sine mora." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/5/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/5> ;
      zoo:text "Avari describuntur, quos circumfluit" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/11/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/11> ;
      zoo:text "Te credo surripuisse quod pulchre negas." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/5/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/5> ;
      zoo:text "Huius respectu fabulae deterritus" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24/text/33>
      a       zoo:Paragraph ;
      zoo:identifier 33 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24> ;
      zoo:text "Vati dedisse vitam mercedis loco." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/28/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/28> ;
      zoo:text "Humana effodiens ossa thesaurum canis" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6/text/32>
      a       zoo:Paragraph ;
      zoo:identifier 32 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6> ;
      zoo:text "Pervellit aurem vero, quem celaverat," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/10/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/10> ;
      zoo:text "Questuque vano clamitantem interficit." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/15/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/15> ;
      zoo:text "Quod dignitatem feminae aequassent suam." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/3/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/3> ;
      zoo:text "Nunc conde ferrum et linguam pariter futtilem." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/20>
      a       zoo:Paragraph ;
      zoo:identifier 20 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Quamvis in ipsa paene natus sim schola" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/19/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/19> ;
      zoo:text "Illum esse cunctis avibus admirabilem," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/9/text/15>
      a       zoo:Paragraph ;
      zoo:identifier 15 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/9> ;
      zoo:text "Tu formam ne corrumpas nequitiae malis;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/7/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/7> ;
      zoo:text "Causam querelae. Quaedam tum stagni incola:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/12/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/12> ;
      zoo:text "Qui super obscena dicta et petulans iurgium" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/15/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/15> ;
      zoo:text "At si laxaris, cum voles erit utilis." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/17/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/17> ;
      zoo:text "Et: Satis est inquit si recedis longius." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6/text/44>
      a       zoo:Paragraph ;
      zoo:identifier 44 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6> ;
      zoo:text "Quacumque summa tradet luxuriae domum." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8/text/21>
      a       zoo:Paragraph ;
      zoo:identifier 21 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8> ;
      zoo:text "Fremit in theatro. Quidam affirmant mortuum," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/28/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/28> ;
      zoo:text "Haud quisquam insidias nudo faceret corpori." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/5/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/5> ;
      zoo:text "Usus bonorum, sed nil possunt tangere." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/5/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/5> ;
      zoo:text "Nisi, qui nutritus illo est, iugulatus foret." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/28/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/28> ;
      zoo:text "Invenit, et violarat quia Manes deos," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21> ;
      zoo:text "Mercede accepta laudem victorum canens." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/21>
      a       zoo:Paragraph ;
      zoo:identifier 21 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Curamque habendi penitus corde eraserim" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/5/text/24>
      a       zoo:Paragraph ;
      zoo:identifier 24 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/5> ;
      zoo:text "Felisque catulis largam praebuerunt dapem." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/10/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/10> ;
      zoo:text "Stultum esse paucis ostendemus versibus." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/11/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/11> ;
      zoo:text "Praedam dimisit. Hic tunc venator dolens" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/15/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/15> ;
      zoo:text "Cito rumpes arcum semper si tensum habueris;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/15/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/15> ;
      zoo:text "Sinite inquit illas gloria vana frui" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/18/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/18> ;
      zoo:text "Has propter causas et quas longum est promere," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6/text/47>
      a       zoo:Paragraph ;
      zoo:identifier 47 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6> ;
      zoo:text "Ex pretio rerum quas vendiderint singulae." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/17/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/17> ;
      zoo:text "Suspectum officium repudiavit malefici" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/11/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/11> ;
      zoo:text "Canem obiurgabat. Cui latrans contra senex:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/23/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/23> ;
      zoo:text "Atque ita locutus improbam leto dedit." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/5/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/5> ;
      zoo:text "Quaesivit quidnam saperet. Tum lanius iocans:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/2/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/2> ;
      zoo:text "Ne sceptrum mundi raperet nostra audacia." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/5/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/5> ;
      zoo:text "Auxilium petiit hominis, quem dorso levans" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8/text/28>
      a       zoo:Paragraph ;
      zoo:identifier 28 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8> ;
      zoo:text "In plausus consurrectum est. Iactat basia" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/17/text/36>
      a       zoo:Paragraph ;
      zoo:identifier 36 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/17> ;
      zoo:text "Novum et venire qui videt culum olfacit." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21> ;
      zoo:text "Hoc genere quaestus postquam locuples factus est," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/5/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/5> ;
      zoo:text "Rediit ad hostem. Iactis hunc telis eques" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/5/text/23>
      a       zoo:Paragraph ;
      zoo:identifier 23 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/5> ;
      zoo:text "Quid multa? Inedia sunt consumpti cum suis" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/22>
      a       zoo:Paragraph ;
      zoo:identifier 22 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Et laude invicta vitam in hanc incubuerim," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/28/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/28> ;
      zoo:text "Iniecta est illi divitiarum cupiditas," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6/text/30>
      a       zoo:Paragraph ;
      zoo:identifier 30 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6> ;
      zoo:text "Porcellum obtegere (quod faciebat scilicet," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/10/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/10> ;
      zoo:text "Sibi non cavere et aliis consilium dare" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/11/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/11> ;
      zoo:text "Arripuit aurem, sed cariosis dentibus" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/19/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/19> ;
      zoo:text "Quo mi inquit mutam speciem, si vincor sono?" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/15/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/15> ;
      zoo:text "Et usurpare vestri ornatum muneris," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/18/text/15>
      a       zoo:Paragraph ;
      zoo:identifier 15 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/18> ;
      zoo:text "Abire destinavi quo tulerint pedes." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/17/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/17> ;
      zoo:text "Quae vero nosset pectoris fraudem improbi," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/18/text/16>
      a       zoo:Paragraph ;
      zoo:identifier 16 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/18> ;
      zoo:text "Ergo inquit audi: cum mali nil feceris," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6/text/46>
      a       zoo:Paragraph ;
      zoo:identifier 46 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6> ;
      zoo:text "Et dictam matri conferent pecuniam" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/23/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/23> ;
      zoo:text "Noli imputare vanum beneficium mihi." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/5/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/5> ;
      zoo:text "Inter reliquas merces atque obsonia;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/2/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/2> ;
      zoo:text "Haec qui negavit magno consilio homini," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21> ;
      zoo:text "Redire in patriam voluit cursu pelagio;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/17/text/35>
      a       zoo:Paragraph ;
      zoo:identifier 35 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/17> ;
      zoo:text "Ita nunc legatos exspectant et posteri" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8/text/27>
      a       zoo:Paragraph ;
      zoo:identifier 27 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8> ;
      zoo:text "Laetare, incolumis Roma, salvo principe!" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21> ;
      zoo:text "Quo paupertatem sustineret facilius," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/19/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/19> ;
      zoo:text "Pictisque plumis gemmeam caudam explicas." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/5/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/5> ;
      zoo:text "Postquam interfecit, sic locutus traditur:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/5/text/22>
      a       zoo:Paragraph ;
      zoo:identifier 22 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/5> ;
      zoo:text "Aper rapinam vitans non prodit foras." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/10/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/10> ;
      zoo:text "Leporem obiurgabat passer: Ubi pernicitas" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/23>
      a       zoo:Paragraph ;
      zoo:identifier 23 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Fastidiose tamen in coetum recipior." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/28/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/28> ;
      zoo:text "Poenas ut sanctae Religioni penderet." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/5/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/5> ;
      zoo:text "Ridicule magis hoc dictum quam vere aestimo;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/18/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/18> ;
      zoo:text "Aequo animo ferrem; numquam sum factus satur" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/15/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/15> ;
      zoo:text "Pares dum non sint vestrae fortitudinis." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/11/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/11> ;
      zoo:text "Quod fuimus laudas, si iam damnas quod sumus." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/24>
      a       zoo:Paragraph ;
      zoo:identifier 24 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Quid credis illi accidere, qui magnas opes" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8/text/26>
      a       zoo:Paragraph ;
      zoo:identifier 26 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8> ;
      zoo:text "Insonuit, cuius haec fuit sententia:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/17/text/34>
      a       zoo:Paragraph ;
      zoo:identifier 34 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/17> ;
      zoo:text "Numquam carebunt hominis contumelia." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6/text/49>
      a       zoo:Paragraph ;
      zoo:identifier 49 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6> ;
      zoo:text "Unius hominis repperit sollertia." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/17/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/17> ;
      zoo:text "Se posse fungi dixit, promittens opem." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21> ;
      zoo:text "Circum ire coepit urbes Asiae nobiles," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/19/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/19> ;
      zoo:text "Nitor smaragdi collo praefulget tuo" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/28/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/28> ;
      zoo:text "Itaque, aurum dum custodit oblitus cibi," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/5/text/21>
      a       zoo:Paragraph ;
      zoo:identifier 21 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/5> ;
      zoo:text "Ruinam metuens aquila ramis desidet;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/5/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/5> ;
      zoo:text "Laetor tulisse auxilium me precibus tuis," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/10/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/10> ;
      zoo:text "Oppressum ab aquila, fletus edentem graves," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/5/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/5> ;
      zoo:text "Quale inquit caput est, talis praestatur sapor." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/18/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/18> ;
      zoo:text "Et super infelix saevum patior dominium." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/15/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/15> ;
      zoo:text "Hoc argumentum monet ut sustineas tibi" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/11/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/11> ;
      zoo:text "Non te destituit animus, sed vires meae." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8/text/25>
      a       zoo:Paragraph ;
      zoo:identifier 25 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8> ;
      zoo:text "Tunc chorus ignotum modo reducto canticum" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/25>
      a       zoo:Paragraph ;
      zoo:identifier 25 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Exaggerare quaerit omni vigilia," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/5/text/20>
      a       zoo:Paragraph ;
      zoo:identifier 20 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/5> ;
      zoo:text "Pavorem simulans prospicit toto die." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/17/text/33>
      a       zoo:Paragraph ;
      zoo:identifier 33 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/17> ;
      zoo:text "Illi autem qui miserunt vos tam futtiles" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/17/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/17> ;
      zoo:text "Accurrit lupus et obstetricis partibus" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6/text/48>
      a       zoo:Paragraph ;
      zoo:identifier 48 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6> ;
      zoo:text "Ita quod multorum fugit imprudentiam" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/12/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/12> ;
      zoo:text "Leonis affliguntur horrendo impetu." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/4/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/4> ;
      zoo:text "Quia non fuisse mentem laedendi scio." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/10/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/10> ;
      zoo:text "(Cuius non fugio mortem, si famam assequar," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/2/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/2> ;
      zoo:text "Quaecumque indulgens Fortuna animali dedit:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/14/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/14> ;
      zoo:text "O qui tuarum, corve, pennarum est nitor!" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/4/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/4> ;
      zoo:text "Suoque potius habitu vitam degere," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/1/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/1> ;
      zoo:text "Dictorum sensus ut delectet varietas," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/12/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/12> ;
      zoo:text "Per quem verendos excolit pietas deos," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/17/text/32>
      a       zoo:Paragraph ;
      zoo:identifier 32 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/17> ;
      zoo:text "Ne ventrem continere non possint suum." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/6/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/6> ;
      zoo:text "Prospectat Siculum et perspicit Tuscum mare:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/25/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/25> ;
      zoo:text "Adhuc supersunt multa quae possim loqui," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6/text/27>
      a       zoo:Paragraph ;
      zoo:identifier 27 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6> ;
      zoo:text "Sic destinata dare cum vellet singulis" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/10/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/10> ;
      zoo:text "Et cedo invidiae, dummodo absolvar cinis)," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/2/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/2> ;
      zoo:text "Putabat se post mortem securum fore;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/12/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/12> ;
      zoo:text "Qui postquam caede fessus est, asinum evocat" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/4/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/4> ;
      zoo:text "Respondit: Mecum facile redeo in gratiam," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/2/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/2> ;
      zoo:text "Elephanti vires, et leonis impetum," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/29/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/29> ;
      zoo:text "Incolumes natos supplex vulpi tradidit." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/4/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/4> ;
      zoo:text "Aesopus nobis hoc exemplum prodidit." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/1/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/1> ;
      zoo:text "Bonas in partes, lector, accipias velim," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/12/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/12> ;
      zoo:text "Veto esse tale luminis commercium." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/6/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/6> ;
      zoo:text "Ex alticinctis unus atriensibus," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/14/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/14> ;
      zoo:text "Vulpes hunc vidit, deinde sic coepit loqui:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/17/text/31>
      a       zoo:Paragraph ;
      zoo:identifier 31 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/17> ;
      zoo:text "Non veto dimitti, verum cruciari fame," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/25/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/25> ;
      zoo:text "Et copiosa abundat rerum varietas;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/2/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/2> ;
      zoo:text "Ecce aliae plagae congeruntur mortuo." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6/text/26>
      a       zoo:Paragraph ;
      zoo:identifier 26 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6> ;
      zoo:text "Domum politam et delicatos hortulos." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/4/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/4> ;
      zoo:text "Quae delectaris bibere humanum sanguinem," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/5/text/26>
      a       zoo:Paragraph ;
      zoo:identifier 26 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/5> ;
      zoo:text "Documentum habere stulta credulitas potest." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/10/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/10> ;
      zoo:text "Ex populo sic nescio quis, ut fieri solet:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6> ;
      zoo:text "Sub condicione totam ut fortunam tribus" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/12/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/12> ;
      zoo:text "Iubetque vocem premere. Tunc ille insolens:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/2/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/2> ;
      zoo:text "Cornicis aevum, gloriam tauri trucis," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/29/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/29> ;
      zoo:text "Hosti dolorem damno miscens sanguinis." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/16/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/16> ;
      zoo:text "Inter capellas agno balanti canis:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/3/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/3> ;
      zoo:text "Moecha ut sequatur sese quicquid tetigerit." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/29/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/29> ;
      zoo:text "Aquila ut periclo mortis eriperet suos" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/22/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/22> ;
      zoo:text "Impune laedi, calcibus frontem extudit." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/4/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/4> ;
      zoo:text "Tumens inani graculus superbia," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/14/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/14> ;
      zoo:text "Si vocem haberes, nulla prior ales foret." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/12/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/12> ;
      zoo:text "Itaque hodie nec lucernam de flamma deum" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/17/text/30>
      a       zoo:Paragraph ;
      zoo:identifier 30 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/17> ;
      zoo:text "Sed hoc feretis pro iudicio praemium:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6/text/29>
      a       zoo:Paragraph ;
      zoo:identifier 29 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6> ;
      zoo:text "Aesopus media subito in turba constitit:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/60>
      a       zoo:Paragraph ;
      zoo:identifier 60 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Ergo hinc abesto, livor, ne frustra gemas," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/5/text/25>
      a       zoo:Paragraph ;
      zoo:identifier 25 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/5> ;
      zoo:text "Quantum homo bilinguis saepe concinnet mali," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/10/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/10> ;
      zoo:text "Quaeso, tam angustam talis vir ponis domum?" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6> ;
      zoo:text "Aequaliter distribuat, sed tali modo:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/12/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/12> ;
      zoo:text "Qualis videtur opera tibi vocis meae?" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/4/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/4> ;
      zoo:text "Sed te, contempti generis animal improbum," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/2/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/2> ;
      zoo:text "Equi velocis placidam mansuetudinem," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/22/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/22> ;
      zoo:text "Hostile corpus. Asinus, ut vidit ferum" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/4/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/4> ;
      zoo:text "Pennas pavoni quae deciderant sustulit" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/14/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/14> ;
      zoo:text "Quantum decoris corpore et vultu geris!" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/16/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/16> ;
      zoo:text "Stulte, inquit erras; non est hic mater tua;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/12/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/12> ;
      zoo:text "Nec de lucerna fas est accendi sacrum." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6/text/28>
      a       zoo:Paragraph ;
      zoo:identifier 28 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6> ;
      zoo:text "Et approbaret populus, qui illas noverat," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6> ;
      zoo:text "Devotam vino tertiam et turpissimam." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/49>
      a       zoo:Paragraph ;
      zoo:identifier 49 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Subtiliter limasset, a radicibus" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/61>
      a       zoo:Paragraph ;
      zoo:identifier 61 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Quoniam mihi sollemnis debetur gloria." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/10/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/10> ;
      zoo:text "Utinam inquit veris hanc amicis impleam!." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/12/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/12> ;
      zoo:text "Insignis inquit sic ut, nisi nossem tuum" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8> ;
      zoo:text "Sibi in sinistram et sputum digitis dissipat." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/7/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/7> ;
      zoo:text "Periclitatur magnitudo principum;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/1/text/15>
      a       zoo:Paragraph ;
      zoo:identifier 15 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/1> ;
      zoo:text "Modestis etiam offerre quod non petierint." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/25/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/25> ;
      zoo:text "Particulo, chartis nomen victurum meis" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9/text/18>
      a       zoo:Paragraph ;
      zoo:identifier 18 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9> ;
      zoo:text "Sed ille, qui oculos centum habet, si venerit," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/10/text/19>
      a       zoo:Paragraph ;
      zoo:identifier 19 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/10> ;
      zoo:text "Donec fortunam criminis pudeat sui." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/14/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/14> ;
      zoo:text "Fere dat poenas turpi paenitentia." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/6/text/16>
      a       zoo:Paragraph ;
      zoo:identifier 16 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/6> ;
      zoo:text "Haec elocuta concidit virgo furens:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6> ;
      zoo:text "Harum autem matrem fecit heredem senex" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/62>
      a       zoo:Paragraph ;
      zoo:identifier 62 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Induxi te ad legendum; sincerum mihi" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/12/text/15>
      a       zoo:Paragraph ;
      zoo:identifier 15 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/12> ;
      zoo:text "Animum genusque, simili fugissem metu." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8> ;
      zoo:text "Sic, imperator, oculi exstillescant mei," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/7/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/7> ;
      zoo:text "Quemcumque populum tristis eventus premit," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/25/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/25> ;
      zoo:text "Latinis dum manebit pretium litteris," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/2/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/2> ;
      zoo:text "Arbitrio si natura finxisset meo" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9/text/17>
      a       zoo:Paragraph ;
      zoo:identifier 17 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9> ;
      zoo:text "Respondit unus: Salvum te cupimus quidem;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/10/text/18>
      a       zoo:Paragraph ;
      zoo:identifier 18 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/10> ;
      zoo:text "Fatale exitium corde durato feram," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/6/text/17>
      a       zoo:Paragraph ;
      zoo:identifier 17 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/6> ;
      zoo:text "Furens profecto, nam quae dixit perdidit." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/15/text/18>
      a       zoo:Paragraph ;
      zoo:identifier 18 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/15> ;
      zoo:text "Quorum stultitia quaestus impudentiae est." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/14/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/14> ;
      zoo:text "Qui se laudari gaudet verbis subdolis," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/63>
      a       zoo:Paragraph ;
      zoo:identifier 63 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Candore noto reddas iudicium peto." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/47>
      a       zoo:Paragraph ;
      zoo:identifier 47 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Quod si delata perscrutatus crimina" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8> ;
      zoo:text "Si vidi aut tetigi. Tum vir animi simplicis" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/7/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/7> ;
      zoo:text "Capacis alvi mersit tartareo specu." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/25/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/25> ;
      zoo:text "Sed temperatae suaves sunt argutiae," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/1/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/1> ;
      zoo:text "Ita si rependet illi brevitas gratiam." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/10/text/17>
      a       zoo:Paragraph ;
      zoo:identifier 17 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/10> ;
      zoo:text "Nec quicquam possunt nisi meliores carpere," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/2/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/2> ;
      zoo:text "Genus mortale, longe foret instructius:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/14/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/14> ;
      zoo:text "Comesse vellet, celsa residens arbore," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6> ;
      zoo:text "Unam formosam et oculis venantem viros;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/15/text/17>
      a       zoo:Paragraph ;
      zoo:identifier 17 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/15> ;
      zoo:text "Hoc pertinere vere ad illos dixerim," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/48>
      a       zoo:Paragraph ;
      zoo:identifier 48 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Paterfamilias esset, si mendacium" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/1/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/1> ;
      zoo:text "Attende, cur negare cupidis debeas," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8> ;
      zoo:text "Id dedecus castrorum propelli iubet," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/3/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/3> ;
      zoo:text "Solet a despectis par referri gratia." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9/text/19>
      a       zoo:Paragraph ;
      zoo:identifier 19 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9> ;
      zoo:text "Magno in periclo vita vertetur tua." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/25/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/25> ;
      zoo:text "Immodicae offendunt. Quare, vir sanctissime," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/10/text/16>
      a       zoo:Paragraph ;
      zoo:identifier 16 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/10> ;
      zoo:text "Sinistra quos in lucem natura extulit" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/1/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/1> ;
      zoo:text "Cuius verbosa ne sit commendatio," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/4/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/4> ;
      zoo:text "Ne gloriari libeat alienis bonis" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/2/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/2> ;
      zoo:text "Nam cuncta nobis attribuisset commoda," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/14/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/14> ;
      zoo:text "Cum de fenestra corvus raptum caseum" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/26/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/26> ;
      zoo:text "Demonstrat nutu partem. Venator citus" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/15/text/16>
      a       zoo:Paragraph ;
      zoo:identifier 16 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/15> ;
      zoo:text "Cui calceandos nemo commisit pedes?" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6> ;
      zoo:text "At alteram lanificam et frugi rusticam;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13> ;
      zoo:text "Per aliquot annos quaedam dilectum virum" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21> ;
      zoo:text "Nam vita morti propior est cotidie," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8> ;
      zoo:text "Aut quo cibo fecisti tantum corporis?" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/45>
      a       zoo:Paragraph ;
      zoo:identifier 45 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Namque orbam nato simul et privatam viro" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/5/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/5> ;
      zoo:text "Impune potius laedi quam dedi alteri." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/27/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/27> ;
      zoo:text "Tamen praeberet sese facilem mulieri," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8> ;
      zoo:text "Nec cadere in illum credit tantam audaciam." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/31/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/31> ;
      zoo:text "Rana in palude pugnam taurorum intuens:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/12/text/18>
      a       zoo:Paragraph ;
      zoo:identifier 18 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/12> ;
      zoo:text "Secundum ostendit scelera non ira deum," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/3/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/3> ;
      zoo:text "Panthera imprudens olim in foveam decidit." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/6/text/18>
      a       zoo:Paragraph ;
      zoo:identifier 18 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/6> ;
      zoo:text "Praecurrit alium in xystum, sedans pulverem." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/6/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/6> ;
      zoo:text "Bonis favete, subdolis ite obviam;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/25/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/25> ;
      zoo:text "Quanto poetae sunt molesti validius." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9> ;
      zoo:text "Nec ille quicquam sentit. Tum gaudens ferus" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/16/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/16> ;
      zoo:text "Verum illam, quae me nutrit admoto ubere" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/3/text/16>
      a       zoo:Paragraph ;
      zoo:identifier 16 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/3> ;
      zoo:text "Traxitque ad terram nasi longitudinem," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23/text/24>
      a       zoo:Paragraph ;
      zoo:identifier 24 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23> ;
      zoo:text "Eorum qui se falsis ornant laudibus," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/21/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/21> ;
      zoo:text "Cum circumspectans errore haesisset diu" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/2/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/2> ;
      zoo:text "Cui placidus ille: Non est quod timeas ait;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/21/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/21> ;
      zoo:text "Ave usque ingessit. Tum se lusum intellegens:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6> ;
      zoo:text "Narratione posteris tradam brevi." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/17/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/17> ;
      zoo:text "Furfuribus sibi consparsum quod panem darent" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/15/text/15>
      a       zoo:Paragraph ;
      zoo:identifier 15 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/15> ;
      zoo:text "Qui capita vestra non dubitatis credere," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/26/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/26> ;
      zoo:text "Venit, sed abiit hac ad laevam; et dexteram" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8> ;
      zoo:text "Ut restiterunt: Unde sic, quaeso, nites?" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/15/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/15> ;
      zoo:text "Rex advocata contione haec addidit:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/46>
      a       zoo:Paragraph ;
      zoo:identifier 46 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Miserandam potius quam damnandam existimo." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/27/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/27> ;
      zoo:text "Sic insidiatrix: Omnes muneribus licet" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8/text/15>
      a       zoo:Paragraph ;
      zoo:identifier 15 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8> ;
      zoo:text "Breve tempus intercessit, et fidens manu" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/12/text/19>
      a       zoo:Paragraph ;
      zoo:identifier 19 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/12> ;
      zoo:text "Fatorum dicto sed puniri tempore;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/31/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/31> ;
      zoo:text "Humiles laborant ubi potentes dissident." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/6/text/19>
      a       zoo:Paragraph ;
      zoo:identifier 19 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/6> ;
      zoo:text "Agnoscit hominem Caesar remque intellegit." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/3/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/3> ;
      zoo:text "Videre agrestes: alii fustes congerunt," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/3/text/15>
      a       zoo:Paragraph ;
      zoo:identifier 15 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/3> ;
      zoo:text "Emungere igitur se volens prendit manu" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/21/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/21> ;
      zoo:text "Ut quisquis esset par officium reciperet." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23/text/23>
      a       zoo:Paragraph ;
      zoo:identifier 23 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23> ;
      zoo:text "Fabella talis hominum discernit notas" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9> ;
      zoo:text "Nemo animadvertit: transit etiam vilicus," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/16/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/16> ;
      zoo:text "Fraudatque natos lacte, ne desit mihi." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/6/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/6> ;
      zoo:text "Delicta vindicate; †cohibete impios;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/15/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/15> ;
      zoo:text "Quantae putatis esse vos dementiae," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/17/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/17> ;
      zoo:text "Fimoque turpi maximam explerent famem." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/2/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/2> ;
      zoo:text "Feroque viso rettulit retro pedem." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6> ;
      zoo:text "Quidam decedens tres reliquit filias:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/26/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/26> ;
      zoo:text "Quaeso, bubulce, numquid huc venit lepus?" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8> ;
      zoo:text "Forte occucurrit. Dein salutati invicem" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21> ;
      zoo:text "Quo plus consumet temporis dilatio." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/5/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/5> ;
      zoo:text "Dum quaero demens, servitutem repperi." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/15/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/15> ;
      zoo:text "Verum stupore vulgi factum nobilem." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14/text/31>
      a       zoo:Paragraph ;
      zoo:identifier 31 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14> ;
      zoo:text "Novus maritus coniuge amissa dolet." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/27/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/27> ;
      zoo:text "Cum blandiretur iuveni meretrix perfida," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/43>
      a       zoo:Paragraph ;
      zoo:identifier 43 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Certumque fontem veritatis repperit:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8/text/16>
      a       zoo:Paragraph ;
      zoo:identifier 16 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8> ;
      zoo:text "Unum e Romanis provocabat barbarus." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/3/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/3> ;
      zoo:text "Alii onerant saxis; quidam contra miseriti" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/17/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/17> ;
      zoo:text "Profecti sunt legati non celeri pede." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9/text/16>
      a       zoo:Paragraph ;
      zoo:identifier 16 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9> ;
      zoo:text "Hospitium adverso quod praestiterint tempore." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/25/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/25> ;
      zoo:text "Si non ingenium, certe brevitatem approba," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/11/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/11> ;
      zoo:text "Alii simul delinquunt, censores sumus." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/21/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/21> ;
      zoo:text "Qui festinantis sic detinuisti pedes." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/16/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/16> ;
      zoo:text "Tamen illa est potior quae te peperit. Non ita est." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/6/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/6> ;
      zoo:text "Punite turpi thalamos qui violant stupro;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/6/text/16>
      a       zoo:Paragraph ;
      zoo:identifier 16 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/6> ;
      zoo:text "Humum aestuantem, come officium iactitans," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/21/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/21> ;
      zoo:text "Ostendit sese corvus et supervolans" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/2/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/2> ;
      zoo:text "Viator est deductus in eundem locum" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/26/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/26> ;
      zoo:text "Late securus. Iamque venator sequens:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/15/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/15> ;
      zoo:text "Non artis ulla medicum se prudentia," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21> ;
      zoo:text "Et hoc minus perveniet ad me muneris," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14/text/30>
      a       zoo:Paragraph ;
      zoo:identifier 30 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14> ;
      zoo:text "Quaerunt parentes per praeconem filiam;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/5/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/5> ;
      zoo:text "Haec iracundos admonebit fabula" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8> ;
      zoo:text "Cani perpasto macie confectus lupus" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/7/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/7> ;
      zoo:text "Minuta plebes facili praesidio latet." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/27/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/27> ;
      zoo:text "Et ille laesus multis saepe iniuriis" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/44>
      a       zoo:Paragraph ;
      zoo:identifier 44 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Luat inquit poenas causa libertus mali;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/19/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/19> ;
      zoo:text "Equum ex quadriga multis palmis nobilem" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8/text/17>
      a       zoo:Paragraph ;
      zoo:identifier 17 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8> ;
      zoo:text "Sibi quisque metuit; primi mussitant duces." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/3/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/3> ;
      zoo:text "Periturae quippe, quamvis nemo laederet," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/6/text/17>
      a       zoo:Paragraph ;
      zoo:identifier 17 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/6> ;
      zoo:text "Sed deridetur. Inde notis flexibus" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/17/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/17> ;
      zoo:text "Dum naribus scrutantur escam in stercore," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9/text/15>
      a       zoo:Paragraph ;
      zoo:identifier 15 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9> ;
      zoo:text "Bubus quietis agere coepit gratias," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/25/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/25> ;
      zoo:text "Quae commendari tanto debet iustius" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/26/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/26> ;
      zoo:text "Huic agro feci. Et rusticus: Ne timueris;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/3/text/17>
      a       zoo:Paragraph ;
      zoo:identifier 17 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/3> ;
      zoo:text "Et aliam ridens ipsa ridenda exstitit." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/11/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/11> ;
      zoo:text "Hac re videre nostra mala non possumus;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/21/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/21> ;
      zoo:text "Et perdidisset tempus aliquot milium," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6> ;
      zoo:text "Plus esse in uno saepe quam in turba boni," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23/text/25>
      a       zoo:Paragraph ;
      zoo:identifier 25 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23> ;
      zoo:text "Et quorum virtus exhibet solidum decus." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/21/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/21> ;
      zoo:text "At male tibi sit inquit ales pessime," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/6/text/15>
      a       zoo:Paragraph ;
      zoo:identifier 15 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/6> ;
      zoo:text "Malos cavete; nulli nimium credite." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/2/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/2> ;
      zoo:text "Et improbum reiecit. Forte innoxius" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/15/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/15> ;
      zoo:text "Timore mortis ille tum confessus est" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14/text/33>
      a       zoo:Paragraph ;
      zoo:identifier 33 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14> ;
      zoo:text "Omnes favorem comprobarunt caelitum." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/9/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/9> ;
      zoo:text "Periculosam fecit medicinam lupo." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/27/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/27> ;
      zoo:text "Libenter, inquit, mea lux, hanc vocem audio," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/21/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/21> ;
      zoo:text "Ave exaudivit et moratus paululum," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/41>
      a       zoo:Paragraph ;
      zoo:identifier 41 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Quod ipsos error implicuisset criminis." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/2/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/2> ;
      zoo:text "Et adesset homini sua tamen sollertia." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8/text/18>
      a       zoo:Paragraph ;
      zoo:identifier 18 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8> ;
      zoo:text "Tandem cinaedus habitu, sed Mars viribus," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/4/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/4> ;
      zoo:text "Seque exornavit. Deinde contemnens suos" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/16/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/16> ;
      zoo:text "Ovesque segregatas ostendit procul." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/3/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/3> ;
      zoo:text "Barbatus infans ecce vagitus ciet." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/1/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/1> ;
      zoo:text "Consilium tacito corde damnavi meum." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23/text/20>
      a       zoo:Paragraph ;
      zoo:identifier 20 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23> ;
      zoo:text "Mori contractam cum te cogunt frigora," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/12/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/12> ;
      zoo:text "Quot res contineat hoc argumentum utiles," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/31/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/31> ;
      zoo:text "Longeque ab ipsis degerent vitam boves:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/3/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/3> ;
      zoo:text "Misere panem ut sustineret spiritum." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/2/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/2> ;
      zoo:text "Darem inquit nisi soleres per te sumere:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/26/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/26> ;
      zoo:text "Ne me indices, bubulce; nihil umquam mali" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9> ;
      zoo:text "Spatium diei noctis excipiunt vices." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8> ;
      zoo:text "Quod? inquit ille. Custos ut sis liminis," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/11/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/11> ;
      zoo:text "Alienis ante pectus suspendit gravem." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/6/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/6> ;
      zoo:text "Perambulante laeta domino viridia," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14/text/32>
      a       zoo:Paragraph ;
      zoo:identifier 32 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14> ;
      zoo:text "Quid esset actum postquam populo innotuit," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/7/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/7> ;
      zoo:text "Cum victi mures mustelarum exercitu" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/9/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/9> ;
      zoo:text "Gulaeque credens colli longitudinem," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/5/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/5> ;
      zoo:text "Tum maestus ille: Parvae vindictam rei" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/27/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/27> ;
      zoo:text "Non quod fidelis, sed quod iucunda est mihi." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/21/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/21> ;
      zoo:text "Quidam per agros devium carpens iter" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/42>
      a       zoo:Paragraph ;
      zoo:identifier 42 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Qui postquam tenebras dispulit calumniae" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/2/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/2> ;
      zoo:text "Nimirum in caelo secum ridet Iuppiter," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/4/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/4> ;
      zoo:text "Se inmiscuit pavonum formoso gregi." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8/text/19>
      a       zoo:Paragraph ;
      zoo:identifier 19 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8> ;
      zoo:text "Adit sedentem pro tribunali ducem," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/3/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/3> ;
      zoo:text "Volat Mercurius, intro redeunt mulieres." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/12/text/15>
      a       zoo:Paragraph ;
      zoo:identifier 15 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/12> ;
      zoo:text "Non explicabit alius quam qui repperit." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/31/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/31> ;
      zoo:text "De principatu cum illi certarent gregis" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/14/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/14> ;
      zoo:text "At ille stultus, dum vult vocem ostendere," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/3/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/3> ;
      zoo:text "Nox insecuta est: abeunt securi domum," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/1/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/1> ;
      zoo:text "In hoc, ut aliis esset materiae satis," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/16/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/16> ;
      zoo:text "Non illam quaero, quae, cum libitum est, concipit," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/17/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/17> ;
      zoo:text "Canes legatos olim misere ad Iovem" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/2/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/2> ;
      zoo:text "Praedator intervenit partem postulans." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/26/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/26> ;
      zoo:text "Per superos oro perque spes omnes tuas," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/6/text/15>
      a       zoo:Paragraph ;
      zoo:identifier 15 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/6> ;
      zoo:text "Alveolo coepit ligneo conspargere" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8> ;
      zoo:text "Praestare domino si par officium potes." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/11/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/11> ;
      zoo:text "Propriis repletam vitiis post tergum dedit," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/9/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/9> ;
      zoo:text "Tandem persuasa est iure iurando gruis," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/7/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/7> ;
      zoo:text "(Historia quorum et in tabernis pingitur)" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/27/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/27> ;
      zoo:text "Contendant, ego te plurimi facio tamen." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/10/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/10> ;
      zoo:text "Vulgare amici nomen, sed rara est fides." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/21/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/21> ;
      zoo:text "Iterum salutat idem ex occulto sonus." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/7/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/7> ;
      zoo:text "Namque hoc ab alio numquam continget tibi." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/4/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/4> ;
      zoo:text "Illi inpudenti pennas eripiunt avi" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/6/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/6> ;
      zoo:text "Defendite armis, hostem ferro pellite;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/12/text/16>
      a       zoo:Paragraph ;
      zoo:identifier 16 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/12> ;
      zoo:text "Significat primo saepe quos ipse alueris," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/31/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/31> ;
      zoo:text "Interrogata ab alia cur hoc diceret," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/3/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/3> ;
      zoo:text "Quasi inventuri mortuam postridie." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/3/text/14>
