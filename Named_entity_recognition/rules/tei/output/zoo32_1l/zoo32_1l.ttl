      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/18> ;
      zoo:text "Quod non debebat solvit. Post paucos dies" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23> ;
      zoo:text "Moror inter aras, templa perlustro omnia," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9/text/26>
      a       zoo:Paragraph ;
      zoo:identifier 26 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9> ;
      zoo:text "Quem convocata iubet occidi familia" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/8/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/8> ;
      zoo:text "Hoc illis dictum est, quibus honorem et gloriam" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/24/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/24> ;
      zoo:text "Namque ista subita me iubet benignitas" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6> ;
      zoo:text "Et, pro iudicio dum stant erroris sui," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/34>
      a       zoo:Paragraph ;
      zoo:identifier 34 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Accusatores postularunt mulierem" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/28/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/28> ;
      zoo:text "Qui concupisti subito regales opes," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Quam stulta prave iudicet sententia." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/6/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/6> ;
      zoo:text "Tremuntque lauri et ipse pallescit dies." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/18/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/18> ;
      zoo:text "Bidens iacentem in fovea conspexit lupum:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3/text/18>
      a       zoo:Paragraph ;
      zoo:identifier 18 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3> ;
      zoo:text "Et explorato rege cunctas evocat." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23> ;
      zoo:text "Ubi immolatur, exta praegusto deum." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8/text/20>
      a       zoo:Paragraph ;
      zoo:identifier 20 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8> ;
      zoo:text "Crepusculo solutus, qua visum est, vagor." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9/text/25>
      a       zoo:Paragraph ;
      zoo:identifier 25 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9> ;
      zoo:text "Cervi quoque alta conspicatur cornua;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/8/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/8> ;
      zoo:text "O quanta species, inquit, cerebrum non habet!" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/24/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/24> ;
      zoo:text "Ne latrem pro re domini? Multum falleris." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6> ;
      zoo:text "Proposito cunctos invitavit praemio" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/6/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/6> ;
      zoo:text "Voces resolvit icta Python numine:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/18/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/18> ;
      zoo:text "Deberi dixit, verum affirmavit decem." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/31>
      a       zoo:Paragraph ;
      zoo:identifier 31 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Sopita primo quae nil somno senserat;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23> ;
      zoo:text "Quae pluris esset. Musca sic coepit prior:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Hippolytus obiit, quia novercae creditum est;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8/text/21>
      a       zoo:Paragraph ;
      zoo:identifier 21 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8> ;
      zoo:text "Affertur ultro panis; de mensa sua" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9/text/28>
      a       zoo:Paragraph ;
      zoo:identifier 28 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9> ;
      zoo:text "Dominum videre plurimum in rebus suis." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/5/text/17>
      a       zoo:Paragraph ;
      zoo:identifier 17 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/5> ;
      zoo:text "Consulto involvit veritatem antiquitas," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/24/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/24> ;
      zoo:text "Heus inquit linguam vis meam praecludere," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6> ;
      zoo:text "Facturus ludos dives quidam nobilis" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23> ;
      zoo:text "Conferre nostris tu potes te laudibus?" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/6/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/6> ;
      zoo:text "Audite, gentes, Delii monitus dei:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/32>
      a       zoo:Paragraph ;
      zoo:identifier 32 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Repraesentavit in se poenam facinoris" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Cassandrae quia non creditum, ruit Ilium." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/18/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/18> ;
      zoo:text "Ovis damnata falso testimonio" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/5/text/18>
      a       zoo:Paragraph ;
      zoo:identifier 18 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/5> ;
      zoo:text "Ut sapiens intellegeret, erraret rudis." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8/text/22>
      a       zoo:Paragraph ;
      zoo:identifier 22 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8> ;
      zoo:text "Dat ossa dominus; frusta iactat familia" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/24/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/24> ;
      zoo:text "Obiecto temptans an cibo posset capi:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9/text/27>
      a       zoo:Paragraph ;
      zoo:identifier 27 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9> ;
      zoo:text "Praedamque tollit. Haec significat fabula" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/8/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/8> ;
      zoo:text "Fortuna tribuit, sensum communem abstulit." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Phaedri libellos legere si desideras," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/28/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/28> ;
      zoo:text "Omittit ipsum persequi et vocat canes." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/18/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/18> ;
      zoo:text "Quem commendasse panem se contenderet," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23> ;
      zoo:text "Nihil agere quod non prosit fabella admonet." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8/text/23>
      a       zoo:Paragraph ;
      zoo:identifier 23 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8> ;
      zoo:text "Et, quod fastidit quisque, pulmentarium." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/9/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/9> ;
      zoo:text "Licet horreum mi pateat, ego scalpam tamen." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/24/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/24> ;
      zoo:text "Nocturnus cum fur panem misisset cani," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9/text/22>
      a       zoo:Paragraph ;
      zoo:identifier 22 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9> ;
      zoo:text "Accedit ad praesepe: Cur frondis parum est," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/1/text/19>
      a       zoo:Paragraph ;
      zoo:identifier 19 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/1> ;
      zoo:text "Dignumque longa iudicatis memoria." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/30>
      a       zoo:Paragraph ;
      zoo:identifier 30 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Sanctamque uxorem dormientem cubiculo," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/18/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/18> ;
      zoo:text "Lupus citatus testis non unum modo" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23> ;
      zoo:text "Formica et musca contendebant acriter" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/6/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/6> ;
      zoo:text "Utilius nobis quid sit dic, Phoebe, obsecro," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8/text/24>
      a       zoo:Paragraph ;
      zoo:identifier 24 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8> ;
      zoo:text "Sic sine labore venter impletur meus." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/24/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/24> ;
      zoo:text "Verum peritis irritos tendit dolos." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/9/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/9> ;
      zoo:text "Tum denique illa fassa est naturae malum:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9/text/21>
      a       zoo:Paragraph ;
      zoo:identifier 21 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9> ;
      zoo:text "Et quia corruptos viderat nuper boves," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6> ;
      zoo:text "Pravo favore labi mortales solent" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6/text/19>
      a       zoo:Paragraph ;
      zoo:identifier 19 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6> ;
      zoo:text "Et excuti iuberent. Quo facto simul" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Sed fabulosa ne vetustate elevem," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/6/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/6> ;
      zoo:text "Qui Delphos et formosum Parnasum incolis." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/9/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/9> ;
      zoo:text "Ex toto, ne quid scalpas, quid desideras?" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/24/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/24> ;
      zoo:text "Repente liberalis stultis gratus est," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/18/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/18> ;
      zoo:text "Solent mendaces luere poenas malefici." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9/text/24>
      a       zoo:Paragraph ;
      zoo:identifier 24 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9> ;
      zoo:text "Quantum est laboris? Dum scrutatur singula," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/8/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/8> ;
      zoo:text "Personam tragicam forte vulpes viderat:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/7/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/7> ;
      zoo:text "Musca in temone sedit et mulam increpans:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8/text/25>
      a       zoo:Paragraph ;
      zoo:identifier 25 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8> ;
      zoo:text "Age, si quo abire est animus, est licentia?" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Narrabo tibi memoria quod factum est mea." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/18/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/18> ;
      zoo:text "Calumniator ab ove cum peteret canis," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/6/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/6> ;
      zoo:text "Quid hoc? sacratae vatis horrescunt comae," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Maritus quidam cum diligeret coniugem" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9/text/23>
      a       zoo:Paragraph ;
      zoo:identifier 23 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/9> ;
      zoo:text "Stramenta desunt? Tollere haec aranea" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8/text/26>
      a       zoo:Paragraph ;
      zoo:identifier 26 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8> ;
      zoo:text "Non plane est inquit. Fruere, quae laudas, canis:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/12/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/12> ;
      zoo:text "Ignotos fallit, notis est derisui." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/7/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/7> ;
      zoo:text "Aegre recepti tamen evaserunt necem." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/19/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/19> ;
      zoo:text "Lacrimis obortis: Ite felices ait;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/13/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/13> ;
      zoo:text "Cum gratulantes persalutasset deos," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21/text/18>
      a       zoo:Paragraph ;
      zoo:identifier 18 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21> ;
      zoo:text "Antiqua fuit urbs, quam petierunt naufragi." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6/text/17>
      a       zoo:Paragraph ;
      zoo:identifier 17 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6> ;
      zoo:text "Et sic porcelli vocem est imitatus sua," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/19/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/19> ;
      zoo:text "Tibi forma, vires aquilae, luscinio melos," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/19/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/19> ;
      zoo:text "Augurium corvo, laeva cornici omina," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/10/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/10> ;
      zoo:text "Devenit hircus sitiens in eundem locum;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/7/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/7> ;
      zoo:text "Si vero accessit consiliator maleficus," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/5/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/5> ;
      zoo:text "Pertusa nec complere possunt dolia;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/14/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/14> ;
      zoo:text "Tunc demum ingemuit corvi deceptus stupor." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/12/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/12> ;
      zoo:text "Virtutis expers, verbis iactans gloriam," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/7/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/7> ;
      zoo:text "Duces eorum, qui capitibus cornua" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/19/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/19> ;
      zoo:text "Celebrate sine me cursu sollemnem diem;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/13/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/13> ;
      zoo:text "Veniente Pluto, qui Fortunae est filius," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6/text/18>
      a       zoo:Paragraph ;
      zoo:identifier 18 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6> ;
      zoo:text "Verum ut subesse pallio contenderent" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21/text/17>
      a       zoo:Paragraph ;
      zoo:identifier 17 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21> ;
      zoo:text "Nudos relinquunt. Forte Clazomenae prope" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/19/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/19> ;
      zoo:text "Omnesque propriis sunt contentae dotibus." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/10/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/10> ;
      zoo:text "Et altiore clauderetur margine," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/14/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/14> ;
      zoo:text "Hac re probatur quantum ingenium valet;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/27/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/27> ;
      zoo:text "Quae cum lagonae collum frustra lamberet," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/5/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/5> ;
      zoo:text "Immo luxuriae quicquid dederis perfluet." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/7/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/7> ;
      zoo:text "Vis et nequitia quicquid oppugnant, ruit." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/13/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/13> ;
      zoo:text "Avertit oculos. Causam quaesivit pater." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/12/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/12> ;
      zoo:text "Asinus iacentem vidit in prato lyram." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/7/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/7> ;
      zoo:text "Suis ligarant, ut conspicuum in proelio" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/19/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/19> ;
      zoo:text "Ego quo scelesta furis attraxit manus," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/31/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/31> ;
      zoo:text "Paludis in secreta veniet latibula" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/10/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/10> ;
      zoo:text "Descende, amice; tanta bonitas est aquae" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/6/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/6> ;
      zoo:text "Comprensus namque poenas persolvit cruce." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6/text/15>
      a       zoo:Paragraph ;
      zoo:identifier 15 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6> ;
      zoo:text "Silentium ipsa fecit exspectatio." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/12/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/12> ;
      zoo:text "Contexit illum frutice et admonuit simul," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/19/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/19> ;
      zoo:text "Noli affectare quod tibi non est datum," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/9/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/9> ;
      zoo:text "Quia per gallinam denotarit feminas." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/31/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/31> ;
      zoo:text "Expulsus regno nemoris qui profugerit," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/14/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/14> ;
      zoo:text "Virtute semper praevalet sapientia." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13/text/29>
      a       zoo:Paragraph ;
      zoo:identifier 29 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13> ;
      zoo:text "Virique corpus tradit figendum cruci," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/13/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/13> ;
      zoo:text "Odi inquit illum, quia malis amicus est" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/12/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/12> ;
      zoo:text "Venari asello comite cum vellet leo," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/2/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/2> ;
      zoo:text "Ad rivum eundem lupus et agnus venerant" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/19/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/19> ;
      zoo:text "Ibi sorte tristi fata deflebo mea." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/3/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/3> ;
      zoo:text "Canos puella, nigros anus evellerat." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21/text/19>
      a       zoo:Paragraph ;
      zoo:identifier 19 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21> ;
      zoo:text "Hic litterarum quidam studio deditus," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/10/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/10> ;
      zoo:text "Et copiosus. Illa fraudem moliens:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6/text/16>
      a       zoo:Paragraph ;
      zoo:identifier 16 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6> ;
      zoo:text "Ille in sinum repente demisit caput" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/19/text/15>
      a       zoo:Paragraph ;
      zoo:identifier 15 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/19> ;
      zoo:text "Delusa ne spes ad querelam reccidat." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/9/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/9> ;
      zoo:text "Risisse Iuno dicitur Veneris iocos," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/10/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/10> ;
      zoo:text "Simul rogavit esset an dulcis liquor" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/31/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/31> ;
      zoo:text "Est statio separata ac diversum genus;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/7/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/7> ;
      zoo:text "Contra potentes nemo est munitus satis;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/5/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/5> ;
      zoo:text "Urnis scelestas Danaides portant aquas," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/7/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/7> ;
      zoo:text "Haberent signum quod sequerentur milites," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6> ;
      zoo:text "In scaena vero postquam solus constitit" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/2/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/2> ;
      zoo:text "Siti compulsi; superior stabat lupus" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/7/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/7> ;
      zoo:text "Nec ullo pacto laedi posset condita," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/15/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/15> ;
      zoo:text "Aesopus turpi cum serviret feminae," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/19/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/19> ;
      zoo:text "Abegit quidam et in pistrinum vendidit." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/12/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/12> ;
      zoo:text "Fugientes ipse exciperet. Hic auritulus" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/3/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/3> ;
      zoo:text "Constantior fuissem vera existimans." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/10/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/10> ;
      zoo:text "Homo in periclum simul ac venit callidus," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/31/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/31> ;
      zoo:text "Sed haec simpliciter; illa tacite irascitur." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/17/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/17> ;
      zoo:text "Citati non respondent. Vix tandem invenit" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/5/text/15>
      a       zoo:Paragraph ;
      zoo:identifier 15 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/5> ;
      zoo:text "Quo quis maiorem possidet terrae locum," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/15/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/15> ;
      zoo:text "Et obiurgari iussit servum garrulum." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/7/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/7> ;
      zoo:text "Haesere in portis suntque capti ab hostibus;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13/text/27>
      a       zoo:Paragraph ;
      zoo:identifier 27 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13> ;
      zoo:text "Turbatus miles factum exponit mulieri." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/2/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/2> ;
      zoo:text "Longeque inferior agnus. Tunc fauce improba" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/7/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/7> ;
      zoo:text "Venit per auras cornix et propter volans:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/19/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/19> ;
      zoo:text "Productus ad bibendum cum foret a molis," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/13/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/13> ;
      zoo:text "Opes invisae merito sunt forti viro," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/3/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/3> ;
      zoo:text "Vellem istis verbis saltem adiuvisses modo;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6> ;
      zoo:text "Sine apparatu, nullis adiutoribus," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/12/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/12> ;
      zoo:text "Ut insueta voce terreret feras," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/17/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/17> ;
      zoo:text "Eos Mercurius et turbatos attrahit." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/31/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/31> ;
      zoo:text "Nequitia pariter laudat et frugalitas," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/3/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/3> ;
      zoo:text "Ioculare tibi videtur, et sane levi," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/5/text/16>
      a       zoo:Paragraph ;
      zoo:identifier 16 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/5> ;
      zoo:text "Hoc demonstratur cura graviore affici." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/7/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/7> ;
      zoo:text "Quos immolatos victor avidis dentibus" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13/text/28>
      a       zoo:Paragraph ;
      zoo:identifier 28 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13> ;
      zoo:text "At sancta mulier: Non est quod timeas, ait," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6> ;
      zoo:text "Dispersus rumor civitatem concitat." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/17/text/19>
      a       zoo:Paragraph ;
      zoo:identifier 19 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/17> ;
      zoo:text "Odore canibus anum, sed multo, replent." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/13/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/13> ;
      zoo:text "Quia dives arca veram laudem intercipit." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/2/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/2> ;
      zoo:text "Latro incitatus iurgii causam intulit." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/18/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/18> ;
      zoo:text "Nisi utile est quod facimus, stulta est gloria." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/19/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/19> ;
      zoo:text "In circum aequales ire conspexit suos," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/12/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/12> ;
      zoo:text "Novoque turbat bestias miraculo." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/5/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/5> ;
      zoo:text "Nam fodere terram quod vides cotidie" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/3/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/3> ;
      zoo:text "Quos attentarit. Tunc, qui depugnaverat:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/3/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/3> ;
      zoo:text "Dum nihil habemus maius, calamo ludimus." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/31/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/31> ;
      zoo:text "Hoc qualecumque est Musa quod ludit mea," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/2/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/2> ;
      zoo:text "Audacter tolle. Tunc diviso tergore" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/10/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/10> ;
      zoo:text "Cum decidisset vulpes in puteum inscia" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13/text/25>
      a       zoo:Paragraph ;
      zoo:identifier 25 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13> ;
      zoo:text "Hic dum consumit noctes custos diligens," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/18/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/18> ;
      zoo:text "Nihil agere quod non prosit fabella admonet." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/7/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/7> ;
      zoo:text "Aquila in sublime sustulit testudinem." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/5/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/5> ;
      zoo:text "Novem porrectus Tityos est per iugera," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/27/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/27> ;
      zoo:text "Peregrinam sic locutam volucrem accepimus:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/14/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/14> ;
      zoo:text "Emisit ore caseum, quem celeriter" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/14/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/14> ;
      zoo:text "Apes in alta fecerant quercu favos:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6> ;
      zoo:text "Paulo ante vacua turbam deficiunt loca." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/17/text/18>
      a       zoo:Paragraph ;
      zoo:identifier 18 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/17> ;
      zoo:text "Timentes rursus aliquid ne simile accidat," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/13/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/13> ;
      zoo:text "Caelo receptus propter virtutem Hercules" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/7/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/7> ;
      zoo:text "Quae cum abdidisset cornea corpus domo" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/2/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/2> ;
      zoo:text "Cur, inquit, turbulentam fecisti mihi" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/5/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/5> ;
      zoo:text "Aprum insidiosum, quercum vult evertere," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/19/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/19> ;
      zoo:text "Ut grata ludis redderent certamina." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/3/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/3> ;
      zoo:text "Cedo inquit illum; iam curabo sentiat," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/12/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/12> ;
      zoo:text "Clamorem subito totis tollit viribus" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/3/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/3> ;
      zoo:text "Sed diligenter intuere has nenias:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/10/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/10> ;
      zoo:text "Reperire effugium quaerit alterius malo." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/2/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/2> ;
      zoo:text "Et, quae debetur pars tuae modestiae," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/5/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/5> ;
      zoo:text "Tristi renatum suggerens poenae iecur;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13/text/26>
      a       zoo:Paragraph ;
      zoo:identifier 26 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13> ;
      zoo:text "Desideratum est corpus ex una cruce." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/27/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/27> ;
      zoo:text "Sua quisque exempla debet aequo animo pati." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/14/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/14> ;
      zoo:text "Dolosa vulpes avidis rapuit dentibus." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/14/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/14> ;
      zoo:text "Hos fuci inertes esse dicebant suos." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21> ;
      zoo:text "Simul et vetustas medio dissolvit mari." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/17/text/17>
      a       zoo:Paragraph ;
      zoo:identifier 17 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/17> ;
      zoo:text "Rumor legatos superiores prodidit." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/41>
      a       zoo:Paragraph ;
      zoo:identifier 41 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Quod si accusator alius Seiano foret," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/3/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/3> ;
      zoo:text "Abiturus et iam limen excedens ait:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/2/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/2> ;
      zoo:text "Aquam bibenti? Laniger contra timens:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/18/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/18> ;
      zoo:text "Tunc sic deorum genitor atque hominum sator:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/3/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/3> ;
      zoo:text "Stringitque gladium, dein reiecta paenula:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/5/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/5> ;
      zoo:text "Ad nidum scandit volucris: Pernicies ait" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/17/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/17> ;
      zoo:text "Plerumque poenas oppetit superbiae." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/31/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/31> ;
      zoo:text "Ita caput ad nostrum furor illorum pertinet." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/20/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/20> ;
      zoo:text "Tandemque invenit ubi lucernam accenderet." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/15/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/15> ;
      zoo:text "Miscere illius antidoto se toxicum," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/5/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/5> ;
      zoo:text "Aliamque praedam ab altero ferri putans" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/7/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/7> ;
      zoo:text "Promissa parte suadet, ut scopulum super" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/10/text/15>
      a       zoo:Paragraph ;
      zoo:identifier 15 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/10> ;
      zoo:text "Sin autem doctus illis occurrit labor," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/15/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/15> ;
      zoo:text "Proponit gravia, verum si non dixerint." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13/text/23>
      a       zoo:Paragraph ;
      zoo:identifier 23 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13> ;
      zoo:text "Paulatim facta est advenae submissior;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/14/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/14> ;
      zoo:text "Lis ad forum deducta est, vespa iudice." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6> ;
      zoo:text "Quod in theatro numquam prolatum foret." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/17/text/16>
      a       zoo:Paragraph ;
      zoo:identifier 16 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/17> ;
      zoo:text "Post aliquod tempus alios ascribi iubent." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/12/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/12> ;
      zoo:text "Divinis aures oblectasset cantibus." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/18/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/18> ;
      zoo:text "O nata, merito sapiens dicere omnibus!" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/42>
      a       zoo:Paragraph ;
      zoo:identifier 42 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Si testis alius, iudex alius denique," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/3/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/3> ;
      zoo:text "Deum videtis; tribuam vobis protinus" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/3/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/3> ;
      zoo:text "Latrone exciso timidus accurrit comes" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/2/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/2> ;
      zoo:text "Qui possum, quaeso, facere, quod quereris, lupe?" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/5/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/5> ;
      zoo:text "Tibi paratur, forsan et miserae mihi;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/12/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/12> ;
      zoo:text "Quae dum paventes exitus notos petunt," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/20/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/20> ;
      zoo:text "Tum circumeunti fuerat quod iter longius" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/17/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/17> ;
      zoo:text "Humanitati qui se non accommodat," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/5/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/5> ;
      zoo:text "Eripere voluit; verum decepta aviditas" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/15/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/15> ;
      zoo:text "Scyphum poposcit: fusa dein simulans aqua" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/10/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/10> ;
      zoo:text "Omnem querelam submovet felicitas." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/14/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/14> ;
      zoo:text "Quae genus utrumque nosset cum pulcherrime," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/7/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/7> ;
      zoo:text "Altis ab astris duram illidat corticem," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/15/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/15> ;
      zoo:text "Furore plena vocat omnes et verbera" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13/text/24>
      a       zoo:Paragraph ;
      zoo:identifier 24 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13> ;
      zoo:text "Mox artior revinxit animum copula." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/12/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/12> ;
      zoo:text "Sic saepe ingenia calamitate intercidunt." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/17/text/15>
      a       zoo:Paragraph ;
      zoo:identifier 15 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/17> ;
      zoo:text "Turpe aestimantes aliquid commissum a suis," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21> ;
      zoo:text "Subsidium vitae. Quidam curiosior:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/43>
      a       zoo:Paragraph ;
      zoo:identifier 43 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Dignum faterer esse me tantis malis," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/7/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/7> ;
      zoo:text "Opimam sane praedam rapuisti unguibus;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/2/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/2> ;
      zoo:text "A te decurrit ad meos haustus liquor." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/20/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/20> ;
      zoo:text "Parare cenam iussus est maturius." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/5/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/5> ;
      zoo:text "Tum fortuitum feles contubernium" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/10/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/10> ;
      zoo:text "Et arte fictas animus sentit fabulas," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/5/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/5> ;
      zoo:text "Canis per flumen carnem cum ferret natans," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/14/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/14> ;
      zoo:text "Legem duabus hanc proposuit partibus:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6/text/21>
      a       zoo:Paragraph ;
      zoo:identifier 21 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6> ;
      zoo:text "Seponit moechae vestem, mundum muliebrem," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/7/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/7> ;
      zoo:text "Qua comminuta facile vescatur cibo." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/15/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/15> ;
      zoo:text "Eam non apparere ut dictum est mulieri," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13/text/21>
      a       zoo:Paragraph ;
      zoo:identifier 21 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13> ;
      zoo:text "Per quas videre possit illam saepius." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/3/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/3> ;
      zoo:text "Et vindicavit sese forti dextera." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/3/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/3> ;
      zoo:text "Quaestus placebat alteri meretricius." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/15/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/15> ;
      zoo:text "Rex urbis, eius experiendi gratia" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/17/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/17> ;
      zoo:text "Mirati sibi legatos non revertier," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21> ;
      zoo:text "Hi zonas, illi res pretiosas colligunt," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/7/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/7> ;
      zoo:text "Sed nisi monstraro quid sit faciendum tibi," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/3/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/3> ;
      zoo:text "Ergo ut referret gratiam officiis parem," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/44>
      a       zoo:Paragraph ;
      zoo:identifier 44 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Nec his dolorem delenirem remediis." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/2/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/2> ;
      zoo:text "Repulsus ille veritatis viribus:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/5/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/5> ;
      zoo:text "Fraude et scelesta sic evertit malitia." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/20/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/20> ;
      zoo:text "Ignem ergo quaerens aliquot lustravit domus," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/14/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/14> ;
      zoo:text "Non inconveniens corpus et par est color," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/10/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/10> ;
      zoo:text "Si nostrum studium ad aures pervenit tuas" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/5/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/5> ;
      zoo:text "Lympharum in speculo vidit simulacrum suum," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/15/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/15> ;
      zoo:text "Post paulo armillam tollit fur argenteam." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6/text/20>
      a       zoo:Paragraph ;
      zoo:identifier 20 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6> ;
      zoo:text "Fidem advocavit iure neglecto parens." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/3/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/3> ;
      zoo:text "Unus profugit, alter autem restitit" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13/text/22>
      a       zoo:Paragraph ;
      zoo:identifier 22 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13> ;
      zoo:text "Cotidiana capta consuetudine" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/7/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/7> ;
      zoo:text "Inducta verbis aquila, monitis paruit," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/17/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/17> ;
      zoo:text "Vetat dimitti magnus illos Iuppiter." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/15/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/15> ;
      zoo:text "Hic cum iaceret morbo confectus gravi" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/12/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/12> ;
      zoo:text "Sonuere tactae. Bella res sed mehercules" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/45>
      a       zoo:Paragraph ;
      zoo:identifier 45 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Suspicione si quis errabit sua" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21> ;
      zoo:text "Mecum inquit mea sunt cuncta. Tunc pauci enatant," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24> ;
      zoo:text "Auctoritatem similis referens gloriae." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/20/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/20> ;
      zoo:text "Hominem inquit quaero, et abiit festinans domum." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/5/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/5> ;
      zoo:text "Feles cavernam nancta in media pepererat;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/14/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/14> ;
      zoo:text "In dubium plane res ut merito venerit." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6/text/23>
      a       zoo:Paragraph ;
      zoo:identifier 23 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6> ;
      zoo:text "Lanificae agellos, pecora, villam, operarios," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/3/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/3> ;
      zoo:text "Duo cum incidissent in latronem milites," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/7/text/15>
      a       zoo:Paragraph ;
      zoo:identifier 15 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/7> ;
      zoo:text "Simul et magistrae large divisit dapem." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/46>
      a       zoo:Paragraph ;
      zoo:identifier 46 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Et rapiet ad se quod erit commune omnium," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/3/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/3> ;
      zoo:text "Illiberali et sordido receperant:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/15/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/15> ;
      zoo:text "Verbosis acquisivit sibi famam strophis." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/17/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/17> ;
      zoo:text "Propulsi vero fustibus vadunt foras." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/10/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/10> ;
      zoo:text "Non tamen eripiet laudis conscientiam." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24> ;
      zoo:text "Opus approbavit; sed mercedis tertiam" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21> ;
      zoo:text "Simonide, tu ex opibus nil sumis tuis?" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/12/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/12> ;
      zoo:text "Accessit et temptavit chordas ungula;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/10/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/10> ;
      zoo:text "Voluptas ut satiari non possit mea." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/5/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/5> ;
      zoo:text "Amittit merito proprium qui alienum adpetit." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/5/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/5> ;
      zoo:text "Sus nemoris cultrix fetum ad imam posuerat." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6/text/22>
      a       zoo:Paragraph ;
      zoo:identifier 22 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6> ;
      zoo:text "Lavationem argenteam, eunuchos, glabros;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13/text/20>
      a       zoo:Paragraph ;
      zoo:identifier 20 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13> ;
      zoo:text "Sollers acumen mille causas invenit," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/14/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/14> ;
      zoo:text "Sed ne religio peccet imprudens mea," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/47>
      a       zoo:Paragraph ;
      zoo:identifier 47 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Stulte nudabit animi conscientiam." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/7/text/16>
      a       zoo:Paragraph ;
      zoo:identifier 16 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/7> ;
      zoo:text "Sic tuta quae naturae fuerat munere," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/3/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/3> ;
      zoo:text "Quarum una in cunis parvum habebat filium," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/17/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/17> ;
      zoo:text "Totam timentes concacarunt regiam;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/15/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/15> ;
      zoo:text "Et venditaret falso antidotum nomine," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/10/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/10> ;
      zoo:text "Si livor obtrectare curam voluerit," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/12/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/12> ;
      zoo:text "Si repperisset aliquis hanc prudentior," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24> ;
      zoo:text "Accepit partem. Cum reliquum posceret:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/20/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/20> ;
      zoo:text "Effecit brevius: namque recta per forum" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21/text/16>
      a       zoo:Paragraph ;
      zoo:identifier 16 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21> ;
      zoo:text "Praedones adsunt, rapiunt, quod quisque extulit," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/15/text/16>
      a       zoo:Paragraph ;
      zoo:identifier 16 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/15> ;
      zoo:text "Flagris sum caesus, verum quia dixi modo." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6/text/25>
      a       zoo:Paragraph ;
      zoo:identifier 25 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6> ;
      zoo:text "Potrici plenam antiquis apothecam cadis," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/20/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/20> ;
      zoo:text "Coepit redire. Et quidam e turba garrulus:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3/text/20>
      a       zoo:Paragraph ;
      zoo:identifier 20 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3> ;
      zoo:text "Lignumque supera turba petulans insilit." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/14/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/14> ;
      zoo:text "Alvos accipite et ceris opus infundite," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/7/text/17>
      a       zoo:Paragraph ;
      zoo:identifier 17 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/7> ;
      zoo:text "Impar duabus occidit tristi nece." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/48>
      a       zoo:Paragraph ;
      zoo:identifier 48 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Huic excusatum me velim nihilo minus:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/15/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/15> ;
      zoo:text "Medicinam ignoto facere coepisset loco" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/17/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/17> ;
      zoo:text "Tum vero vultum magni ut viderunt Iovis," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24> ;
      zoo:text "Illi inquit reddent quorum sunt laudis duae." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/12/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/12> ;
      zoo:text "Male cessit inquit artis quia sum nescius." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21/text/15>
      a       zoo:Paragraph ;
      zoo:identifier 15 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21> ;
      zoo:text "Quia plures onere degravati perierant." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/31/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/31> ;
      zoo:text "Et proculcatas obteret duro pede." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/5/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/5> ;
      zoo:text "Aquila in sublimi quercu nidum fecerat;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/15/text/15>
      a       zoo:Paragraph ;
      zoo:identifier 15 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/15> ;
      zoo:text "Aliis minare inquit me non falles, era;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6/text/24>
      a       zoo:Paragraph ;
      zoo:identifier 24 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6> ;
      zoo:text "Boves, iumenta et instrumentum rusticum;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/20/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/20> ;
      zoo:text "Aesope, medio sole quid cum lumine?" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/3/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/3> ;
      zoo:text "Mercurium hospitio mulieres olim duae" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/49>
      a       zoo:Paragraph ;
      zoo:identifier 49 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Neque enim notare singulos mens est mihi," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/15/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/15> ;
      zoo:text "Malus cum sutor inopia deperditus" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/5/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/5> ;
      zoo:text "Volubilem Fortunam iactari docet." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/3/text/16>
      a       zoo:Paragraph ;
      zoo:identifier 16 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/3> ;
      zoo:text "Damnum haud recusant, tantum pro vita rogant." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/29>
      a       zoo:Paragraph ;
      zoo:identifier 29 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Lucerna allata, simul aspexit filium" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/1/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/1> ;
      zoo:text "Et quod prudenti vitam consilio monet." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/22/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/22> ;
      zoo:text "At ille murem peperit. †Hoc scriptum est tibi," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24> ;
      zoo:text "Verum ut ne irate te dimissum sentiant," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8/text/30>
      a       zoo:Paragraph ;
      zoo:identifier 30 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8> ;
      zoo:text "Corona, miles, equidem te dono libens," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/28/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/28> ;
      zoo:text "Fame est consumptus; quem stans vulturius super" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/11/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/11> ;
      zoo:text "Dixisse fertur simius sententiam:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/7/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/7> ;
      zoo:text "Superum voluntas favit; sed fato invido" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21> ;
      zoo:text "Quamvis materiae tanta abundet copia," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/17/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/17> ;
      zoo:text "Lupo sponsore. At illa praemetuens dolum:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/7/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/7> ;
      zoo:text "Vicini furis celebres vidit nuptias" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3/text/22>
      a       zoo:Paragraph ;
      zoo:identifier 22 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3> ;
      zoo:text "Alium rogantes regem misere ad Iovem," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/1/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/1> ;
      zoo:text "Adeo fucatae plus vetustati favet" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/13/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/13> ;
      zoo:text "In sterquilino pullus gallinaceus" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8> ;
      zoo:text "Magni Pompei miles vasti corporis" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8/text/15>
      a       zoo:Paragraph ;
      zoo:identifier 15 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8> ;
      zoo:text "Veni ergo mecum. Dum procedunt, aspicit" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/3/text/17>
      a       zoo:Paragraph ;
      zoo:identifier 17 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/3> ;
      zoo:text "At illa: Memini qui me saxo petierit," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/1/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/1> ;
      zoo:text "Calumniari si quis autem voluerit," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24/text/15>
      a       zoo:Paragraph ;
      zoo:identifier 15 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24> ;
      zoo:text "Ad cenam mihi promitte; cognatos volo" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/22/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/22> ;
      zoo:text "Qui, magna cum minaris, extricas nihil." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/11/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/11> ;
      zoo:text "Uterque causam cum perorassent suam," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/5/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/5> ;
      zoo:text "Adversus altos Sisyphus montes agit" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8/text/31>
      a       zoo:Paragraph ;
      zoo:identifier 31 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8> ;
      zoo:text "Quia vindicasti laudem Romani imperi;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/28/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/28> ;
      zoo:text "Fertur locutus: O canis, merito iaces," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/7/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/7> ;
      zoo:text "Ostendit ille praedam et adiecit simul:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21> ;
      zoo:text "Brevitati nostrae praemium ut reddas peto" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21> ;
      zoo:text "Labori faber ut desit, non fabro labor." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/17/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/17> ;
      zoo:text "Ovem rogabat cervus modium tritici" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3/text/21>
      a       zoo:Paragraph ;
      zoo:identifier 21 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3> ;
      zoo:text "Quod cum inquinassent omni contumelia," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/1/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/1> ;
      zoo:text "Invidia mordax quam bonis praesentibus." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/13/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/13> ;
      zoo:text "Dum quaerit escam, margaritam repperit." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8/text/16>
      a       zoo:Paragraph ;
      zoo:identifier 16 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8> ;
      zoo:text "Lupus a catena collum detritum cani." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/1/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/1> ;
      zoo:text "Hanc ego polivi versibus senariis." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/27>
      a       zoo:Paragraph ;
      zoo:identifier 27 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Ut sentit tonsum, gladio pectus transigit," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/11/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/11> ;
      zoo:text "Tunc iudex inter illos sedit simius." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/3/text/18>
      a       zoo:Paragraph ;
      zoo:identifier 18 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/3> ;
      zoo:text "Qui panem dederit; vos timere absistite;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24/text/16>
      a       zoo:Paragraph ;
      zoo:identifier 16 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24> ;
      zoo:text "Hodie invitare, quorum es in numero mihi." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/25/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/25> ;
      zoo:text "Quis maior esset. Illi dixerunt bovem." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8/text/32>
      a       zoo:Paragraph ;
      zoo:identifier 32 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8> ;
      zoo:text "Sed exstillescant oculi sic inquit mei," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3/text/25>
      a       zoo:Paragraph ;
      zoo:identifier 25 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3> ;
      zoo:text "Corripere coepit singulas. Frustra necem" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/7/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/7> ;
      zoo:text "Heia! inquit in commune quodcumque est lucri!" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21> ;
      zoo:text "Quod es pollicitus: exhibe vocis fidem." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/17/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/17> ;
      zoo:text "Non rem expedire, sed mala videre expetit." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8> ;
      zoo:text "Famam cinaedi traxerat certissimam." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/1/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/1> ;
      zoo:text "Si marmori ascripserunt Praxitelen suo," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/29/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/29> ;
      zoo:text "Non qui fuerimus, sed qui nunc simus vide." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/4/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/4> ;
      zoo:text "Illum esse quamvis dignum poena iudico." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8/text/17>
      a       zoo:Paragraph ;
      zoo:identifier 17 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8> ;
      zoo:text "Unde hoc, amice? Nihil est. Dic sodes tamen." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/11/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/11> ;
      zoo:text "Negabat illa se esse culpae proximam." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/1/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/1> ;
      zoo:text "Duplex libelli dos est: quod risum movet" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/28>
      a       zoo:Paragraph ;
      zoo:identifier 28 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Nihil respiciens, dum dolorem vindicet." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/5/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/5> ;
      zoo:text "Ixion quod versari narratur rota," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/25/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/25> ;
      zoo:text "Novissime indignata dum vult validius" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24/text/17>
      a       zoo:Paragraph ;
      zoo:identifier 17 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24> ;
      zoo:text "Fraudatus quamvis et dolens iniuria," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3/text/24>
      a       zoo:Paragraph ;
      zoo:identifier 24 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3> ;
      zoo:text "Tum misit illis hydrum, qui dente aspero" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8/text/33>
      a       zoo:Paragraph ;
      zoo:identifier 33 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8> ;
      zoo:text "Turpe illud imitans ius iurandum militis," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/7/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/7> ;
      zoo:text "Accessit alter aeque defectus pilis." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/3/text/19>
      a       zoo:Paragraph ;
      zoo:identifier 19 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/3> ;
      zoo:text "Illis revertor hostis, qui me laeserunt." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/17/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/17> ;
      zoo:text "Fraudator homines cum advocat sponsum improbos," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/2/text/15>
      a       zoo:Paragraph ;
      zoo:identifier 15 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/2> ;
      zoo:text "Qui fictis causis innocentes opprimunt." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/1/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/1> ;
      zoo:text "Trito Myronem argento, tabulae Zeuxidem." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8> ;
      zoo:text "Fracte loquendo et ambulando molliter" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3/text/23>
      a       zoo:Paragraph ;
      zoo:identifier 23 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3> ;
      zoo:text "Inutilis quoniam esset qui fuerat datus." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8/text/18>
      a       zoo:Paragraph ;
      zoo:identifier 18 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8> ;
      zoo:text "Quia videor acer, alligant me interdiu," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8/text/29>
      a       zoo:Paragraph ;
      zoo:identifier 29 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8> ;
      zoo:text "Tibicen: gratulari fautores putat." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/11/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/11> ;
      zoo:text "Lupus arguebat vulpem furti crimine;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/3/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/3> ;
      zoo:text "Paucis diebus interpositis provolat," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/5/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/5> ;
      zoo:text "Ostendit hominum sine fine esse miserias." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/19/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/19> ;
      zoo:text "Cantus luscinii quod sibi non tribuerit;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/25>
      a       zoo:Paragraph ;
      zoo:identifier 25 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Irae furentis impetum non sustinens" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24/text/18>
      a       zoo:Paragraph ;
      zoo:identifier 18 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24> ;
      zoo:text "Ne male dimissam gratiam corrumperet," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/7/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/7> ;
      zoo:text "Convicio permotus quaerit Iuppiter" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8/text/34>
      a       zoo:Paragraph ;
      zoo:identifier 34 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8> ;
      zoo:text "Nisi tu abstulisti sarcinas nuper meas." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/9/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/9> ;
      zoo:text "Haec cum temptaret si qua res esset cibi," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3/text/27>
      a       zoo:Paragraph ;
      zoo:identifier 27 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3> ;
      zoo:text "Furtim igitur dant Mercurio mandata ad Iovem," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/2/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/2> ;
      zoo:text "Atque ita correptum lacerat iniusta nece." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/7/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/7> ;
      zoo:text "Invenit calvus forte in trivio pectinem." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/2/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/2> ;
      zoo:text "Haec propter illos scripta est homines fabula," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21> ;
      zoo:text "Primum ne videar esse tibi molestior," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8> ;
      zoo:text "Cum veste et auro et magno argenti pondere" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24/text/19>
      a       zoo:Paragraph ;
      zoo:identifier 19 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24> ;
      zoo:text "Promisit. Rediit hora dicta, recubuit." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8/text/19>
      a       zoo:Paragraph ;
      zoo:identifier 19 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8> ;
      zoo:text "Luce ut quiescam et vigilem, nox cum venerit:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/17/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/17> ;
      zoo:text "Sonare citharam quos putes Apollinis," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/11/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/11> ;
      zoo:text "Hoc attestatur brevis Aesopi fabula." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/19/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/19> ;
      zoo:text "Pavo ad Iunonem venit, indigne ferens" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/1/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/1> ;
      zoo:text "Aesopus auctor quam materiam repperit," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/26>
      a       zoo:Paragraph ;
      zoo:identifier 26 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Ad lectum vadit, temptat in tenebris caput." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/3/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/3> ;
      zoo:text "Pecus trucidat, ipsos pastores necat," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/7/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/7> ;
      zoo:text "Clamorem ranae sustulere ad sidera." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3/text/26>
      a       zoo:Paragraph ;
      zoo:identifier 26 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3> ;
      zoo:text "Fugitant inertes, vocem praecludit metus." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/2/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/2> ;
      zoo:text "Pater hercle tuus, ille inquit, male dixit mihi." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/9/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/9> ;
      zoo:text "Limam momordit. Illa contra contumax:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21> ;
      zoo:text "Distringit quem multarum rerum varietas;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/17/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/17> ;
      zoo:text "Ubi vos requiram cum dies advenerit?" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8> ;
      zoo:text "Hic insidiatus nocte iumentis ducis," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/5/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/5> ;
      zoo:text "Quod stans in amne Tantalus medio sitit," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/17/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/17> ;
      zoo:text "Dormire quia me non sinunt cantus tui," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/22/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/22> ;
      zoo:text "Mons parturibat, gemitus immanes ciens," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/23>
      a       zoo:Paragraph ;
      zoo:identifier 23 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Aetatem adultam servans diligentius." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/3/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/3> ;
      zoo:text "Et cuncta vastans saevit irato impetu." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/5/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/5> ;
      zoo:text "Saxum labore summo, quod de vertice" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/29/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/29> ;
      zoo:text "Et vespa dignam moribus vocem edidit:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3/text/29>
      a       zoo:Paragraph ;
      zoo:identifier 29 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3> ;
      zoo:text "Quia noluistis vestrum ferre inquit bonum," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/11/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/11> ;
      zoo:text "Etiam si verum dicit, amittit fidem." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/9/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/9> ;
      zoo:text "Quid me inquit stulta, dente captas laedere," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/2/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/2> ;
      zoo:text "Respondit agnus: Equidem natus non eram." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8> ;
      zoo:text "Arguitur miles, rapitur in praetorium." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21> ;
      zoo:text "Dein si quis eadem forte conari velit," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/17/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/17> ;
      zoo:text "Tu de conspectu fugere veloci impetu;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/7/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/7> ;
      zoo:text "Uxorem quondam Sol cum vellet ducere," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/17/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/17> ;
      zoo:text "Hac est aggressa garrulam fallacia:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/3/text/15>
      a       zoo:Paragraph ;
      zoo:identifier 15 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/3> ;
      zoo:text "Tum sibi timentes, qui ferae pepercerant," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/22/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/22> ;
      zoo:text "Eratque in terris maxima exspectatio." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/40>
      a       zoo:Paragraph ;
      zoo:identifier 40 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "In calamitatem deligens quaedam meam." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/24>
      a       zoo:Paragraph ;
      zoo:identifier 24 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Dum quaerunt lumen, dum concursant familia," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/5/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/5> ;
      zoo:text "Sudore semper irrito revolvitur," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/11/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/11> ;
      zoo:text "Quicumque turpi fraude semel innotuit," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/9/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/9> ;
      zoo:text "Omne assuevi ferrum quae corrodere?" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3/text/28>
      a       zoo:Paragraph ;
      zoo:identifier 28 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3> ;
      zoo:text "Afflictis ut succurrat. Tunc contra deus:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/2/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/2> ;
      zoo:text "Ante hos sex menses male, ait, dixisti mihi." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8> ;
      zoo:text "Avertit mulos. Factum rumor dissipat;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21> ;
      zoo:text "Habere ut possit aliquid operis residui:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/17/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/17> ;
      zoo:text "Rapere atque abire semper assuevit lupus," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/7/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/7> ;
      zoo:text "Aesopus et continuo narrare incipit:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/10/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/10> ;
      zoo:text "Paterfamilias saevum habebat filium." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21/text/34>
      a       zoo:Paragraph ;
      zoo:identifier 34 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21> ;
      zoo:text "Palam muttire plebeio piaculum est," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/8/text/21>
      a       zoo:Paragraph ;
      zoo:identifier 21 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/8> ;
      zoo:text "Quid ergo possum facere tibi, lector Cato," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/4/text/21>
      a       zoo:Paragraph ;
      zoo:identifier 21 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/4> ;
      zoo:text "Mendacium appellatum est; quod negantibus" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/1/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/1> ;
      zoo:text "Sed iam ad fabellam talis exempli feror." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/21>
      a       zoo:Paragraph ;
      zoo:identifier 21 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Intravit, recta cubiculum uxoris petens," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/15/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/15> ;
      zoo:text "Licetne paucis? inquit—Dicas.—Censeo," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/25/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/25> ;
      zoo:text "In prato quondam rana conspexit bovem" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/3/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/3> ;
      zoo:text "Quantam sub titulis utilitatem reperies!" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8> ;
      zoo:text "Spoliare es ausus? Ille continuo exscreat" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/6/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/6> ;
      zoo:text "Successus ad perniciem multos devocat." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19> ;
      zoo:text "Respondeas clementer. Quem fructum capis" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/10/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/10> ;
      zoo:text "Hic e conspectu cum patris recesserat," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/4/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/4> ;
      zoo:text "Contentus nostris si fuisses sedibus" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/8/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/8> ;
      zoo:text "Ille onere dives celsa cervice eminens" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/8/text/20>
      a       zoo:Paragraph ;
      zoo:identifier 20 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/8> ;
      zoo:text "Iustoque vindicavit exemplo impetum." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21/text/33>
      a       zoo:Paragraph ;
      zoo:identifier 33 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21> ;
      zoo:text "Ego, quondam legi quam puer sententiam," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/4/text/20>
      a       zoo:Paragraph ;
      zoo:identifier 20 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/4> ;
      zoo:text "Tunc falsa imago atque operis furtivi labor" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/15/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/15> ;
      zoo:text "Nec inveniret digito qui se tangeret:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/25/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/25> ;
      zoo:text "Et tacta invidia tantae magnitudinis" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/22>
      a       zoo:Paragraph ;
      zoo:identifier 22 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "In quo dormire mater natum iusserat," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/1/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/1> ;
      zoo:text "Aesopi nomen sicubi interposuero," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/3/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/3> ;
      zoo:text "Non semper ea sunt quae videntur; decipit" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/8> ;
      zoo:text "Tum Magnus: Quid ais? tune me, commilito," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/10/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/10> ;
      zoo:text "Verberibus servos afficiebat plurimis" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19> ;
      zoo:text "Hoc ex labore, quodve tantum est praemium" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/4/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/4> ;
      zoo:text "Et quod natura dederat voluisses pati," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/8/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/8> ;
      zoo:text "Clarumque collo iactans tintinnabulum," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/8/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/8> ;
      zoo:text "Comes quieto sequitur et placido gradu." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/8/text/23>
      a       zoo:Paragraph ;
      zoo:identifier 23 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/8> ;
      zoo:text "Noli molestus esse omnino litteris," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/10/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/10> ;
      zoo:text "Aesopus ergo narrat hoc breviter seni:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/15/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/15> ;
      zoo:text "Vestem, uniones, aurum, argentum sumeret," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/3/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/3> ;
      zoo:text "Frons prima multos: rara mens intellegit" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/2/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/2> ;
      zoo:text "Antehac fuisse, tales cum sint reliquiae?" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/10/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/10> ;
      zoo:text "Et exercebat fervidam adulescentiam." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/4/text/15>
      a       zoo:Paragraph ;
      zoo:identifier 15 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/4> ;
      zoo:text "Nec illam expertus esses contumeliam" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/8/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/8> ;
      zoo:text "Subito latrones ex insidiis advolant" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/8/text/22>
      a       zoo:Paragraph ;
      zoo:identifier 22 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/8> ;
      zoo:text "Si nec fabellae te iuvant nec fabulae?" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/3/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/3> ;
      zoo:text "Et in cubile concito properat gradu." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/10/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/10> ;
      zoo:text "Quidam iuvenco vetulum adiungebat bovem." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/15/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/15> ;
      zoo:text "Quae se expingendo totum intricaret diem," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/3/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/3> ;
      zoo:text "Quod interiore condidit cura angulo." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/20>
      a       zoo:Paragraph ;
      zoo:identifier 20 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Subsedit: deinde noctu subito ianuam" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/25/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/25> ;
      zoo:text "Inops, potentem dum vult imitari, perit." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21/text/35>
      a       zoo:Paragraph ;
      zoo:identifier 35 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21> ;
      zoo:text "Dum sanitas constabit, pulchre meminero." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/2/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/2> ;
      zoo:text "Hoc quo pertineat, dicet qui me noverit." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8> ;
      zoo:text "A furibus tuearis et noctu domum." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/10/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/10> ;
      zoo:text "Hircumque clauso liquit haerentem vado." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/16/text/20>
      a       zoo:Paragraph ;
      zoo:identifier 20 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/16> ;
      zoo:text "Obsistere homines legibus, meritis capi." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21> ;
      zoo:text "Supersunt mihi quae scribam, sed parco sciens," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/3/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/3> ;
      zoo:text "Veloci saltu fovea sese liberat" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/4/text/16>
      a       zoo:Paragraph ;
      zoo:identifier 16 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/4> ;
      zoo:text "Nec hanc repulsam tua sentiret calamitas." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/13/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/13> ;
      zoo:text "Simulque obiecto cuncta corrumpit lucro." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21/text/30>
      a       zoo:Paragraph ;
      zoo:identifier 30 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21> ;
      zoo:text "Integritatis qui sincerae conscius" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/10/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/10> ;
      zoo:text "Is cum refugiens impari collo iugum" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/25/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/25> ;
      zoo:text "Illi negarunt. Rursus intendit cutem" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/3/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/3> ;
      zoo:text "Hoc ne locutus sine mercede existimer," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/15/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/15> ;
      zoo:text "—At non cessabunt latera respondit tua," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8> ;
      zoo:text "Ego vero sum paratus: nunc patior nives" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/1/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/1> ;
      zoo:text "Ut quidam artifices nostro faciunt saeculo," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/2/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/2> ;
      zoo:text "Hunc postquam totis avida traxit naribus:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/10/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/10> ;
      zoo:text "Evasit puteo nixa celsis cornibus," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/4/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/4> ;
      zoo:text "†Hoc argumentum veniam ei dari docet" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/10/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/10> ;
      zoo:text "Aetatis excusaret vires languidas:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/25/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/25> ;
      zoo:text "Maiore nisu et simili quaesivit modo," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/3/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/3> ;
      zoo:text "Fabellam adiciam de mustela et muribus." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/15/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/15> ;
      zoo:text "Immo, nisi dederis, sponda cessabit tua." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8> ;
      zoo:text "Imbresque in silvis asperam vitam trahens:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/2/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/2> ;
      zoo:text "O suavis anima! quale te dicam bonum" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/1/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/1> ;
      zoo:text "Qui pretium operibus maius inveniunt novis," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/10/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/10> ;
      zoo:text "Immisit se barbatus. Tum vulpecula" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/8/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/8> ;
      zoo:text "Muli gravati sarcinis ibant duo:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/4/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/4> ;
      zoo:text "Qui casu peccat. Nam qui consilio est nocens," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14> ;
      zoo:text "Asellus autem, qui solebat pauperi" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/4/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/4> ;
      zoo:text "Redire maerens coepit ad proprium genus;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21/text/32>
      a       zoo:Paragraph ;
      zoo:identifier 32 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21> ;
      zoo:text "Qui sint, requires; apparebunt tempore." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/10/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/10> ;
      zoo:text "Non est quod timeas, inquit illi rusticus;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/7/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/7> ;
      zoo:text "Quem spes delusit, huic querela convenit." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/25/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/25> ;
      zoo:text "Rugosam inflavit pellem: tum natos suos" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/15/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/15> ;
      zoo:text "Adeone per me videor tibi meliuscula?—" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/1/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/1> ;
      zoo:text "Cui reddidi iam pridem quicquid debui," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8> ;
      zoo:text "Quanto est facilius mihi sub tecto vivere," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/2/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/2> ;
      zoo:text "Adhuc Falerna faece ex testa nobili" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/8/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/8> ;
      zoo:text "Unus ferebat fiscos cum pecunia," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/4/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/4> ;
      zoo:text "A quo repulsus tristem sustinuit notam." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14> ;
      zoo:text "Et coniugalem praebet Hymenaeus facem." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21/text/31>
      a       zoo:Paragraph ;
      zoo:identifier 31 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/21> ;
      zoo:text "A noxiorum premitur insolentiis." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/25/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/25> ;
      zoo:text "Interrogavit, an bove esset latior." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/7/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/7> ;
      zoo:text "Carbonem, ut aiunt, pro thesauro invenimus." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/15/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/15> ;
      zoo:text "Quidvis efficies, cultum si deposueris.—" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/22/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/22> ;
      zoo:text "Quod ferre certe cogor bis videor mori." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/1/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/1> ;
      zoo:text "Auctoritatis esse scito gratia:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/2/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/2> ;
      zoo:text "Odorem quae iucundum late spargeret." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/4/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/4> ;
      zoo:text "Optem necare vel maiore incommodo." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/8/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/8> ;
      zoo:text "Alter tumentes multo saccos hordeo." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/8> ;
      zoo:text "Et otiosum largo satiari cibo?" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/4/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/4> ;
      zoo:text "Tum quidam ex illis, quos prius despexerat:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/6/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/6> ;
      zoo:text "Sed spes fefellit impudentem audaciam:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6/text/29>
      a       zoo:Paragraph ;
      zoo:identifier 29 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6> ;
      zoo:text "Tunc simulans sese vestimentis rusticus" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/6/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/6> ;
      zoo:text "Ego primam tollo, †nominor quia leo;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/20/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/20> ;
      zoo:text "Dum firmiores posset catulos ducere." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/4/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/4> ;
      zoo:text "Ascribere hoc debebunt exemplum sibi." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/18/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/18> ;
      zoo:text "Pinus Cybebae, populus celsa Herculi." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/2/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/2> ;
      zoo:text "Ut mos est vulgi, passim et certatim ruit," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/22/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/22> ;
      zoo:text "Mihi insultare: te, naturae dedecus," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/8/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/8> ;
      zoo:text "Nam nil amisi nec sum laesus vulnere." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/4/text/17>
      a       zoo:Paragraph ;
      zoo:identifier 17 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/4> ;
      zoo:text "Quibus percoctis atque infuso spiritu," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14> ;
      zoo:text "Illum puellae casu conducunt suae," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/16/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/16> ;
      zoo:text "Discerpsit dominum et fecit partes facinoris." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/4/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/4> ;
      zoo:text "Audierat esse quod remedium vulneris." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19> ;
      zoo:text "Nullum inquit ille verum hoc ab summo mihi" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/3/text/19>
      a       zoo:Paragraph ;
      zoo:identifier 19 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/3> ;
      zoo:text "Sic valeas inquit ut farina es quae iaces!" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/14/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/14> ;
      zoo:text "Fuci recusant: apibus condicio placet." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/38>
      a       zoo:Paragraph ;
      zoo:identifier 38 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Ego porro illius semita feci viam," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/4/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/4> ;
      zoo:text "Una statura, simile et membris omnibus," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/29/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/29> ;
      zoo:text "Vindicta docili quia patet sollertiae." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/6/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/6> ;
      zoo:text "Persuasus ille fecit quod monitus fuit;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/20/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/20> ;
      zoo:text "Preces admovit, tempus exorans breve," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/18/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/18> ;
      zoo:text "Et myrtus Veneri placuit, Phoebo laurea," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/22/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/22> ;
      zoo:text "At ille exspirans: Fortis indigne tuli" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19> ;
      zoo:text "Nec ulli donas quicquam? Sic fatis placet." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/6/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/6> ;
      zoo:text "Sic est locutus, partibus factis, leo:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/4/text/16>
      a       zoo:Paragraph ;
      zoo:identifier 16 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/4> ;
      zoo:text "Igitur fornaci pariter duo signa intulit;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14> ;
      zoo:text "Quaestum referre, stabat portae in limine." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/8/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/8> ;
      zoo:text "Hoc argumento tuta est hominum tenuitas;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19> ;
      zoo:text "Iove attributum est. Ergo nec sumis tibi" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/2/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/2> ;
      zoo:text "Athenas occupavit imperio improbo." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/4/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/4> ;
      zoo:text "Tinctum cruore panem misit malefico," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19> ;
      zoo:text "Vulpes, cubile fodiens, dum terram eruit" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/2/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/2> ;
      zoo:text "Anus iacere vidit epotam amphoram," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/16/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/16> ;
      zoo:text "Postquam esurire coepit societas fera," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/14/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/14> ;
      zoo:text "Tunc illa talem protulit sententiam:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/4/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/4> ;
      zoo:text "Dum tempus habuit, callida finxit manu." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/39>
      a       zoo:Paragraph ;
      zoo:identifier 39 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Et cogitavi plura quam reliquerat," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/16/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/16> ;
      zoo:text "Senex negavit. Ergo quid refert mea" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/29/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/29> ;
      zoo:text "Vulpinos catulos aquila quondam sustulit" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/6/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/6> ;
      zoo:text "Impinge lapidem et dignum accipies praemium." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/6/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/6> ;
      zoo:text "Tum, quia plus valeo, me sequetur tertia;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/4/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/4> ;
      zoo:text "Nondum matura est; nolo acerbam sumere." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/20/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/20> ;
      zoo:text "Facile impetravit: dein reposcenti locum" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/8/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/8> ;
      zoo:text "Spoliatus igitur casus cum fleret suos:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19> ;
      zoo:text "Nolo irascaris, libere si dixero:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/4/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/4> ;
      zoo:text "Laceratus quidam morsu vehementis canis" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14/text/15>
      a       zoo:Paragraph ;
      zoo:identifier 15 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14> ;
      zoo:text "Repente caelum, Veneris misericordia," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/18/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/18> ;
      zoo:text "Interrogavit. Causam dixit Iuppiter:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/2/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/2> ;
      zoo:text "Illam osculantur, qua sunt oppressi, manum," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6/text/27>
      a       zoo:Paragraph ;
      zoo:identifier 27 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6> ;
      zoo:text "Uterque prodit. Scurra degrunnit prior" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/4/text/15>
      a       zoo:Paragraph ;
      zoo:identifier 15 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/4> ;
      zoo:text "Propriae videri voluit artis gloriam." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19> ;
      zoo:text "Agitque pluris altius cuniculos," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/3/text/17>
      a       zoo:Paragraph ;
      zoo:identifier 17 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/3> ;
      zoo:text "Qui saepe laqueos et muscipula effugerat;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/30/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/30> ;
      zoo:text "Sed inquinari nolo ignavo sanguine." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/14/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/14> ;
      zoo:text "Apertum est quis non possit et quis fecerit." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/4/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/4> ;
      zoo:text "Mirans Prometheus tantam similitudinem," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/29/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/29> ;
      zoo:text "Quamvis sublimes debent humiles metuere," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/6/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/6> ;
      zoo:text "Venit ecce dives et potens: huic similiter" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/4/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/4> ;
      zoo:text "Qui facere quae non possunt verbis elevant," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/6/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/6> ;
      zoo:text "Secundam, quia sum fortis, tribuetis mihi;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/8/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/8> ;
      zoo:text "Equidem inquit alter me contemptum gaudeo;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/2/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/2> ;
      zoo:text "'Feliciter!' succlamans. Ipsi principes" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14> ;
      zoo:text "Viae labores teneros ne laedant pedes." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/18/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/18> ;
      zoo:text "Minerva admirans, quare steriles sumerent" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/60>
      a       zoo:Paragraph ;
      zoo:identifier 60 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Brevitate nimia quoniam quosdam offendimus." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/20/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/20> ;
      zoo:text "Ut fetum in eius tugurio deponeret," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6/text/28>
      a       zoo:Paragraph ;
      zoo:identifier 28 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6> ;
      zoo:text "Movetque plausus et clamores suscitat." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19/text/15>
      a       zoo:Paragraph ;
      zoo:identifier 15 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19> ;
      zoo:text "Dis est iratis natus, qui est similis tibi." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19> ;
      zoo:text "Pervenit ad draconis speluncam ultimam," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/30/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/30> ;
      zoo:text "Repressit iram et: Facilis vindicta est mihi," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/3/text/18>
      a       zoo:Paragraph ;
      zoo:identifier 18 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/3> ;
      zoo:text "Proculque insidias cernens hostis callidi:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/14/text/15>
      a       zoo:Paragraph ;
      zoo:identifier 15 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/14> ;
      zoo:text "Quapropter apibus fructum restituo suum." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/18/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/18> ;
      zoo:text "At mehercules narrabit quod quis voluerit," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/4/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/4> ;
      zoo:text "Metu turbatus in suo sedit loco." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/8/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/8> ;
      zoo:text "Interque caedem ferro mulum sauciant," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/6/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/6> ;
      zoo:text "Sed unde accipere possis monstrabo tibi." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/26/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/26> ;
      zoo:text "Habere atque agere maximas me gratias;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14/text/17>
      a       zoo:Paragraph ;
      zoo:identifier 17 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14> ;
      zoo:text "Noctemque densis horridam nimbis parat:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6/text/25>
      a       zoo:Paragraph ;
      zoo:identifier 25 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6> ;
      zoo:text "Fit turba maior. Iam favor mentes tenet" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/8/text/25>
      a       zoo:Paragraph ;
      zoo:identifier 25 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/8> ;
      zoo:text "Hoc illis dictum est, qui stultitia nauseant" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/20/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/20> ;
      zoo:text "Canis parturiens cum rogasset alteram," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/16/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/16> ;
      zoo:text "Sic est locuta: Moneo praecaveas dolum;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8/text/32>
      a       zoo:Paragraph ;
      zoo:identifier 32 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8> ;
      zoo:text "Iteratur illud. Homo meus se in pulpito" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19> ;
      zoo:text "Custodiebat qui thesauros abditos." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/4/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/4> ;
      zoo:text "Successus improborum plures allicit." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/29/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/29> ;
      zoo:text "Ne tantum miserae luctum importaret sibi." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6> ;
      zoo:text "Venere artifices laudis ad certamina;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/4/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/4> ;
      zoo:text "Redit magister; quo festinanter Dolus" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/8/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/8> ;
      zoo:text "Diripiunt nummos, neglegunt vile hordeum." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6> ;
      zoo:text "Quam quisque posset ut novitatem ostenderet." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/26/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/26> ;
      zoo:text "Quod te celavi? Linguae prorsus non nego" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14/text/16>
      a       zoo:Paragraph ;
      zoo:identifier 16 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14> ;
      zoo:text "Ventis movetur, intonat mundi fragor" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6/text/26>
      a       zoo:Paragraph ;
      zoo:identifier 26 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6> ;
      zoo:text "Et derisuri, non spectaturi sedent." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/20/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/20> ;
      zoo:text "Quas ut vitemus versus subiecti monent." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/8/text/24>
      a       zoo:Paragraph ;
      zoo:identifier 24 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/8> ;
      zoo:text "Maiorem exhibeant ne tibi molestiam." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/18/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/18> ;
      zoo:text "Honorem fructu ne videamur vendere." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8/text/31>
      a       zoo:Paragraph ;
      zoo:identifier 31 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8> ;
      zoo:text "Magnoque risu canticum repeti iubet." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/4/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/4> ;
      zoo:text "Cum scierint esse tale culpae praemium." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19> ;
      zoo:text "Hunc simul aspexit: Oro ut imprudentiae" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/6/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/6> ;
      zoo:text "Sic prosecutus: Plus non habeo mehercules," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/16/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/16> ;
      zoo:text "Hunc gloriosum vulpes ut vidit vehi," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/29/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/29> ;
      zoo:text "Contempsit illa, tuta quippe ipso loco." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/10/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/10> ;
      zoo:text "Simili querela fata deploras tua." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6/text/23>
      a       zoo:Paragraph ;
      zoo:identifier 23 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6> ;
      zoo:text "Me vincet inquit, et statim professus est" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/4/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/4> ;
      zoo:text "Lutum ad faciendos illi defecit pedes." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/14/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/14> ;
      zoo:text "Sancta incorrupta iura reddebat fide." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14/text/19>
      a       zoo:Paragraph ;
      zoo:identifier 19 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14> ;
      zoo:text "Effusa trepidos passim comites dissipat," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/20/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/20> ;
      zoo:text "Habent insidias hominis blanditiae mali:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/8/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/8> ;
      zoo:text "Magnae periclo sunt opes obnoxiae." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/4/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/4> ;
      zoo:text "Hoc facere canibus, ne nos vivos devorent," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/2/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/2> ;
      zoo:text "Demetrius qui dictus est Phalereus," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19> ;
      zoo:text "Des primum veniam; deinde si pulchre vides," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/16/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/16> ;
      zoo:text "Praedam portare iudices, non sarcinam." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8/text/30>
      a       zoo:Paragraph ;
      zoo:identifier 30 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8> ;
      zoo:text "Equester ordo stultum errorem intellegit" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6> ;
      zoo:text "Habere dixit se genus spectaculi" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/14/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/14> ;
      zoo:text "Ut ex sapore mellis et forma favi," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/6/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/6> ;
      zoo:text "Tanto inquit melior! Assem deinde illi dedit," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/29/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/29> ;
      zoo:text "Nidoque posuit pullis, escam ut carperent." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/18/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/18> ;
      zoo:text "Oliva nobis propter fructum est gratior." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6/text/24>
      a       zoo:Paragraph ;
      zoo:identifier 24 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6> ;
      zoo:text "Idem facturum melius se postridie." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/26/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/26> ;
      zoo:text "Verum oculis ut priveris opto perfidis." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/4/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/4> ;
      zoo:text "Quod prope iam totum mire cum positum foret," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/14/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/14> ;
      zoo:text "Postquam labare coepit paenitentia," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14/text/18>
      a       zoo:Paragraph ;
      zoo:identifier 18 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/14> ;
      zoo:text "Lux rapitur oculis et simul vis grandinis" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/8/text/26>
      a       zoo:Paragraph ;
      zoo:identifier 26 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/8> ;
      zoo:text "Et ut putentur sapere caelum vituperant." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/4/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/4> ;
      zoo:text "Tunc sic Aesopus: Noli coram pluribus" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19> ;
      zoo:text "Ut careas somno et aevum in tenebris exigas?" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/16/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/16> ;
      zoo:text "Istorum vultus namque si consideras," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19> ;
      zoo:text "Quam non conveniens aurum sit vitae meae," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/6/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/6> ;
      zoo:text "Aesopo quidam petulans lapidem impegerat." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/14/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/14> ;
      zoo:text "De quis nunc agitur, auctor horum appareat." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6> ;
      zoo:text "Quos inter scurra, notus urbano sale," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/29/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/29> ;
      zoo:text "Hanc persecuta mater orare incipit," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/24/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/24> ;
      zoo:text "Vigilare, facias ne mea culpa lucrum." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/17/text/17>
      a       zoo:Paragraph ;
      zoo:identifier 17 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/17> ;
      zoo:text "Cupide advolavit. Noctua egressa e cavo" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6/text/21>
      a       zoo:Paragraph ;
      zoo:identifier 21 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6> ;
      zoo:text "Hominemque plausu prosequuntur maximo." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21/text/22>
      a       zoo:Paragraph ;
      zoo:identifier 22 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21> ;
      zoo:text "Sermone ab ipso cognitum cupidissime" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/14/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/14> ;
      zoo:text "A pristina deflexit consuetudine" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/29/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/29> ;
      zoo:text "Tu qui fuisti mulus clitellarius," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/9/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/9> ;
      zoo:text "Nullamque ut affirmaret esse illi parem," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/3/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/3> ;
      zoo:text "Mures veloces non valeret assequi," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/13/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/13> ;
      zoo:text "Lacerari coepit morsibus saevis canum." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/16/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/16> ;
      zoo:text "Nil praeter domini mores mutant pauperes." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/24/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/24> ;
      zoo:text "Poenas dedisses. Illa contra pessima:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8/text/36>
      a       zoo:Paragraph ;
      zoo:identifier 36 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8> ;
      zoo:text "Princeps, ligato crure nivea fascia," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/2/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/2> ;
      zoo:text "Exemplum egregium prorsus et laudabile;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6/text/22>
      a       zoo:Paragraph ;
      zoo:identifier 22 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6> ;
      zoo:text "Hoc vidit fieri rusticus: Non mehercules" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21/text/21>
      a       zoo:Paragraph ;
      zoo:identifier 21 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21> ;
      zoo:text "Eratque absentis admirator maximus," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/17/text/16>
      a       zoo:Paragraph ;
      zoo:identifier 16 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/17> ;
      zoo:text "Simul cognovit vocem laudari suam," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/30>
      a       zoo:Paragraph ;
      zoo:identifier 30 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Honori et meritis dedicans illum tuis." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/14/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/14> ;
      zoo:text "Atque inter illas tenui contentus cibo" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/4/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/4> ;
      zoo:text "Olim Prometheus saeculi figulus novi" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/9/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/9> ;
      zoo:text "Mordaciorem qui improbo dente appetit" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/29/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/29> ;
      zoo:text "Quemcumque visum est laedis infixo aculeo." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/24/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/24> ;
      zoo:text "Hoc inquit si dentato fecisses cani," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/3/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/3> ;
      zoo:text "Involvit se farina et obscuro loco" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/13/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/13> ;
      zoo:text "Tunc moriens edidisse vocem hanc dicitur:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/16/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/16> ;
      zoo:text "In principatu commutando saepius" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8/text/35>
      a       zoo:Paragraph ;
      zoo:identifier 35 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8> ;
      zoo:text "Ut vero cuneis notuit res omnibus," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/9/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/9> ;
      zoo:text "Iucunditatis causam haud depellit Venus," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/2/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/2> ;
      zoo:text "Verum est aviditas dives et pauper pudor." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/14/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/14> ;
      zoo:text "Cum se ferarum regem fecissit leo" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/17/text/15>
      a       zoo:Paragraph ;
      zoo:identifier 15 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/17> ;
      zoo:text "Una bibamus. Illa, quae arebat siti," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21/text/24>
      a       zoo:Paragraph ;
      zoo:identifier 24 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21> ;
      zoo:text "Hominem exornavit. Ceteri tabulam suam" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/4/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/4> ;
      zoo:text "Cura subtili Veritatem fecerat," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/31>
      a       zoo:Paragraph ;
      zoo:identifier 31 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Quem si leges, laetabor; sin autem minus," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/26/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/26> ;
      zoo:text "Tunc sic bubulcus: Ecquid est gratum tibi," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/9/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/9> ;
      zoo:text "Hoc argumento se describi sentiat." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/29/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/29> ;
      zoo:text "Arte omni princeps inter aequales fui." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24/text/20>
      a       zoo:Paragraph ;
      zoo:identifier 20 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24> ;
      zoo:text "Splendebat hilare poculis convivium," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/16/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/16> ;
      zoo:text "Asellum in prato timidus pascebat senex." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/6/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/6> ;
      zoo:text "Numquam est fidelis cum potente societas:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/24/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/24> ;
      zoo:text "Quam dorso cum tulisset invita et diu:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/13/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/13> ;
      zoo:text "Nec tibi prodesse nec mihi quicquam potest." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/29/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/29> ;
      zoo:text "Vulpes ab ara rapuit ardentem facem" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/16/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/16> ;
      zoo:text "Feles habebat gallus lecticarios." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8/text/34>
      a       zoo:Paragraph ;
      zoo:identifier 34 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8> ;
      zoo:text "Rogare populus hunc coronam existimat." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/9/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/9> ;
      zoo:text "Cum castitatem Iuno laudaret suam," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/4/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/4> ;
      zoo:text "Ut iura posset inter homines reddere." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21/text/23>
      a       zoo:Paragraph ;
      zoo:identifier 23 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21> ;
      zoo:text "Ad se recepit; veste, nummis, familia" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/14/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/14> ;
      zoo:text "Et aequitatis vellet famam consequi," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/17/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/17> ;
      zoo:text "Nuper donavit; si non fastidis, veni;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/32>
      a       zoo:Paragraph ;
      zoo:identifier 32 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Habebunt certe quo se oblectent posteri." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6/text/20>
      a       zoo:Paragraph ;
      zoo:identifier 20 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/6> ;
      zoo:text "Nihil est repertum, multis onerant lancibus" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/26/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/26> ;
      zoo:text "Non intellexit seque e conspectu abstulit." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/9/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/9> ;
      zoo:text "In officinam fabri venit vipera." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/29/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/29> ;
      zoo:text "En cuncta: levitas putris et volito cinis!" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24/text/21>
      a       zoo:Paragraph ;
      zoo:identifier 21 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24> ;
      zoo:text "Magno apparatu laeta resonabat domus," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/24/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/24> ;
      zoo:text "Odiosa cornix super ovem consederat;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/13/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/13> ;
      zoo:text "Hoc illis narro, qui me non intellegunt." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/3/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/3> ;
      zoo:text "Mustela cum annis et senecta debilis" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8/text/33>
      a       zoo:Paragraph ;
      zoo:identifier 33 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8> ;
      zoo:text "Totum prosternit. Plaudit illudens eques." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/13/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/13> ;
      zoo:text "In qua retentis impeditus cornibus" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/16/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/16> ;
      zoo:text "Id esse verum parva haec fabella indicat." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/29/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/29> ;
      zoo:text "Totamque flammis arborem circumdedit," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/17/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/17> ;
      zoo:text "Potare est animus nectar, quod Pallas mihi" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/14/text/17>
      a       zoo:Paragraph ;
      zoo:identifier 17 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/14> ;
      zoo:text "Si pactam fuci non recusassent fidem." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24/text/22>
      a       zoo:Paragraph ;
      zoo:identifier 22 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24> ;
      zoo:text "Repente duo cum iuvenes sparsi pulvere," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/4/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/4> ;
      zoo:text "Subito accersitus nuntio magni Iovis" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/29/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/29> ;
      zoo:text "Quorum ex reliquiis animam nos accepimus," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/10/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/10> ;
      zoo:text "Tace inquit ante hoc novi quam tu natus es." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/33>
      a       zoo:Paragraph ;
      zoo:identifier 33 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Nunc fabularum cur sit inventum genus," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/5/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/5> ;
      zoo:text "Derepit ad cubile setosae suis:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21/text/26>
      a       zoo:Paragraph ;
      zoo:identifier 26 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21> ;
      zoo:text "Simonides ut vidit: Dixi, inquit, mea" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/6/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/6> ;
      zoo:text "Vacca et capella et patiens ovis iniuriae" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19/text/16>
      a       zoo:Paragraph ;
      zoo:identifier 16 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19> ;
      zoo:text "Abiturus illuc, quo priores abierunt," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/14/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/14> ;
      zoo:text "Probanda cunctis est quidem sententia," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/13/text/15>
      a       zoo:Paragraph ;
      zoo:identifier 15 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/13> ;
      zoo:text "Et quae laudaram quantum luctus habuerint." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/16/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/16> ;
      zoo:text "Suadebat asino fugere, ne possent capi." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6> ;
      zoo:text "Habere res desierint, quas acceperint," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3/text/30>
      a       zoo:Paragraph ;
      zoo:identifier 30 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3> ;
      zoo:text "Malum perferte. — Vos quoque, o cives, ait," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/13/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/13> ;
      zoo:text "Olim redisses ad splendorem pristinum." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13/text/31>
      a       zoo:Paragraph ;
      zoo:identifier 31 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13> ;
      zoo:text "Sic turpitudo laudis obsedit locum." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/9/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/9> ;
      zoo:text "Sic ut concedas pedibus aliquid scalpere." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/3/text/15>
      a       zoo:Paragraph ;
      zoo:identifier 15 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/3> ;
      zoo:text "Alter similiter, deinde perit et tertius." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/4/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/4> ;
      zoo:text "Uvam appetebat summis saliens viribus;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/14/text/16>
      a       zoo:Paragraph ;
      zoo:identifier 16 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/14> ;
      zoo:text "Hanc praeterissem fabulam silentio," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/14/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/14> ;
      zoo:text "Sed ad perniciem solet agi sinceritas." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/4/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/4> ;
      zoo:text "Commendat officinam fallaci Dolo," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24/text/23>
      a       zoo:Paragraph ;
      zoo:identifier 23 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24> ;
      zoo:text "Sudore multo diffluentes corpora," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/29/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/29> ;
      zoo:text "Ego eloquens in pace, fortis proeliis," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/5/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/5> ;
      zoo:text "Terrore offuso et perturbatis sensibus" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/10/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/10> ;
      zoo:text "Monstrabat vitulus quo se pacto plecteret." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/34>
      a       zoo:Paragraph ;
      zoo:identifier 34 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Brevi docebo. Servitus obnoxia," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19/text/17>
      a       zoo:Paragraph ;
      zoo:identifier 17 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19> ;
      zoo:text "Quid mente caeca miserum torques spiritum?" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21/text/25>
      a       zoo:Paragraph ;
      zoo:identifier 25 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21> ;
      zoo:text "Portant rogantes victum. Quos casu obvios" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/16/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/16> ;
      zoo:text "Cui serviam clitellas cum portem meas?" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/6/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/6> ;
      zoo:text "Testatur haec fabella propositum meum." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/16/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/16> ;
      zoo:text "Is hostium clamore subito territus" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/9/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/9> ;
      zoo:text "Respondit illa: Quicquid dederis, satis erit," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6> ;
      zoo:text "Ni data possideant aut fruantur; tum: simul" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/24/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/24> ;
      zoo:text "Ideo senectam mille in annos prorogo." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/3/text/16>
      a       zoo:Paragraph ;
      zoo:identifier 16 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/3> ;
      zoo:text "Mox venit aliquot saeculis retorridus" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/13/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/13> ;
      zoo:text "Ego quod te inveni, potior cui multo est cibus," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/4/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/4> ;
      zoo:text "Quam tangere ut non potuit, discedens ait:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/35>
      a       zoo:Paragraph ;
      zoo:identifier 35 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Quia quae volebat non audebat dicere," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/11/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/11> ;
      zoo:text "Victorem forte gymnici certaminis" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8/text/39>
      a       zoo:Paragraph ;
      zoo:identifier 39 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8> ;
      zoo:text "Ab universis capite est protrusus foras." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/29/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/29> ;
      zoo:text "Papilio vespam praetervolitans viderat." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24/text/24>
      a       zoo:Paragraph ;
      zoo:identifier 24 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24> ;
      zoo:text "Humanam supra formam, cuidam servulo" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/19>
      a       zoo:Paragraph ;
      zoo:identifier 19 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Simulavit iter ad villam clamque in oppido" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/5/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/5> ;
      zoo:text "Ut nostram in plano facile progeniem opprimat." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/10/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/10> ;
      zoo:text "Cum vix intrare posset ad praesepia," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/17/text/19>
      a       zoo:Paragraph ;
      zoo:identifier 19 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/17> ;
      zoo:text "Sic viva quod negarat tribuit mortua." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19/text/18>
      a       zoo:Paragraph ;
      zoo:identifier 18 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19> ;
      zoo:text "Tibi dico, avare, gaudium heredis tui," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/18/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/18> ;
      zoo:text "Divi legerunt arbores. Quercus Iovi" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/4/text/19>
      a       zoo:Paragraph ;
      zoo:identifier 19 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/4> ;
      zoo:text "At trunca species haesit in vestigio." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/1/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/1> ;
      zoo:text "Quod arbores loquantur, non tantum ferae," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/6/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/6> ;
      zoo:text "Hi cum cepissent cervum vasti corporis," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/3/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/3> ;
      zoo:text "Abiecit neglegenter. Mus escam putans" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6> ;
      zoo:text "Athenas rumor implet. Mater sedula" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/13/text/13>
      a       zoo:Paragraph ;
      zoo:identifier 13 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/13> ;
      zoo:text "O me infelicem! qui nunc demum intellego" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/9/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/9> ;
      zoo:text "Dic sodes quanto possis satiari cibo." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/24/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/24> ;
      zoo:text "Scio quem lacessam, cui dolosa blandiar;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/13/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/13> ;
      zoo:text "Iaces indigno quanta res inquit loco!" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/36>
      a       zoo:Paragraph ;
      zoo:identifier 36 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Affectus proprios in fabellas transtulit" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/16/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/16> ;
      zoo:text "Clitellas impositurum victorem putas?" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8/text/38>
      a       zoo:Paragraph ;
      zoo:identifier 38 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8> ;
      zoo:text "Superbiens honore divinae domus," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/4/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/4> ;
      zoo:text "In disciplinam nuper quem receperat." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/29/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/29> ;
      zoo:text "O sortem iniquam! dum vivebant corpora," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24/text/25>
      a       zoo:Paragraph ;
      zoo:identifier 25 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/24> ;
      zoo:text "Mandant ut ad se provocet Simonidem;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/10/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/10> ;
      zoo:text "Angusto in aditu taurus luctans cornibus" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/11/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/11> ;
      zoo:text "Tu non videris perdidisse quod petis;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/17/text/18>
      a       zoo:Paragraph ;
      zoo:identifier 18 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/17> ;
      zoo:text "Trepidantem consectata est et leto dedit." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/18/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/18> ;
      zoo:text "Olim quas vellent esse in tutela sua," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19/text/19>
      a       zoo:Paragraph ;
      zoo:identifier 19 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/19> ;
      zoo:text "Qui ture superos, ipsum te fraudas cibo," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/4/text/18>
      a       zoo:Paragraph ;
      zoo:identifier 18 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/4> ;
      zoo:text "Modesto gressu sancta incessit Veritas;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/1/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/1> ;
      zoo:text "Fictis iocari nos meminerit fabulis." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/14/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/14> ;
      zoo:text "Utilius homini nihil est quam recte loqui:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21/text/27>
      a       zoo:Paragraph ;
      zoo:identifier 27 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/21> ;
      zoo:text "Mecum esse cuncta; vos quod rapuistis perit." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/6/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/6> ;
      zoo:text "Socii fuere cum leone in saltibus." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/9/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/9> ;
      zoo:text "Interrogasse sic gallinam dicitur:" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/13/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/13> ;
      zoo:text "Utilia mihi quam fuerint quae despexeram," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/6> ;
      zoo:text "Centena matri conferant sestertia." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/16/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/16> ;
      zoo:text "At ille lentus: Quaeso, num binas mihi" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13/text/30>
      a       zoo:Paragraph ;
      zoo:identifier 30 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/13> ;
      zoo:text "Ne subeat ille poenas neglegentiae." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3/text/31>
      a       zoo:Paragraph ;
      zoo:identifier 31 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3> ;
      zoo:text "Hoc sustinete, maius ne veniat malum." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/4/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/4> ;
      zoo:text "Fame coacta vulpes alta in vinea" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/24/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/24> ;
      zoo:text "Despicio inermes, eadem cedo fortibus;" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/13/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/13> ;
      zoo:text "Hoc si quis pretii cupidus vidisset tui," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/3/text/14>
      a       zoo:Paragraph ;
      zoo:identifier 14 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/3> ;
      zoo:text "Assiluit et compressus occubuit neci." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8/text/37>
      a       zoo:Paragraph ;
      zoo:identifier 37 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/5/8> ;
      zoo:text "Niveisque tunicis, niveis etiam calceis," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1/text/37>
      a       zoo:Paragraph ;
      zoo:identifier 37 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/1> ;
      zoo:text "Calumniamque fictis elusit iocis." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/2/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/2/2> ;
      zoo:text "Silvas petivit, homini ut accessum daret." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/4/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/6/4> ;
      zoo:text "Hic studio accensus, facie simulacrum pari," .


