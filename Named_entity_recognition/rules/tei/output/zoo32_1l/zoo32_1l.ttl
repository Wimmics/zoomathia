      a       zoo:Paragraph ;
      zoo:identifier 16 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3> ;
      zoo:text "Hoc mersum limo cum iaceret diutius," .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/4/23> ;
      zoo:text "Et matronarum casta delibo oscula." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/21/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/21> ;
      zoo:text "Periere quam quod petierant contingerent." .

