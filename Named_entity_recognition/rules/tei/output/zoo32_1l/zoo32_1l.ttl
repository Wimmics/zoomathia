      zoo:identifier 33 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Et ferro incubuit, quod credulitas strinxerat." .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/11> ;
      zoo:text "Ergo exploranda est veritas multum, prius" .

<http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/1/3/text/19>
