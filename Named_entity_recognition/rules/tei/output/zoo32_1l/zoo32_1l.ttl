      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/PHAEDRUS/fabulae_aesopiae/l/3/13> ;
      zoo:text "Hoc si quis pretii cupidus vidisset tui," .

