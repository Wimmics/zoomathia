<http://ns.inria.fr/zoomathia/annotation/b70894e62951a601da244218f44a3d07a38402b5>
      a       zoo:AutomaticAnnotation ;
      oa:hasBody <http://dbpedia.org/resource/Sound> ;
      oa:hasTarget
              [ oa:hasSelector
                        [ a       oa:TextPositionSelector , oa:TextQuoteSelector ;
