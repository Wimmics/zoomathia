<http://ns.inria.fr/zoomathia/annotation/365a6de0663516adecb0f85e7514b4cab48a346e>
      a       zoo:AutomaticAnnotation ;
      oa:hasBody <http://dbpedia.org/resource/Thy_(district)> ;
