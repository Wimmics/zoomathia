      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/e/2> ;
      zoo:text "Ael. III.2;" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/e/2/text/286>
