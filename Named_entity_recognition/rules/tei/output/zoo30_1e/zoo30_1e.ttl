      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/e/2> ;
      zoo:text "Gratt. 154 mille canum patriae." .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/e/2/text/327>
      a       zoo:Paragraph ;
