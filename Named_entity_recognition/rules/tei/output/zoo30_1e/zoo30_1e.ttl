<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/e/1/text/43>
      a       zoo:Paragraph ;
      zoo:identifier 43 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/e/1> ;
      zoo:text "With them might" .

<http://ns.inria.fr/zoomathia/OPPIANUS-2/cynegetica/e/2/text/339>
      a       zoo:Paragraph ;
