<http://ns.inria.fr/zoomathia/annotation/6a78df6291f42c09436a021970a94171e641510f>
      a       zoo:AutomaticAnnotation ;
      oa:hasBody <http://dbpedia.org/resource/Opium_den> ;
      oa:hasTarget
              [ oa:hasSelector
                        [ a       oa:TextPositionSelector , oa:TextQuoteSelector ;
                          oa:exact "dens"
                        ] ;
