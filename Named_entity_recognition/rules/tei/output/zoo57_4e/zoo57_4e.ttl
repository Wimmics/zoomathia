<http://ns.inria.fr/zoomathia/annotation/6c475d25166b073c0f01f82180a4b51ecc330464>
      a       zoo:AutomaticAnnotation ;
      oa:hasBody <http://dbpedia.org/resource/Waterfall> ;
      oa:hasTarget
              [ oa:hasSelector
                        [ a       oa:TextPositionSelector , oa:TextQuoteSelector ;
                          oa:exact "plunge"
