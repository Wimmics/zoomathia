<http://ns.inria.fr/zoomathia/PHILO_ALEXANDRINUS/de_aeternitate_mundi/g>
      a       zoo:Oeuvre ;
      zoo:author "PHILO ALEXANDRINUS" ;
      zoo:date "1915" ;
      zoo:editor "Sigofried Reiter" ;
