<http://ns.inria.fr/zoomathia/annotation/9055eb388e083b5d672a3ba32a5e38778c6f1812>
      a       zoo:AutomaticAnnotation ;
      oa:hasBody <https://opentheso.huma-num.fr/?idc=105428&idt=th310> ;
