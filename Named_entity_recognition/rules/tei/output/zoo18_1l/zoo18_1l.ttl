@prefix oa:      <http://www.w3.org/ns/oa#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rml:     <http://semweb.mmlab.be/ns/rml#> .
@prefix rr:      <http://www.w3.org/ns/r2rml#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix xrr:     <http://i3s.unice.fr/xr2rml#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix zoo:     <http://ns.inria.fr/zoomathia/zoo#> .


<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l>
      a       zoo:Oeuvre ;
      zoo:author "EUCHERIUS" ;
      zoo:date "2026-08-30" ;
      zoo:editor "Unknown editor" ;
      zoo:file "./zoo/zoo18/1l.xml" ;
      zoo:identifier "formulae_spiritalis_intellegentiae" ;
      zoo:title "Formulae spiritalis intellegentiae" .


<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/70/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/70> ;
      zoo:text "Uipera idem quod supra in euangelio: serpentes genimina uiperarum." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/55/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/55> ;
      zoo:text "Oues populi fideles; in euangelio: oues meae uocem meam audiunt." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/25/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/25> ;
      zoo:text "Bestiae diabolus uel homines feri; in psalmo: ne tradas bestiis animas confitentes tibi." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/40/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/40> ;
      zoo:text "Erinacius idem quod supra; et erinacii gens inualida, qui fecerunt in petris domos sibi." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/57/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/57> ;
      zoo:text "Hirci peccatores siue gentiles; in Daniele: ecce autem hircus caprarum ueniebat ab occidente super faciem totius terrae. Item in bonam partem: offeram tibi boues cum hircis." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/53/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/53> ;
      zoo:text "Sues peccatores inmundi; in epistula Petri: et sus lota in uolutabro luti." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/12/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/12> ;
      zoo:text "Columba spiritus sanctus; in euangelio: et uidi spiritum dei descendentem sicut columbam. Item in aliam partem: in Ephraim columba sine sensu non habens cor." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/59/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/59> ;
      zoo:text "Agni Christus uel apostoli aut sancti; in euangelio: pasce agnos meos." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/27/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/27> ;
      zoo:text "Pardus diabolus uel peccator moribus uarius; in propheta: sicut Aethiops non mutabit pellem et pardus uarietatem." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/8/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/8> ;
      zoo:text "Struthio hereticus uel philosophus, quod quasi cum pinnis sapientiae tamen non euolat; in Esaia: et erit cubile draconum et pascua struthionum." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/51/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/51> ;
      zoo:text "Uaccae carnalibus uitiis pleni; in psalmo: inter uaccas populorum." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/21/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/21> ;
      zoo:text "Scarabeus in propheta: et scarabeus de ligno clamabit, ut putant quidam, de domino." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/14/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/14> ;
      zoo:text "Miluus significat, ut puto, rapacem uel elatum; in psalmo secundum Hebraeum: milui abies domus est." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/66/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/66> ;
      zoo:text "Aranea humana fragilitas; in psalmo: et tabescere fecisti uelut araneam animam eius." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/29/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/29> ;
      zoo:text "Ursus diabolus aut duces saeui; in Regnorum: et egressi sunt duo ursi et comederunt eos." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/16/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/16> ;
      zoo:text "Nycticorax Christus uel uir sanctus infidelibus despicabilis; in psalmo: factus sum sicut nycticorax in domicilio." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/46/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/46> ;
      zoo:text "Asinus corpus humanum uel populus gentilium; in euangelio: et adduxerunt ad Iesum asinam et pullum eius et eum desuper sedere fecerunt." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/64/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/64> ;
      zoo:text "Formica prouidus uel operarius; in Salamone: uade ad formicam, o piger." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/6/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/6> ;
      zoo:text "Pulli sancti; in psalmo ut supra. Et in malam partem in Salamone: et pulli aquilarum deuorent eum." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/62/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/62> ;
      zoo:text "Canis diabolus uel Iudaeus uel gentilis; in psalmo: et de manu canis unicam meam. Et in aliam partem in Ecclesiaste: melior est canis uiuus leone mortuo. Hic leonem diabolum, canem uero gentilem uel hominem peccatorem accipiendum putant, quod ille ad fidem uel paenitentiam possit uenire, ille non ueniat." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/48/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/48> ;
      zoo:text "Camelus diuites rebus saeculi onusti uel moribus distorti; in euangelio: facilius est camelum per foramen acus transire quam diuitem intrare in regna caelorum." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/31/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/31> ;
      zoo:text "Lupus diabolus uel heretici; in euangelio: intrinsecus autem sunt lupi rapaces. Item in bonam partem: Beniamin lupus rapax, apostolum Paulum significans." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/17/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/17> ;
      zoo:text "Passer nonnumquam dominus aut uir sanctus; in psalmo: etenim passer inuenit sibi domum. Est et aliter passer, de quo dicitur ad sanctum: transmigra in montem sicut passer." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/34/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/34> ;
      zoo:text "Rinoceron fortis quique uel in bonam uel in malam partem; in libro Iob secundum Hebraeum: numquid uolet rinoceros seruire tibi." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/60/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/60> ;
      zoo:text "Haedi peccatores; in euangelio: haedos autem a sinistris." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/36/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/36> ;
      zoo:text "Onager heremita; in Iob: quis dimittet onagrum liberum? Potest et populus ille Iudaeorum onager dici, quia sequitur in eodem libro: et uincula eius quis soluit? Uincula utique praeceptorum." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/19/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/19> ;
      zoo:text "Gallina sapientia siue ecclesia siue anima; in euangelio: sicut gallina congregat pullos suos sub alis suis." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/67/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/67> ;
      zoo:text "Serpens diabolus uel maligni homines; in euangelio: serpentes genimina uiperarum. Item in alteram partem in euangelio: sicut Moses exaltauit serpentem in deserto." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/3/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/3> ;
      zoo:text "Alae duo testamenta; in Ezechiele: unumquodque duabus alis uelabat corpus suum." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/43/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/43> ;
      zoo:text "Iumentum intellectu et eloquio carens; in psalmo: ut iumentum factus sum apud te." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/1/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/1> ;
      zoo:text "Aues sancti, quod ad superiora corde euolent; in euangelio: et fecit ramos magnos ita ut possent sub umbra eius aues caeli habitare." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/69/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/69> ;
      zoo:text "Scorpius diabolus uel ministri eius; in euangelio: dedi uobis potestatem calcandi super serpentes et scorpiones." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/38/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/38> ;
      zoo:text "Damma idem quod supra." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/24/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/24> ;
      zoo:text "Musca diabolus; in Salamone: muscae moriturae exterminant oleum suauitatis." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/41/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/41> ;
      zoo:text "Uulpes hereticus uel diabolus uel peccator callidus; in euangelio: ite, dicite uulpi illi." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/10/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/10> ;
      zoo:text "Coruus nigredo peccatoris uel daemonis; in Salamone: effodiant eum corui de conuallibus. Item in bonam partem in Cantico canticorum de sponso: crines eius ut abietes, nigri sicut corui." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/56/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/56> ;
      zoo:text "Pecora simpliciores quique, minus praediti rationandi subtilitate; in Salamone: pasce animas pecorum tuorum." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/26/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/26> ;
      zoo:text "Leo dominus: uicit leo de tribu Iuda; item in aliam partem: ne quando rapiat ut leo animam meam." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/54/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/54> ;
      zoo:text "Arietes apostoli uel ecclesiarum principes; in psalmo: adferte domino filios arietum." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/58/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/58> ;
      zoo:text "Caprae iusti interdum ex gentibus uenientes; in Salamone: capillatura tua sicut grex caprarum, quae reuelatae sunt de Galaad." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/22/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/22> ;
      zoo:text "Lucustae populi; in euangelio: esca autem eius erat lucustae." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/28/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/28> ;
      zoo:text "Elephans peccator inmanis; in Regnorum: et adducebant ad Salamonem simias et elephantos." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/52/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/52> ;
      zoo:text "Uitulus Christus siue sancti: tunc inponent super altare tuum uitulos. Et in aliam partem: circumdederunt me uituli multi, hoc est lasciuientes." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/9/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/9> ;
      zoo:text "Pelecanus dominus Christus in passione aut uir sanctus solitudini deditus; in psalmo: similis factus sum pelecano solitudinis." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/13/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/13> ;
      zoo:text "Turtur spiritus sanctus aut uir sanctus aut intellegentia spiritalis; in Canticis canticorum: uox turturis in terra nostra audita est. Sed tunc columba spiritus sanctus dicitur, quando scripturae sacrae manifesta dissertio est; tunc uero turtur spiritus sanctus intellegitur, cum scripturae altis atque obscuris mysteriis eleuantur." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/45/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/45> ;
      zoo:text "Mulus inrationabilis quisque; in psalmo: nolite fieri sicut equus et mulus quibus non est intellectus." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/15/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/15> ;
      zoo:text "Accipiter interdum sanctus, ut puto, rapiens regnum dei; in Iob: numquid in sapientia tua plumescit accipiter?" .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/7/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/7> ;
      zoo:text "Aquilae sancti; in euangelio: ubi fuerit corpus, illuc congregabuntur aquilae. Et in malam partem: pulli aquilarum deuorent eum." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/20/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/20> ;
      zoo:text "Uespertiliones idolorum monstra tenebris dedita; in propheta: ut adoretis talpas et uespertiliones." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/65/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/65> ;
      zoo:text "Uermis Christus pro humilitate adsumpti hominis; in psalmo: ego autem sum uermis et non homo. Item in aliam partem in Esaia: uermis eorum non morietur, id est, siue ipse uermis siue peccati conscientia." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/5/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/5> ;
      zoo:text "Nidus ecclesia aut requies excelsa sanctis; in psalmo: et turtur nidum sibi ubi reponat pullos suos. Et aliter nidus bona conscientia, in qua bonarum cogitationum fetus fouentur atque in opera pariuntur, ut postea filii appellentur; in psalmo: filii tui sicut nouella oliuarum in circuitu mensae tuae." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/50/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/50> ;
      zoo:text "Boues apostoli, qui suscepto iugo Christi euangelii in uomere mundum exarauerint; in psalmo: offeram tibi boues cum hircis." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/33/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/33> ;
      zoo:text "Tigris feminea interdum arrogantia; in libro Iob secundum Hebraeum: tigris periit eo quod non habuerit praedam." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/47/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/47> ;
      zoo:text "Asina corona uel plebs carens dei notitia; in euangelio idem quod supra." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/49/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/49> ;
      zoo:text "Tauri principes populorum; in psalmo: tauri pingues obsederunt me." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/4/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/4> ;
      zoo:text "Pinnae scripturae; in psalmo: pinnae columbae deargentatae." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/63/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/63> ;
      zoo:text "Ranae daemones; in Apocalypsi: et uidi de ore draconis spiritus tres inmundos in modum ranarum, sunt autem spiritus daemoniorum. Item ranae heretici, qui in caeno uilissimorum sensuum conmorantes uana garrulitate blaterare non desinant." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/18/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/18> ;
      zoo:text "Gallus dominus, ut puto, aut sanctus; in Salamone: et gallus ambulans inter gallinas laetus. Et in Iob: quis dedit gallo intellegentiam, et in alteram partem: et asportari te faciam sicut asportatur gallus gallinacius." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/32/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/32> ;
      zoo:text "Aper diabolus; in psalmo: exterminauit eam aper de silua." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/2/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/2> ;
      zoo:text "Uolatus sanctorum excessus in deo uel in scripturis intellectus; in psalmo: et uolabo et requiescam." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/30/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/30> ;
      zoo:text "Ceruus Christus uel sancti: sicut ceruus desiderat ad fontes aquarum." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/35/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/35> ;
      zoo:text "Monoceron hoc est unicornis; in psalmo: et dilectus quem ad modum filius unicornium, id est singularis potentiae uel sanctorum, qui teneant unicum dei uerbum. Et in aliam partem: et a cornibus unicornium humilitatem meam. Unicornes hic superbos uel unum testamentum habentes." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/61/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/61> ;
      zoo:text "Talpae idola uel heretici, qui non uident ueritatem; in Esaia: ut adoretis talpas et uespertiliones." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/44/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/44> ;
      zoo:text "Equus uir sanctus; in Abacuc: qui ascendis super equos tuos; et in malam partem: fallax equus in salutem." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/37/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/37> ;
      zoo:text "Inuleus Christus aut sanctus propter gratiarum uarietatem; in Salamone: similis esto tu, fratruelis meus, dammulae aut hinulo ceruorum." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/68/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/68> ;
      zoo:text "Draco diabolus uel apertus persecutor; in psalmo: tu confregisti caput draconis, dedisti eum escam populo Aethiopum." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/23/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/23> ;
      zoo:text "Apes forma uirginitatis siue sapientiae; in Salamone: uade ad apem et disce quam operatrix sit; et in malam partem in propheta: et api quae est in Assur." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/11/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/11> ;
      zoo:text "Perdix diabolus; in propheta: clamauit perdix, congregauit quae non peperit." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/39/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/39> ;
      zoo:text "Lepus timens deum; in psalmo: petram refugium leporibus et erinaciis." .

<http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/42/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/EUCHERIUS/formulae_spiritalis_intellegentiae/l/42> ;
      zoo:text "Animal homo carnalis; in apostolo: animalis autem homo non percipit ea quae sunt spiritus dei." .


