      a       zoo:Paragraph ;
      zoo:hasAnnotation <http://ns.inria.fr/zoomathia/annotation/24b90949983acff96143762c0adcb02a9098fd0e> , <http://ns.inria.fr/zoomathia/annotation/55bcb0ae7a2104537636289a30fc16e50da48d45> , <http://ns.inria.fr/zoomathia/annotation/970e919659089ada4981874d02d8ece2e352768a> , <http://ns.inria.fr/zoomathia/annotation/e56475619258c74fb513713af583da3491047ef4> , <http://ns.inria.fr/zoomathia/annotation/7aa788a7a5d4fc0f31d77fb5bf8a4580c69f89e0> , <http://ns.inria.fr/zoomathia/annotation/f7f43715ed988ae5b804518ba8a3fe5db3db7eee> , <http://ns.inria.fr/zoomathia/annotation/b52de76c8a30841e19460796c3afd6d47ecdb93c> , <http://ns.inria.fr/zoomathia/annotation/c77308ac959acb52b4ec45139a152419365fcda1> , <http://ns.inria.fr/zoomathia/annotation/9a63ad74c48da969a760c01a7fadf780d6ca9acd> , <http://ns.inria.fr/zoomathia/annotation/0dd4ecc9dcb4db9a44cd020851b2d1762095676e> , <http://ns.inria.fr/zoomathia/annotation/28b3de5c57d5b60dda5b8c9c03fc2c5a00523095> , <http://ns.inria.fr/zoomathia/annotation/fa8f1bfa7b28fa73b73da82ff0c5433a25228cdf> .

