<http://ns.inria.fr/zoomathia/annotation/f9a76d609ddc957350c5ff361f3112ac51652419>
      a       zoo:AutomaticAnnotation ;
      oa:hasBody <http://dbpedia.org/resource/Constantly_(Immature_song)> ;
      oa:hasTarget
              [ oa:hasSelector
                        [ a       oa:TextPositionSelector , oa:TextQuoteSelector ;
                          oa:exact "constantly"
                        ] ;
                oa:hasSource <http://ns.inria.fr/zoomathia/XENOPHON/on_the_cavalry_commander_from_minor_works/e/1/16/text/1>
              ] .

<http://ns.inria.fr/zoomathia/annotation/5e40dbda1ec23622a810b76601ef043bfc2a4d5d>
      a       zoo:AutomaticAnnotation ;
      oa:hasBody <https://opentheso.huma-num.fr/?idc=pcrt0WrjgPTs33&idt=th310> ;
      oa:hasTarget
              [ oa:hasSelector
                        [ a       oa:TextPositionSelector , oa:TextQuoteSelector ;
                          oa:exact "men"
                        ] ;
