                        ] ;
                oa:hasSource <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/39/text/1>
              ] .

<http://ns.inria.fr/zoomathia/annotation/61ac6eb87b4e4c61645d423e0a80175d866b45e2>
      a       zoo:AutomaticAnnotation ;
      oa:hasBody <http://dbpedia.org/resource/Gamma_ray> ;
      oa:hasTarget
              [ oa:hasSelector
                        [ a       oa:TextPositionSelector , oa:TextQuoteSelector ;
                          oa:exact "Yes"
                        ] ;
                oa:hasSource <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/11/text>
              ] .

<http://ns.inria.fr/zoomathia/annotation/74cc508058e5eae3744bea6f99e6f8df72b0d085>
      a       zoo:AutomaticAnnotation ;
      oa:hasBody <http://dbpedia.org/resource/Cannibalism> ;
      oa:hasTarget
              [ oa:hasSelector
                        [ a       oa:TextPositionSelector , oa:TextQuoteSelector ;
                          oa:exact "eats"
                        ] ;
                oa:hasSource <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/38/text>
              ] .

<http://ns.inria.fr/zoomathia/annotation/e0dc6a4511d223d25091b3f5e58cafee69ece3e5>
      a       zoo:AutomaticAnnotation ;
      oa:hasBody <http://dbpedia.org/resource/Apollo> ;
      oa:hasTarget
              [ oa:hasSelector
                        [ a       oa:TextPositionSelector , oa:TextQuoteSelector ;
