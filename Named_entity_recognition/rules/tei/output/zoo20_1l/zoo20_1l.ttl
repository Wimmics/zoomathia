<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l>
      a       zoo:Oeuvre ;
      zoo:author "GRATTIUS" ;
      zoo:date "2026-07-23" ;
      zoo:editor "Unknown editor" ;
      zoo:file "./zoo/zoo20/1l.xml" ;
      zoo:identifier "cynegetica" ;
      zoo:title "Cynegetica" .


<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/23/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/23> ;
      zoo:text "Ne uanum totas genus aspernere per artis ;" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/55/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/55> ;
      zoo:text "Termiteum quatiens procul hinc extorribus ire" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/19/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/19> ;
      zoo:text "sunt qui Seras alant, genus intractabilis irae; at contra faciles magnique Lycaones armis. sed non Hyrcano satis est vehementia gentis tanta suae: petiere ultro fera semina silvis; dat venus accessus et blando foedere iungit. tunc et mansuetis tuto ferus errat adulter in stabulis ultroque gravem succedere tigrin ausa canis maiore tulit de sanguine fetum." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/5/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/5> ;
      zoo:text "Qua cultor Latii per opaca silentia Tybris" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/37/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/37> ;
      zoo:text "Ad longam praestabit opem. tum denique, fetu" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/34/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/34> ;
      zoo:text "effuge qui lata pandit vestigia planta: mollis in officio. siccis ego dura lacertis crura velim et solidos haec in certamina calces. sed frustra longus properat labor, abdita si non altas in latebras unique inclusa marito femina: nec patres veneris sub tempore magnos illa neque emeritae servat fastigia laudis." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/44/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/44> ;
      zoo:text "Abstiterint atroque cadant cum sanguine fibrae :" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/41/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/41> ;
      zoo:text "Vtrumque et prudens et sumptis impiger armis." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/29/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/29> ;
      zoo:text "Et tamen, ut ne prima fauentem pignora fallant," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/57/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/57> ;
      zoo:text "Adgredere. in subito subitast medicina tumultu." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/12/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/12> ;
      zoo:text "Prodidit auctorem! deus ille an proxuma diuos" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/58/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/58> ;
      zoo:text "Ilicet auxiliis fessum solabere corpus" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/8/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/8> ;
      zoo:text "Impulerint ? flet adhuc et porro flebit Adonin" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/26/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/26> ;
      zoo:text "Gratia per nostros unum testabitur usus." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/20/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/20> ;
      zoo:text "Tanta foret uirtus et tantum uellet in armis !" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/62/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/62> ;
      zoo:text "Ne tamen hoc attingat opus: iactantior illi" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/23/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/23> ;
      zoo:text "Seu frustra nimius properat fauor : et tamen illud" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/5/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/5> ;
      zoo:text "Messis, contiguum sorbens de flumine rorem," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/55/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/55> ;
      zoo:text "Edico praesente deo, praesentibus aris," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/16/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/16> ;
      zoo:text "Ergo age luxuriam primo fetusque nocentis" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/37/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/37> ;
      zoo:text "Cum desunt, operis fregitque industria matres," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/52/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/52> ;
      zoo:text "inde lavant aegros: atque ira coercita morbi laxatusque rigor. quae te ne cura timentem differat, et pluvias et Cauri frigora vitent; duc magis, ut nudis incumbunt vallibus aestus, a vento clarique faces ad solis, ut omne exsudent vitium subeatque latentibus ultro quae" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/29/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/29> ;
      zoo:text "Circum omnem aspretis medius qua clauditur orbis" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/37/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/37> ;
      zoo:text "illius et manibus vires sit cura futuras perpensare: levis deducet pondere fratres: nec me pignoribus, nec te mea carmina fallent. protinus et cultus alios et debita fetae blandimenta feres curaque sequere merentem: illa perinde suos, ut erit, de lacte minores ad longam praestabit opem. tum denique, fetae cum desunt operi, fregitque industria matres, transeat in catulos omnis tutela relictos." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/44/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/44> ;
      zoo:text "Inde rape ex ipso qui uulnus fecerit hoste" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/12/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/12> ;
      zoo:text "O felix, tantis quem primum industria rebus" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/58/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/58> ;
      zoo:text "Hinc uitium, hinc illa est auidae uehementia pesti." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/41/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/41> ;
      zoo:text "Quod nisi et accessus et agendi tempora belli" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/57/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/57> ;
      zoo:text "At tu praecipitem qua spes est proxima labem" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/26/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/26> ;
      zoo:text "Hic trepidas artis et uix nouitate sedentes" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/8/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/8> ;
      zoo:text "Victa Venus ceciditque suis Ancaeus in armis," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/20/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/20> ;
      zoo:text "Umber: quanta fides utinam et solertia naris" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/23/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/23> ;
      zoo:text "Tum non est uicti quoi concessere labori." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/62/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/62> ;
      zoo:text "Virtus quam siluas durumque lacessere Martem." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/31/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/31> ;
      zoo:text "hic et semiferam thoum de sanguine prolem finxit. non alio maior sub pectore virtus, sive in lora voces seu nudi ad pignera martis. thoes commissos (clarissima fama) leones et subiere astu et parvis domuere lacertis; nam genus exiguum et pudeat, quam informe, fateri, vulpina species: tamen huic exacta voluntas. at" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/52/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/52> ;
      zoo:text "A uento clarique faces ad solis, ut omne" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/58/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/58> ;
      zoo:text "Stringendae nares et bina ligamina ferro" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/37/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/37> ;
      zoo:text "Transeat in catulos omnis tutella relictos ." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/55/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/55> ;
      zoo:text "Quis scelus aut manibus sumptum aut in pectore motum est'" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/30/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/30> ;
      zoo:text "In partem praedae ueniat comes et sua naris" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/63/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/63> ;
      zoo:text "Centum actus spatiis atque eluctabitur iram." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/12/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/12> ;
      zoo:text "Egit et ignarum perfudit lumine uulgus ?" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/44/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/44> ;
      zoo:text "Virosam eluuiem lacerique per ulceris ora" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/1/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/1> ;
      zoo:text "Auspicio, Diana, tuo. prius omnis in armis" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/58/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/58> ;
      zoo:text "Armorum geminaque cruor ducendus ab aure :" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/8/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/8> ;
      zoo:text "Vt praedexter erat geminisque securibus ingens." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/12/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/12> ;
      zoo:text "Dercylon : haut illo quisquam se iustior egit" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/26/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/26> ;
      zoo:text "Vidit qua propior patuit uia nec sibi turbam" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/41/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/41> ;
      zoo:text "dicantur," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/33/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/33> ;
      zoo:text "Sint celsi uultus, sint hirtae frontibus aures," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/20/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/20> ;
      zoo:text "At fugit aduersos idem quos repperit hostis" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/63/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/63> ;
      zoo:text "sed iuxta vitium posuit deus. at tibi contra Callaecis lustratur quis scruposa Pyrene, non tamen Hispano martem temptare ministro ausim: in muricibus vix ora tenacia ferro concedunt. at tota levi Nasamonia virga fingit equos: ipsis Numidae solvere capistris audax et patiens operum genus. Ille vigebit centum actus spatiis atque eluctabitur iram. nec magni cultus: sterilis quodcumque remisit terra sui tenuesque satis producere rivi." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/34/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/34> ;
      zoo:text "Illa neque emeritae seruat fastidia laudis." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/55/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/55> ;
      zoo:text "hic (dictu mirum atque alias ignobile monstrum) adversis specibus ruptoque e pectore montis venit ovans Austris et multo flumine flammae emicat ipse: manu ramum pallente sacerdos termiteum quatiens 'procul hinc extorribus ire edico praesente deo, praesentibus aris, quis scelus aut manibus sumptum aut in pectore motum est' inclamat: cecidere animi et trepidantia membra." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/23/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/23> ;
      zoo:text "Mirum quam celeres et quantum nare merentur," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/52/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/52> ;
      zoo:text "Exsudent uitium subeatque latentibus ultro" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/5/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/5> ;
      zoo:text "Labitur inque sinus magno uenit ore marinos." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/55/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/55> ;
      zoo:text "Inclamat : cecidere animi et trepidantia membra." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/63/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/63> ;
      zoo:text "Nec magni cultus: sterilis quodcunque remisit" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/31/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/31> ;
      zoo:text "Vulpina species : tamen huic exacta uoluntas" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/62/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/62> ;
      zoo:text "Nec saeuos miratur equos terrena Syene." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/30/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/30> ;
      zoo:text "Ergo ubi plena suo rediit uictoria fine," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/20/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/20> ;
      zoo:text "Excutiet silua magnus pugnator adepta." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/44/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/44> ;
      zoo:text "Sparge manu, uenas dum sucus conprimat acer." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/12/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/12> ;
      zoo:text "Mens fuit, in caecas aciem quae magna tenebras" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/13/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/13> ;
      zoo:text "Ne cessaret iners in uulnere massa ferino" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/1/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/1> ;
      zoo:text "Dona canis diuom, laetas uenantibus artis," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/41/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/41> ;
      zoo:text "Ille tibi egregia iuuenis de pube legendus," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/33/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/33> ;
      zoo:text "Os magnum, et patulis agitatos naribus ignes" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/26/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/26> ;
      zoo:text "Contraxit comitem nec uasa tenentia longe." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/47/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/47> ;
      zoo:text "Auxilia et nostra quidam redit usus ab arte." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/45/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/45> ;
      zoo:text "Illa grauis labes et curast altior illis," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/30/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/30> ;
      zoo:text "Hoc ingens meritum est, haec ultima palma tropaei," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/23/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/23> ;
      zoo:text "At clangore citat quos nondum conspicit apros" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/6/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/6> ;
      zoo:text "Tu licet Haemonios includas retibus ursos." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/11/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/11> ;
      zoo:text "Saepe habet inprudens alieni lucra laboris." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/60/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/60> ;
      zoo:text "tum cadus et viridi fumantia liba feretro praeveniunt teneraque extrudens cornua fronte haedus et ad ramos etiamnum haerentia poma, lustralis de more sacri, quo tota iuventus lustraturque deae proque anno reddit honorem. ergo impetrato respondet multa favore ad partis, qua poscis opem; seu vincere silvas seu tibi fatorum labes exire minasque cura prior, tua magna fides tutelaque virgo." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/5/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/5> ;
      zoo:text "Optuma Cinyphiae, nequid contere, paludes" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/63/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/63> ;
      zoo:text "Fingit equos : ipsis Numidae soluere capistris" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/29/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/29> ;
      zoo:text "Intacto repetens prima ad uestigia gyro." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/29/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/29> ;
      zoo:text "Rusum opus incubuit spatiis ad prospera uersis," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/51/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/51> ;
      zoo:text "At si deformi lacerum dulcedine corpus" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/20/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/20> ;
      zoo:text "Pasce tamen: quaecunque domi sibi crimina fecit," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/2/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/2> ;
      zoo:text "Protegere auxiliis orbemque hac soluere noxa." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/12/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/12> ;
      zoo:text "Dic age Pierio (fas est), Diana, ministro." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/13/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/13> ;
      zoo:text "ergo illum primis nemorum dea finxit in arvis auctoremque operi dignata inscribere magno iussit adire suas et pandere gentibus artes. ille etiam valido primus venabula dente induit et proni moderatus vulneris iram omne moris excepit onus; tum stricta verutis dentibus et gemina subiere hastilia furca et quidam totis clauserunt ensibus hastas, ne cessaret iners in vulnere massa ferino." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/53/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/53> ;
      zoo:text "Alta premunt ruptique ambustis faucibus amnes." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/4/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/4> ;
      zoo:text "Prima iubent tenui nascentem iungere filo" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/48/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/48> ;
      zoo:text "Aestiuos uibrans accensis febribus ignes," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/33/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/33> ;
      zoo:text "Spirent, adstricti succingant ilia uentres," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/65/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/65> ;
      zoo:text "Phoebe, decus meruere, leuis seu iungere currus" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/8/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/8> ;
      zoo:text "Nonne uides ueterum quos prodit fabula rerum" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/47/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/47> ;
      zoo:text "Sed uarii motus nec in omnibus una potestas :" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/45/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/45> ;
      zoo:text "Cum uitium causae totis egere latentes" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/5/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/5> ;
      zoo:text "Ingrati maiora sinus impendia sument." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/63/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/63> ;
      zoo:text "Audax et patiens operum genus." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/30/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/30> ;
      zoo:text "Praemia. sic operi iuuet inseruisse benigno." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/58/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/58> ;
      zoo:text "stringendae nares et bina ligamina ferro armorum, geminaque cruor ducendus ab aure: hinc vitium, hinc illa est avidae vehementia pesti. ilicet auxiliis fessum solabere corpus subsiduasque fraces defusaque Massica prisco sparge cado: Liber tenuis e pectore curas exigit, et morbo Liber medicina furenti. quid dicam tussis, quid inertis damna veterni aut incurvatae siquast tutela podagrae?" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/12/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/12> ;
      zoo:text "Te" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/20/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/20> ;
      zoo:text "Ille tibi et pecudum multo cum sanguine crescet." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/51/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/51> ;
      zoo:text "Persequitur scabies, longi uia pessima leti," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/2/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/2> ;
      zoo:text "Qua primam quaerebat opem dignata repertis" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/4/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/4> ;
      zoo:text "Armorum casses plagiique exordiar astus." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/12/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/12> ;
      zoo:text "Aut fuit in terris diuum obseruantior alter :" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/41/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/41> ;
      zoo:text "Nec uile arbitrium est : quoicumque haec regna" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/23/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/23> ;
      zoo:text "at clangore citat quos nondum conspicit apros Aetola quaecumque canis de stirpe: malignum officium, sive illa metus convicia rupit seu frustra nimius properat favor. et tamen illud ne vanum totas genus aspernere per artis: mirum quam celeres et quantum nare merentur, tum non est victi quoi concessere labori. idcirco variis miscebo gentibus usum: quondam inconsultis mater dabit Vmbrica Gallis sensum agilem, traxere animos de patre Gelonae Hyrcano et vanae tantum Calydonia linguae exibit vitium patre emendata Molosso." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/33/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/33> ;
      zoo:text "Cauda breuis longumque latus discretaque collo" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/8/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/8> ;
      zoo:text "Semideos (illi aggeribus temptare superbis" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/48/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/48> ;
      zoo:text "Ille ubi salsa siti praecepit uiscera longa," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/65/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/65> ;
      zoo:text "Et tibi deuotae magnum pecuaria Cyrrhae," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/7/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/7> ;
      zoo:text "Ante caue : non est umentibus usus in armis," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/30/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/30> ;
      zoo:text "Ergo semper eris, dum carmina dumque manebunt" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/47/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/47> ;
      zoo:text "Admoneo latumque fuga superabitis amnem." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/5/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/5> ;
      zoo:text "Fetus et aprico Tuscorum stupea campo" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/26/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/26> ;
      zoo:text "Sed primum celsa lorum ceruice ferentem," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/23/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/23> ;
      zoo:text "Officium, siue illa metus conuitia rupit" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/63/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/63> ;
      zoo:text "Ausim: in muricibus uix ora tenacia ferro" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/24/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/24> ;
      zoo:text "Illa feras, quae Petroniis bene gloria constat." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/45/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/45> ;
      zoo:text "Quodsi destricto leuis est in uulnere noxa," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/2/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/2> ;
      zoo:text "Tu trepidam bello uitam, Diana, ferino" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/5/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/5> ;
      zoo:text "bis vicenos spatium praetendere passus rete velim plenisque decem consurgere nodis; ingrati maiora sinus impendia sument. optuma Cinyphiae, ne quid cunctere, paludes lina dabunt; Sibyllae de valle Aeolia fetus et aprico Tuscorum stuppea campo messis contiguum sorbens de flumine rorem, qua cultor Latii per opaca silentia Thybris labitur inque sinus magno venit ore marinos." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/29/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/29> ;
      zoo:text "Ferre pedem accessusque abitusque notare ferarum" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/20/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/20> ;
      zoo:text "Sed praeceps uirtus : ipsa uenabitur aula" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/44/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/44> ;
      zoo:text "nec longe auxilium, licet alti vulneris orae abstiterint atroque cadant cum sanguine fibrae: inde rape ex ipso qui vulnus fecerit hoste virosam eluviem lacerique per ulceris ora sparge manu, venas dum sucus comprimat acer: mortis enim patuere viae. tum pura monebo circum labra sequi tenuique includere filo." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/20/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/20> ;
      zoo:text "sed praeceps virtus: ipsa venabitur aula ille tibi et pecudum multo cum sanguine crescet. pasce tamen: quaecumque domi sibi crimina fecit, excutiet silva magnus pugnator adepta. at fugit adversos idem quos repperit hostis Vmber: quanta fides, utinam, et sollertia naris, tanta foret virtus et tantum vellet in armis!" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/33/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/33> ;
      zoo:text "Caesaries neu pexa nimis neu frigoris illa" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/48/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/48> ;
      zoo:text "Scilicet hoc motu stimulisque potentibus acti" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/8/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/8> ;
      zoo:text "Aethera et ah matres ausi attrectare deorum)," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/65/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/65> ;
      zoo:text "Spadices uix Pellaei ualuere Cerauni," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/16/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/16> ;
      zoo:text "termes. ab Eois descendit virga Sabaeis mater odorati multum pulcherruma turis: illa suos usus intractatumque decorem (sic nemorum iussere deae) natalibus hausit arbitriis; at enim multo sunt ficta labore cetera quae silvis errant hastilia nostris: nunquam sponte sua procerus ad aethera termes exiit inque ipsa curvantur stirpe genestae. ergo age luxuriam primo fetusque nocentis detrahe: frondosas gravat indulgentia silvas." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/47/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/47> ;
      zoo:text "Fontem auerte mali. trans altas ducere calles" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/51/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/51> ;
      zoo:text "In primo accessu tristis medicina, sed una" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/12/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/12> ;
      zoo:text "Et Lacedaemoniae primum uidistis Amyclae" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/7/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/7> ;
      zoo:text "Tantum ne subeat uitiorum pessimus umor" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/47/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/47> ;
      zoo:text "Hoc primum effugium leti. tunc ficta ualebunt" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/30/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/30> ;
      zoo:text "Hagnon magne, tibi diuum concessa fauore." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/65/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/65> ;
      zoo:text "onlustrat prata" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/24/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/24> ;
      zoo:text "Sed premit inuentas non inuentura latentis" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/26/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/26> ;
      zoo:text "Glympice, te siluis egit Boeotius Hagnon," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/23/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/23> ;
      zoo:text "Aetola quaecunque canis de stirpe : malignum" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/63/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/63> ;
      zoo:text "Concedunt. at tota leui Nasamonia uirga" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/8/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/8> ;
      zoo:text "imbiberit: tanto respondet longior usus. magnum opus et tangi, nisi cura vincitur, impar. nonne vides veterum, quos prodit fabula rerum, semideos Dilli aggeribus temptare superbis caeli iter et matres ausi attrectare deorum, quam magna mercede meo sine munere silvas impulerint? flet adhuc et porro flebit Adonin victa Venus, ceciditque suis Ancaeus in arvis (et praedexter erat, geminisque securibus ingens)" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/5/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/5> ;
      zoo:text "Lina dabunt : bonus Aeolia de ualle Sibullae" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/45/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/45> ;
      zoo:text "Ipse habet auxilium ualidae natale saliuae." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/2/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/2> ;
      zoo:text "Exegere suas tetigitque industria finem." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/12/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/12> ;
      zoo:text "Arcadium stat fama senem, quem Maenalus altor" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/44/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/44> ;
      zoo:text "Nec longe auxilium, licet alti uulneris orae" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/29/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/29> ;
      zoo:text "Admonet et, si forte loci spes prima fefellit," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/41/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/41> ;
      zoo:text "nec vile arbitrium est: quoicumque haec regna dicantur, ille tibi egregia iuvenis de pube legendus, utrumque et prudens et sumptis impiger armis. quod nisi et accessus et agendi tempora belli noverit et socios tutabitur hoste minores, aut cedent aut illa tamen victoria damnost. ergo in opus vigila factusque ades omnibus armis:" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/33/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/33> ;
      zoo:text "Impatiens ; ualidis tum surgat pectus ab armis," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/26/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/26> ;
      zoo:text "Hagnon Hastilides, Hagnon, quem plurima semper" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/8/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/8> ;
      zoo:text "Quam magna mercede meo sine munere siluas" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/48/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/48> ;
      zoo:text "Moliturque fugas et sedem spernit amatam." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/51/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/51> ;
      zoo:text "Pernicies redimenda anima, quae prima sequaci" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/62/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/62> ;
      zoo:text "ne tamen hoc attingat opus: iactantior illi virtus quam silvas durumque lacessere martem. nec saevos miratur equos terrena Syene scilicet, et Parthis inter sua mollia rura mansit honor; veniat Caudini saxa Taburni Garganumve trucem aut Ligurinas desuper Alpes; ante opus excussis cadet unguibus. et tamen illi est animus fingetque meas se iussus in artes:" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/40/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/40> ;
      zoo:text "Ergo illi ex habitu uirtutisque indole priscae" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/60/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/60> ;
      zoo:text "Lustralis de more sacri, quo tota iuuentus" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/53/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/53> ;
      zoo:text "Introsum reditus, circum atrae moenia siluae" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/7/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/7> ;
      zoo:text "Inter opus clausaeque malum fecere paludes," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/63/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/63> ;
      zoo:text "Callaecis lustratur quis scruposa Pyrene" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/22/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/22> ;
      zoo:text "Sicut Acarnanes subierunt proelia furto," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/30/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/30> ;
      zoo:text "ergo ubi plena suo rediit victoria fine, in partem praedae veniat comes et sua norit praemia: sic operi iuvet inseruisse benigne. hoc ingens meritumst, haec ultima palma tropaei, Hagnon magne, tibi divum concessa favore: ergo semper eris, dum carmina dumque manebunt silvarum dotes atque arma Diania terris." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/2/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/2> ;
      zoo:text "sed primum auspicium deus artibus altaque circa firmamenta dedit; tum partis quisque secutus exegere suas tetigitque industria finem. tu trepidam bello, vitam, Diana, ferino qua primam quaerebat opem, dignata repertis protegere auxiliis orbemque hac solvere noxa." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/15/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/15> ;
      zoo:text "Cornus et umbrosae Veneris per litora myrtus" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/45/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/45> ;
      zoo:text "Seu tactu inpositis mulcent p" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/42/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/42> ;
      zoo:text "Det sonitum et curuae rumpant non peruia falces." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/65/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/65> ;
      zoo:text "rum fessas imitantur terga fauillas." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/1/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/1> ;
      zoo:text "Ordo et contiguas didicere ex artibus artis" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/59/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/59> ;
      zoo:text "Spicatasque faces sacrum ad nemorale Dianae" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/10/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/10> ;
      zoo:text "Tam mollis tactu et non sit creberruma nexu," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/27/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/27> ;
      zoo:text "Thessalium quadriga decus, quam gloria patrum" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/34/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/34> ;
      zoo:text "Effuge qui lata pandit uestigia planta :" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/57/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/57> ;
      zoo:text "Nec mora: si medias exedit noxia fibras," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/47/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/47> ;
      zoo:text "fontem averte mali. trans altas ducere calles admoneo latumque fuga superabitis amnem. hoc primum effugium leti: tunc ficta valebunt auxilia et nostra quidam redit usus ab arte. sed varii motus nec in omnibus una potestas: disce vices et quae tutelast proxima tempta." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/16/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/16> ;
      zoo:text "Termes. ab Eois descendit uirga Sabaeis," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/39/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/39> ;
      zoo:text "Atqui diues eras fluminis aurea uenis." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/30/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/30> ;
      zoo:text "Siluarum dotes atque arma Diania terris." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/7/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/7> ;
      zoo:text "Nulla fides. ergo, seu pressa flumina ualle" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/60/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/60> ;
      zoo:text "Lustraturque deo proque anno reddit honorem." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/63/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/63> ;
      zoo:text "Non tamen Hispano Martem temptare ministro" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/28/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/28> ;
      zoo:text "Mandit humum celsisue adprensat naribus auras," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/15/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/15> ;
      zoo:text "omnem." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/6/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/6> ;
      zoo:text "Armamenta operi : grauis est tutella, sed illis" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/56/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/56> ;
      zoo:text "Defugit ab sacris rursumque reconditur antro :" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/45/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/45> ;
      zoo:text "(Id satis) aut nigrae circum picis unguine signant." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/22/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/22> ;
      zoo:text "Azorusque Pheraeque et clandestinus Acarnan." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/1/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/1> ;
      zoo:text "Hinc omne auxilium uitae rectusque reluxit" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/65/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/65> ;
      zoo:text "ra illi badiosque legunt" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/59/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/59> ;
      zoo:text "Idcirco aeriis molimur compita lucis" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/27/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/27> ;
      zoo:text "Excitat et primae spes ambitiosa coronae." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/10/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/10> ;
      zoo:text "Sed quam clara tuis et pinguis pluma sub armis," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/57/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/57> ;
      zoo:text "Huic fas auxilium et Vulcania tangere dona." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/34/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/34> ;
      zoo:text "Mollis in officio. siccis ego dura lacertis" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/12/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/12> ;
      zoo:text "Per non adsuetas metantem retia ualles" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/39/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/39> ;
      zoo:text "Scilicet ad summam ne quid restaret habendum" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/18/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/18> ;
      zoo:text "lustramus? prima illa canum, non ulla per artis cura prior, sive indomitos vehementior hostis nudo marte premas seu bellum ex arte ministres. mille canum patriae ductique ab origine mores quoique sua. magna indocilis dat proelia Medus magnaque diversos extollit gloria Celtas. arma negant contra martemque odere Geloni, sed natura sagax: Perses in utroque paratus." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/60/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/60> ;
      zoo:text "Ergo inpetrato respondet multa fauore" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/16/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/16> ;
      zoo:text "(Sic nemorum iussere deae) natalibus hausit" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/39/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/39> ;
      zoo:text "Et sequeris demens alienam, Graecia, culpam," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/7/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/7> ;
      zoo:text "Illa uel ad flatus Helices oppande serenae" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/47/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/47> ;
      zoo:text "Disce uices et quae tutelast proxima tempta." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/5/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/5> ;
      zoo:text "Rete uelim plenisque decem consurgere nodis :" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/45/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/45> ;
      zoo:text "Contra pande uiam fallentisque argue causas." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/27/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/27> ;
      zoo:text "Turba loci, maiore secat spatia extera gyro" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/15/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/15> ;
      zoo:text "Disce agedum et ualidis delectum hastilibus" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/28/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/28> ;
      zoo:text "Sed ne qua ex nimio redeat iactura fauore" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/22/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/22> ;
      zoo:text "Comparat his uersuta suas Athamania fraudes" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/6/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/6> ;
      zoo:text "Cannabias nutrit siluas, quam commoda nostro" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/35/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/35> ;
      zoo:text "primi complexus, dulcissuma prima voluptas (hunc veneri dedit impatiens natura furorem), si tenuit custos et mater adultera non est. da requiem gravidae solitosque remitte labores: vix oneri super illa suo. tum deinde monebo, ne matrem indocilis natorum turba fatiget, percensere notis iamque inde excernere pravos." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/29/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/29> ;
      zoo:text "et tamen, ut ne prima faventem pignora fallant, circum omnem aspretis medius qua clauditur orbis ferre pedem accessusque abitusque notare ferarum admonet et, si forte loco spes prima fefellit, rusum opus incubuit spatiis; at, prospera si res, intacto repetet prima ad vestigia gyro." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/10/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/10> ;
      zoo:text "Inplicet atque ipso mendosa coarguat usu." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/59/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/59> ;
      zoo:text "Ipsaque per flores medio in discrimine luci" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/27/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/27> ;
      zoo:text "Atque hic egressu iam tum sine fraude reperto" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/59/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/59> ;
      zoo:text "mille tenent pestes curaque potentia maior. mitte age (non opibus tanta est fiducia nostris), mitte, anime: ex alto ducendum numen Olympo, supplicibusque vocanda sacris tutela deorum. idcirco aeriis molimur compita lucis spicatasque faces sacrum ad nemorale Dianae sistimus et solito catuli velantur honore, ipsaque per flores medio in discrimine luci stravere arma sacris et pace vacantia festa." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/57/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/57> ;
      zoo:text "Regnantem excutiens morbum. deus auctor, et" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/16/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/16> ;
      zoo:text "Illa suos usus intractatumque decorem" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/39/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/39> ;
      zoo:text "Tu quoque luxuria fictas dum colligis artes" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/65/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/65> ;
      zoo:text "Venanti melius pugnat color. optima nigri" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/60/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/60> ;
      zoo:text "Ad partis, qua poscis opem, seu uincere siluas" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/39/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/39> ;
      zoo:text "O quantum et quotiens decoris frustrata paterni !" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/63/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/63> ;
      zoo:text "Sed iuxta uitium posuit deus. at tibi contra" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/7/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/7> ;
      zoo:text "Siue improuisus caelo perfuderit imber," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/46/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/46> ;
      zoo:text "Inde emissa lues et per contagia morbi" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/45/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/45> ;
      zoo:text "Morborum in uitio facilis med" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/15/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/15> ;
      zoo:text "Magnum opus et uolucres quondam fecere sagittae." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/28/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/28> ;
      zoo:text "Lex dicta officiis, ne uoce lacesseret hostem" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/5/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/5> ;
      zoo:text "Et bis uicenos spatium praetendere passus" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/6/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/6> ;
      zoo:text "At pauper rigui custos Alabandius horti" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/1/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/1> ;
      zoo:text "Proserere, hinc demens cecidit uiolentia rétro." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/58/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/58> ;
      zoo:text "Aut incuruatae siquast tutela podagrae ?" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/27/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/27> ;
      zoo:text "Incubuit , spatiis qualis permissa Lechaeis" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/59/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/59> ;
      zoo:text "Sistimus et solito catuli uelantur honore," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/10/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/10> ;
      zoo:text "Ne reprensa suis properantem linea pinnis" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/57/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/57> ;
      zoo:text "His laue praesidiis adfectaque corpora mulce," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/16/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/16> ;
      zoo:text "Mater odorati multum pulcherruma turis." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/65/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/65> ;
      zoo:text "Vsus, seu nostras agere in sacraria tensas :" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/60/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/60> ;
      zoo:text "Seu tibi fatorum labes exire minasque" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/6/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/6> ;
      zoo:text "Ostendit longe fraudem atque exterruit hostis." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/16/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/16> ;
      zoo:text "Caetera quae siluis errant hastilia nostris." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/53/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/53> ;
      zoo:text "O rerum prudens quantam experientia uulgus" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/17/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/17> ;
      zoo:text "post ubi proceris generosa stirpibus arbor se dederit teretisque ferent ad sidera virgae, stringe notas circum et gemmantis exige versus. his, si quis vitium nociturus sufficit, umor ulceribus fluet et venas durabit inertis. in quinos sublata pedes hastilia plena caede manu, dum pomiferis advertitur annus frondibus et tepidos autumnus continet imbres. sed cur exiguis tantos in partibus orbes" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/46/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/46> ;
      zoo:text "Venere in uulgum iuxtaque exercitus ingens" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/40/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/40> ;
      zoo:text "Prospicies , quae sit ratio et quo fine regenda." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/27/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/27> ;
      zoo:text "Primae lucis opus : tum signa uapore ferino" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/52/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/52> ;
      zoo:text "Differat, et pluuias et Cauri frigora uitent ;" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/15/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/15> ;
      zoo:text "Armauit comites. ne tela relinquite diuae :" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/7/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/7> ;
      zoo:text "Idcirco et primas linorum tangere messes" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/23/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/23> ;
      zoo:text "Quondam inconsultis mater dabit Vmbrica Gallis" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/28/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/28> ;
      zoo:text "Neue leuem praedam aut propioris pignora lucri" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/41/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/41> ;
      zoo:text "Ergo in opus uigilafactusque ades omnibus armis :" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/35/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/35> ;
      zoo:text "Percensere notis iamque inde excernere paruos." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/58/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/58> ;
      zoo:text "Quid dicam tussis, quid maesti damna ueterni" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/1/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/1> ;
      zoo:text "Inconsulti homines uitaque erat error in omni." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/64/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/64> ;
      zoo:text "Sic et Strymonio facilis tutela Bisaltae :" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/10/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/10> ;
      zoo:text "Et satis armorum est. haec clara luce coruscant," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/17/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/17> ;
      zoo:text "Sed cur exiguis tantos in partibus orbes" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/34/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/34> ;
      zoo:text "Altas in latebras unique inclusa marito est" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/6/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/6> ;
      zoo:text "Ipse in materia damnosus candor inerti" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/53/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/53> ;
      zoo:text "Materiem largita boni, si uincere curent" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/16/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/16> ;
      zoo:text "Arbitriis : at enim multo sunt ficta labore" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/7/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/7> ;
      zoo:text "Vel caligineo laxanda reponito fumo." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/54/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/54> ;
      zoo:text "Vulcano condicta domus. quam subter eunti stagna sedent venis oleoque madentia vivo. huc defecta mala pecuaria tabe saepe trahi victosque malo graviore magistros. 'te primum, Vulcane, loci, pacemque precamur, incola sancte, tuam: da fessis ultima rebus auxilia et, meriti si nulla est noxia tanti, tot miserare animas liceatque attingere fontis, sancte, tuos' ter quisque vocant, ter pinguia libant tura foco, struitur ramis felicibus ara." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/46/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/46> ;
      zoo:text "Aequali sub labe ruit nec uiribus ullis" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/52/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/52> ;
      zoo:text "Sic magis, ut nudis incumbunt uallibus aestus," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/15/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/15> ;
      zoo:text "Ipsa arcu Lyciaque suas Diana pharetra" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/7/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/7> ;
      zoo:text "tantum ne subeat vitiorum pessimus umor ante cave: non est umentibus usus in armis, nulla fides. ergo seu pressa flumina valle inter opus clausaeque malum fecere paludes, sive improvisus caelo perfuderit imber, illa vel ad flatus Helices oppande serenae vel caligineo laxanda reponite fumo. idcirco et primas linorum tangere messes ante vetant quam maturis accenderit annum ignibus et claro Plias se prompserit ortu." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/45/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/45> ;
      zoo:text "At si pernicies angusto pascitur ore," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/40/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/40> ;
      zoo:text "Scilicet exiguis magna sub imagine rebus" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/27/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/27> ;
      zoo:text "Intemerata legens, si quast qua fallitur eius" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/28/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/28> ;
      zoo:text "Amplexus primos nequicquam effunderet actus ;" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/23/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/23> ;
      zoo:text "Idcirco uariis miscebo gentibus usum." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/58/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/58> ;
      zoo:text "Exiget, est morbo Liber medicina furenti." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/28/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/28> ;
      zoo:text "Iam uero inpensum melior fortuna laborem" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/63/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/63> ;
      zoo:text "Terra sui tenuesque sitim producere riui." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/1/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/1> ;
      zoo:text "Spes fuit et nuda siluas uirtute mouebant" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/59/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/59> ;
      zoo:text "Strauere arma sacris et pace uacantia festa." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/42/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/42> ;
      zoo:text "(arma acuere virum); tegat imas fascia suras; sit pellis vitulina, suis et tergore fulvo ire decet, niteant canaque e maele galeri, ima Toletano praecingant ilia cultro terribilemque manu vibrata falarica dextra det sonitum et curvae rumpant non pervia falces." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/15/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/15> ;
      zoo:text "Ne leue uulnus eat neu sit breuis impetus illi." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/45/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/45> ;
      zoo:text "Corporibus seraque aperitur noxia summa." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/10/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/10> ;
      zoo:text "Tantum inter niuei iungantur uellera cygni," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/34/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/34> ;
      zoo:text "Femina. nec partae Veneris sub tempore munus" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/60/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/60> ;
      zoo:text "Cura prior, tua magna fides tutelaque, uirgo." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/48/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/48> ;
      zoo:text "pluruma per catulos rabies invictaque tardis praecipitat letale malum: sit tutius ergo antire auxiliis et primas vincere causas. namque subit, nodis qua lingua tenacibus haeret, (vermiculum dixere) mala atque incondita pestis. ille ubi salsa siti praecepit viscera longe, aestivos vibrans accensis febribus ignes, moliturque fugas et sedem spernit amaram. scilicet hoc motu stimulisque potentibus acti" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/53/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/53> ;
      zoo:text "Desidiam et gratos agitando prendere finis !" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/6/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/6> ;
      zoo:text "Velatur sonipes aestiui turba Canopi :" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/1/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/1> ;
      zoo:text "Dona cano divum, laetas venantibus artis, auspicio, Diana, tuo; prius omnis in armis spes fuit et nuda silvas virtute movebant inconsulti homines vitaque erat error in omni. post alia, propiore, via meliusque profecti te sociam, Ratio, rebus sumpsere gerendis; hinc omne auxilium vitae rectusque reluxit ordo et contiguas didicere ex artibus artis proserere, hinc demens cecidit violentia retro." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/61/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/61> ;
      zoo:text "restat equos finire notis, quos arma Dianae admittant: non omne meas genus audet in artis. est vitium ex animo, sunt quos imbellia fallant corpora, praeveniens quondam est incommoda virtus. consule, Penei qualis perfunditur amne Thessalus aut patriae quem conspexere Mycenae glaucum: nempe ingens, nempe ardua fundet in auras crura. quis Eleas potior lustravit harenas?" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/46/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/46> ;
      zoo:text "Aut merito ueniast aut spes exire precanti." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/16/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/16> ;
      zoo:text "Exiit inque ipsa curuantur stirpe genistae." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/40/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/40> ;
      zoo:text "Ad caelum uirtus summosque tetendit honores." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/52/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/52> ;
      zoo:text "Inde lauant aegros : ast ira coercita morbi" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/28/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/28> ;
      zoo:text "Cum sequitur iuxtaque domus quaesita ferarum," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/1/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/1> ;
      zoo:text "Te sociam, ratio, rebus sumpsere gerendis." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/58/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/58> ;
      zoo:text "Sparge cado : Liber tenuis e pectore curas" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/65/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/65> ;
      zoo:text "et terras omni praecepimus usu." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/15/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/15> ;
      zoo:text "Quocirca et iaculis habilem perpendimus usum," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/41/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/41> ;
      zoo:text "Nouerit et socios tutabitur hoste minores," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/10/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/10> ;
      zoo:text "Turbat odor siluas meliusque alterna ualet res." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/34/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/34> ;
      zoo:text "Crura uelim et solidos haec in certamina calces ." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/64/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/64> ;
      zoo:text "Qui ludus Siculis. quid tum, si turpia colla" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/53/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/53> ;
      zoo:text "Est in Trinacria specus ingens rupe cauique" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/16/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/16> ;
      zoo:text "Numquam sponte sua procerus ad aera termes" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/6/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/6> ;
      zoo:text "Vix operata suo sacra ad Bubastia lino" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/46/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/46> ;
      zoo:text "Quod siue a Stygia letum Proserpina nocte" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/40/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/40> ;
      zoo:text "Inposuere orbi Romam caput, actaque ab illis" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/52/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/52> ;
      zoo:text "Laxatusque rigor. quae te ne cura timentem" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/22/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/22> ;
      zoo:text "Sic canis illa suos taciturna superuenit hostis." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/7/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/7> ;
      zoo:text "Ante uetant quam maturis accenderit annum" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/12/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/12> ;
      zoo:text "o felix, tantis quem primum industria rebus prodidit auctorem! deus ille an proxuma divos mens fuit, in caecas aciem quae magna tenebras egit et ignarum perfudit lumine vulgus? dic age Pierio (fas est) Diana, ministro. Arcadium stat fama senem, quem Maenalus auctor et Lacedaemoniae primum vidistis Amyclae per non adsuetas metantem retia valles Dercylon. haut illo quisquam se iustior egit, hau fuit in terris divum observantior alter:" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/36/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/36> ;
      zoo:text "signa dabunt ipsi. teneris vix artibus haeret ille tuos olim non defecturus honores, iamque illum impatiens aequae vehementia sortis extulit: adfectat materna regna sub alvo, ubera tota tenet, a tergo liber aperto, dum tepida indulget terris clementia mundi; verum ubi Caurino perstrinxit frigore vesper, irreptat turbaque potens operitur inerti." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/65/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/65> ;
      zoo:text "tum Italiae (sic di uoluere parentes)" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/11/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/11> ;
      zoo:text "Venator pedicas quam dissimulantibus armis," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/28/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/28> ;
      zoo:text "Vt sciat occultos et signis arguat hostes." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/41/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/41> ;
      zoo:text "Aut cedent aut illa tamen uictoria damnost." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/1/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/1> ;
      zoo:text "Post alia propiore uia meliusque profecti" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/58/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/58> ;
      zoo:text "Subsiduasque fraces defusaque Massica prisco" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/64/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/64> ;
      zoo:text "Possent Aetnaeas utinam se ferre per arces," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/10/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/10> ;
      zoo:text "Terribiles species, at uolture dirus auaro" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/34/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/34> ;
      zoo:text "Sed frustra longus properat labor, abdita si non" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/24/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/24> ;
      zoo:text "scilicet ex omni florem virtute capessunt et sequitur natura favens. at te leve si qua tangit opus pavidosque iuvat compellere dorcas aut versuta sequi leporis vestigia parvi, Petroniost haec fama cano, volucresque Sycambros et pictam macula Vertraham delige flava: ocior adfectu mentis pennaque cucurrit, sed premit inventas, non inventura latentis illa feras, quae Petroniis bene gloria constat. quod si" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/39/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/39> ;
      zoo:text "Sic et Achaemenio cecidisti, Lydia, Cyro :" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/17/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/17> ;
      zoo:text "His si quis uitium nociturus sufficit umor," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/46/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/46> ;
      zoo:text "Extulit et Furiis commissam ulciscitur iram," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/32/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/32> ;
      zoo:text "Iunge pares ergo et maiorum pignore signa" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/6/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/6> ;
      zoo:text "Tag:Hispanaeque alio spectantur Saetabis usu." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/61/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/61> ;
      zoo:text "Consule, Penei qualis perfunditur amne" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/14/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/14> ;
      zoo:text "Aut contra ut tenero destrictas cortice uirgas" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/53/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/53> ;
      zoo:text "Qua facta est medicina uadis. nec non tamen" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/11/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/11> ;
      zoo:text "Quid? qui dentatas iligno robore clausit" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/50/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/50> ;
      zoo:text "Sunt qui lucifugae cristas inducere maelis" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/28/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/28> ;
      zoo:text "Aut effecta leui testatur gaudia cauda" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/21/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/21> ;
      zoo:text "Quid freta si Morinum dubio refluentia ponto" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/6/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/6> ;
      zoo:text "at contra nostris imbellia lina Faliscis Hispanique alio spectantur Saetabis usu. vix operata suo sacra ad Bubastia lino velatur sonipes aestivi turba Canopi: ipse in materia damnosus candor inerti ostendit longe fraudem atque exterruit hostis. at pauper rigui custos Alabandius horti cannabinas nutrit silvas, quam commoda nostro armamenta operi. gravis est tutela, sed illis tu licet Haemonios includas retibus ursos." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/64/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/64> ;
      zoo:text "Cantatus Graiis Acragas uictaeque fragosum" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/28/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/28> ;
      zoo:text "sed ne qua ex nimio redeat iactura favore, lex dicta officiis: neu voce lacesseret hostem neve levem praedam aut propioris pignora lucri amplexus primos nequiquam effunderet actus; iam vero impensum melior fortuna laborem cum sequitur iuxtaque domus quaesita ferarum, et sciat occultos et signis arguat hostes: (aut effecta levi testatur gaudia cauda aut ipsa infodiens uncis vestigia plantis mandit humum celsisve adprensat naribus auras);" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/35/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/35> ;
      zoo:text "Si tenuit fastus et mater adultera non est," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/49/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/49> ;
      zoo:text "Ante relata suas quam nox bene conpleat umbras" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/3/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/3> ;
      zoo:text "Maenaliusque puer domitrixque Idaea leonum" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/43/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/43> ;
      zoo:text "Est aliud quod praestet opem placabile numen." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/17/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/17> ;
      zoo:text "Vlceribus fluet et uenas durabit inertis ." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/25/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/25> ;
      zoo:text "maturo pressantes gaudia lusu dissimulare feras tacitique accedere possent, illis omne decus, quod nunc, metagontes, habetis, constaret: silva sed virtus irrita damnost. at vestrum non vile genus, non patria, vulgo Sparte quos et Creta suos promittit alumnos:" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/46/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/46> ;
      zoo:text "Seu uitium ex alto spiratque uaporibus aether" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/9/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/9> ;
      zoo:text "Ipse deus cultorque feri Tirynthius orbis," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/49/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/49> ;
      zoo:text "Nec longa in facto medicinast ulcere : purum" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/6/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/6> ;
      zoo:text "At contra nostris imbellia lina Faliscis," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/9/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/9> ;
      zoo:text "ipse deus cultorque feri Tirynthius orbis, quem mare, quem tellus, quem praeceps ianua Ditis omnia temptantem, qua laus erat obvia, passa hinc decus et famae primum impetravit honorem. exige si qua meis respondet ab artibus ergo gratia quae vires fallat collata ferinas: sunt quibus immundo decerptae vulture plumae instrumentum operis fuit et non parva facultas." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/32/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/32> ;
      zoo:text "Inter opus, quo sera cadit prudentia damno." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/61/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/61> ;
      zoo:text "Thessalus aut patriae quem conspexere Mycenae" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/11/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/11> ;
      zoo:text "hic magis in cervos valuit metus; ast ubi lentae interdum Libyco fucantur sandyce pennae linteaque expositis lucent anconibus arma, rarum si qua metus eludet belua falsos. nam fuit et laqueis aliquis curracibus usus: cervino iussere magis contexere nervo; fraus teget insidias habitu mentita ferino. quid qui dentatas iligno robore clausit venator pedicas, quam dissimulantibus armis saepe habet imprudens alieni lucra laboris!" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/53/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/53> ;
      zoo:text "illum" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/14/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/14> ;
      zoo:text "Quam longa exigui spicant hastilia dentes !" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/40/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/40> ;
      zoo:text "Temperet, hunc spectet siluas domitura iuuentus." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/57/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/57> ;
      zoo:text "Quod primam si fallet opem dimissa facultas," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/11/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/11> ;
      zoo:text "Fraus teget insidias habitu mentita ferino)." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/50/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/50> ;
      zoo:text "Iussere aut sacris conserta monilia conchis" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/3/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/3> ;
      zoo:text "Naides et Latii Faunus" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/28/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/28> ;
      zoo:text "Aut ipsa infodiens uncis uestigia plantis" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/38/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/38> ;
      zoo:text "Lacte nouam pubem facilique tuebere maza, os" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/35/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/35> ;
      zoo:text "Da requiem grauidae solitosque remitte labores :" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/9/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/9> ;
      zoo:text "Quem mare, quem tellus, quempraeceps ianua Ditis" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/49/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/49> ;
      zoo:text "Sparge salem et tenui permulce uulnus oliuo :" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/64/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/64> ;
      zoo:text "Aut tenuis dorso curuatur spina ? per illos" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/40/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/40> ;
      zoo:text "ergo illi ex habitu virtutisque indole priscae imposuere orbi Romam caput, actaque ab illis ad caelum virtus summosque tetendit honores. scilicet exiguis magna sub imagine rebus prospicies, quae sit ratio, et quo fine regendae. idcirco imperium catulis unusque magister additur: ille dapes poenamque operamque moramque temperet, hunc spectet silvas domitura iuventus." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/17/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/17> ;
      zoo:text "In quinos sublata pedes hastilia plena" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/61/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/61> ;
      zoo:text "Corpora, praeueniens quondam est incommoda" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/46/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/46> ;
      zoo:text "Pestiferis, seu terra suos populatur honores," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/49/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/49> ;
      zoo:text "Iam teneris elementa mali causasque recidunt." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/14/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/14> ;
      zoo:text "Omnia tela modi melius finxere salubres." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/32/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/32> ;
      zoo:text "Qui genuere sua pecus hoc inmane iuuenta." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/53/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/53> ;
      zoo:text "Spumosi catulos mergentem litoris aestu" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/54/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/54> ;
      zoo:text "Sancte tuos.' ter quisque uocant, ter pinguia" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/40/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/40> ;
      zoo:text "Additur : ille dapes poenamque operamque" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/35/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/35> ;
      zoo:text "Vix oneri super illa suo. tum deinde monebo," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/21/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/21> ;
      zoo:text "O quanta est merces et quantum inpendia supra !" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/14/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/14> ;
      zoo:text "blandimenta vagae fugies novitatis: ibidem exiguo nimiove nocent. sed lubricus errat mos et ab expertis festinant usibus omnes. quid, Macetum immensos libeat si dicere contos? quam longa exigui spicant hastilia dentes! aut contra ut tenero destrictas cortice virgas praegravat ingenti pernix Lucania cultro! omnia tela modi melius finxere salubres," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/64/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/64> ;
      zoo:text "Ille meis , quoius dociles pecuaria foetus" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/3/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/3> ;
      zoo:text "adscivere tuo comites sub nomine divae centum: omnes nemorum, umentes de fontibus omnes Naides, et Latii satyri Faunusque subibant Maenaliusque puer, domitrixque Idaea leonum mater, et inculto Silvanus termite gaudens. his ego praesidibus nostram defendere sortem contra mille feras et non sine carmine iussus carmine et arma dabo et venandi persequar artis." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/46/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/46> ;
      zoo:text "inde emissa lues et per contagia morbi venere in vulgum fusaque exercitus ingens aequali sub labe ruit, nec viribus ullis aut merito veniast aut spes exire precanti. quod sive a Stygia letum Proserpina nocte extulit et Furiis commissam ulciscitur iram, seu vitium ex alto spiratque vaporibus aether pestiferis, seu terra suos populatur honores:" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/43/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/43> ;
      zoo:text "Scilicet ad magnum maior ducenda laborem" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/17/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/17> ;
      zoo:text "Caede manu dum pomiferis aduertitur amnis" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/3/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/3> ;
      zoo:text "His ego praesidibus nostram defendere sortem" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/11/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/11> ;
      zoo:text "(Ceruino iussere magis contexere neruo :" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/50/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/50> ;
      zoo:text "Si referam ? non illa metus solatia falsi" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/61/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/61> ;
      zoo:text "uirtus." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/32/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/32> ;
      zoo:text "Feturam prodantque tibi metagonta parentes," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/49/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/49> ;
      zoo:text "In furias uertere canes. ergo insita ferro" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/14/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/14> ;
      zoo:text "Praegrauat ingenti pernix Lucania cultro !" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/40/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/40> ;
      zoo:text "Idcirco imperium catulis unusque magister" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/53/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/53> ;
      zoo:text "Respicit et facilis Paean adiuuit in artes." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/35/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/35> ;
      zoo:text "Ne matrem indocilis natorum turba fatiget," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/50/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/50> ;
      zoo:text "Tam longam traxere fidem. collaribus ergo" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/43/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/43> ;
      zoo:text "haec tua militia est. quin et Mavortia bello vulnera et errantis per tot divertia morbos causasque adfectusque canum tua cura tuerist. stat Fatum supra totumque avidissimus Orcus pascitur et nigris orbem circumsonat alis. scilicet ad magnum maior ducenda laborem cura, nec expertos fallet deus: huic quoque nostrae est aliud, quod praestet opus, placabile numen." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/64/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/64> ;
      zoo:text "Nebroden liquere ferae : o quantus in armis" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/21/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/21> ;
      zoo:text "Veneris atque ipsos libeat penetrare Britannos ?" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/22/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/22> ;
      zoo:text "comparat his versuta suas Athamania ... ACorusque Pheraeque et clandestinus Acarnan: sicut Acarnanes subierunt proelia furto, sic canis illa suos taciturna supervenit hostis." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/17/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/17> ;
      zoo:text "Frondibus et tepidos autumnus continet imbres." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/3/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/3> ;
      zoo:text "Mater et inculto Siluanus termite gaudens." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/43/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/43> ;
      zoo:text "Cura, nec expertos fallet. deus hic quoque noster," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/42/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/42> ;
      zoo:text "Arma acuere uiam. tegat imas fascia suras" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/11/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/11> ;
      zoo:text "Nam fuit et laqueis aliquis curracibus usus" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/39/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/39> ;
      zoo:text "At qualis nostris, quam simplex mensa Camillis !" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/38/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/38> ;
      zoo:text "Tollit : sed ratio uitiis adeuntibus opstat.." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/14/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/14> ;
      zoo:text "Exiguo nimioue nocent. sed lubricus errat" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/49/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/49> ;
      zoo:text "in furias vertere canes. ergo insita ferro iam teneris elementa mali causasque recidunt. nec longa in facto medicinast ulcere: purum sparge salem et tenui permulce vulnus olivo: ante relata suas quam nox bene compleat umbras, ecce aderit factique oblitus vulneris ultro blanditur mensis Cereremque efflagitat ore. quid, priscas artes inventaque simplicis aevi," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/59/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/59> ;
      zoo:text "Mille tenent pestes curaque potentia maior." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/54/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/54> ;
      zoo:text "Auxilia et, meriti si nulla est noxia tanti," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/64/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/64> ;
      zoo:text "Ausit, uix merita quas signat Achaia palma ?" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/14/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/14> ;
      zoo:text "Blandimenta uagae fugies nouitatis : ibidem" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/21/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/21> ;
      zoo:text "Protinus (haec una est catulis iactura Britannis)," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/3/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/3> ;
      zoo:text "Carmine et arma dabo uenanti et persequar artis" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/56/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/56> ;
      zoo:text "Illum agat infandae comes huc audacia culpae :" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/11/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/11> ;
      zoo:text "Rarum si qua metus eludat belua falsos." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/57/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/57> ;
      zoo:text "Artem aluit natura suam. quae robore pestis" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/42/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/42> ;
      zoo:text "is inulina suis et tergore fuluo" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/32/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/32> ;
      zoo:text "non est alius quem tanta ad munia fetus exercere velis, aut te tua culpa refellet inter opus, quom sera cadit prudentia damno. iunge pares ergo et maiorum pignore signa feturam prodantque tibi metagonta parentes, qui genuere sua pecus hoc inmane iuventa. et primum expertos animi, quae gratia primast, in venerem iungam. tum sortis cura secunda, ne renuat species aut quem detractet honorem." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/39/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/39> ;
      zoo:text "Qui tibi cultus erat post tot, Serrane, triumphos !" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/17/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/17> ;
      zoo:text "Post ubi proceris generosa stirpibus arbor" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/60/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/60> ;
      zoo:text "Tum cadus et uiridi fumantia liba feretro" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/38/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/38> ;
      zoo:text "Haec illast Pharios quae fregit noxia reges," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/54/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/54> ;
      zoo:text "Tot miserare animas liceatque attingere fontis," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/21/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/21> ;
      zoo:text "Si non ad speciem mentiturosque decores" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/64/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/64> ;
      zoo:text "Sufficient ! quis Chaonias contendere contra" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/11/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/11> ;
      zoo:text "Linteaque expositis lucent anconibus arma," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/57/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/57> ;
      zoo:text "ipsa" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/56/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/56> ;
      zoo:text "Sollicitare caput patriosue lacessere diuos," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/3/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/3> ;
      zoo:text "Contra mille feras et non sine carmine nisus," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/42/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/42> ;
      zoo:text "canaque e maele galeri," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/54/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/54> ;
      zoo:text "' Te primum, Vulcane, loci pacemque precamur" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/17/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/17> ;
      zoo:text "Se dederit teretisque ferent ad sidera uirgae," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/61/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/61> ;
      zoo:text "Glaucum: nempe ingens, nempe ardua fundet in" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/32/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/32> ;
      zoo:text "Exercere uelis, aut te tua culpa refellet" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/60/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/60> ;
      zoo:text "Praeueniunt teneraque extrudens cornua fronte" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/14/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/14> ;
      zoo:text "Quid Macetum inmensos libeat si dicere contos ?" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/15/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/15> ;
      zoo:text "Et magis in contos operae lutoser, agrestis" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/59/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/59> ;
      zoo:text "Supplicibusque uocanda sacris tutela deorum." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/50/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/50> ;
      zoo:text "si referam? non illa metus solacia falsi tam longam traxere fidem. collaribus ergo sunt qui lucifugae cristas inducere maelis iussere aut sacris conserta monilia conchis et vivum lapidem et circa Melitensia nectunt curalia et magicis adiutas cantibus herbas. ac sic offectus oculique venena maligni vicit tutela pax impetrata deorum." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/35/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/35> ;
      zoo:text "Primi complexus, dulcissuma prima uoluptas :" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/36/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/36> ;
      zoo:text "Verum ubi Caurino perstrinxit frigore Vesper," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/65/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/65> ;
      zoo:text "spadices vix Pellaei valuere Cerauni; at tibi devotae magnum pecuaria Cyrrhae, Phoebe, decus meruere, levis seu iungere currus usus, seu nostras agere in sacraria tensas. venanti melius pugnat color: optima nigra crura illi badiosque legant et a * * * et quorum fessas imitantur terga favillas. o quantum Italiae (sic di voluere) parentes praestant et terras omni praecepimus usu nostraque quam pernix collustrat prata iuventus!" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/38/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/38> ;
      zoo:text "Nec luxus alios auidaeque impendia uitae" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/21/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/21> ;
      zoo:text "Et uocat extremo praeceps discrimine Mauors," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/11/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/11> ;
      zoo:text "Interdum Libyco fucantur sandyce pinnae" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/56/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/56> ;
      zoo:text "Qui pretio fratrum meliorisque ausus amici" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/57/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/57> ;
      zoo:text "Hinc uenit auxilium ualida uementius ira," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/42/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/42> ;
      zoo:text "Ima Toletano praecingant ilia cultro" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/17/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/17> ;
      zoo:text "Stringe notas circum et gemmantis exige uersus." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/32/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/32> ;
      zoo:text "Ac non est alius quem tanta ad munia fetus" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/61/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/61> ;
      zoo:text "auras" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/60/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/60> ;
      zoo:text "Haedus et ad ramos etiamnum haerentia poma," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/38/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/38> ;
      zoo:text "Nec mirum: humanos non res magis altera sensus" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/53/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/53> ;
      zoo:text "facta est medicina vadis. nec non tamen illum spumosi catulos mergentem litoris aestu respicit et facilis Paean adivvit in artes. o rerum prudens quantam experientia vulgo materiem largita boni, si vincere curent desidiam et gratos agitando prendere finis! est in Trinacria specus ingens rupe cavique introsum reditus, circum atrae moenia silvae alta premunt ruptique ambustis faucibus amnes;" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/14/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/14> ;
      zoo:text "Mos et ab expertis festinant usibus omnes." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/15/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/15> ;
      zoo:text "Taxique pinusque Altinatesque genestae" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/54/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/54> ;
      zoo:text "Incola sancte tuam : da fessis ultima rebus" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/59/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/59> ;
      zoo:text "Mitte age (non opibus tanta est fiducia nostris)," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/59/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/59> ;
      zoo:text "Mitte, anime. ex alto ducendum numen Olympo" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/42/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/42> ;
      zoo:text "Terribilemque manu uibrata falarica dextra" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/35/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/35> ;
      zoo:text "Hunc Veneri dedit inpatiens natura furorem." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/36/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/36> ;
      zoo:text "ProIra iacet turbaque potens operitur inerti." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/38/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/38> ;
      zoo:text "Noscant. haec magno redit indulgentia damno." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/21/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/21> ;
      zoo:text "At magnum cum uenit opus promendaque uirtus" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/11/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/11> ;
      zoo:text "Hic magis in ceruos ualuit metus. ast ubi lentae" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/56/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/56> ;
      zoo:text "O quisquis misero fas umquam in supplice fregit," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/57/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/57> ;
      zoo:text "Acrior aut leto propior uia? sed tamen illi" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/23/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/23> ;
      zoo:text "Sensum agilem, traxere animos de patre Gelonae" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/25/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/25> ;
      zoo:text "Quodsi maturo pressantes gaudia lusu" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/48/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/48> ;
      zoo:text "Praecipitat letale malum : sic tutius ergo" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/31/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/31> ;
      zoo:text "Finxit. non alio maior sub pectore uirtus," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/54/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/54> ;
      zoo:text "Huc defecta mala uidi pecuaria tabe" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/24/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/24> ;
      zoo:text "Ocior adfectu mentis pinnaque cucurrit," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/62/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/62> ;
      zoo:text "Est animus fingetque meas se iussus in artes :" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/13/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/13> ;
      zoo:text "Ille etiam ualido primus uenabula dente" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/36/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/36> ;
      zoo:text "Siti Ubera tota tenet, stat tergo liber aperto" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/33/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/33> ;
      zoo:text "Quod magnos capiat motus magnisque supersit." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/56/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/56> ;
      zoo:text "Obsequiturque deo, deus illam molliter aram" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/4/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/4> ;
      zoo:text "Per senos circum usque sinus laqueabis, ut omnem" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/18/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/18> ;
      zoo:text "Arma negant contra Martemque odere Geloni;" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/2/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/2> ;
      zoo:text "Firmamenta dedit : tum partis quisque secutus" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/25/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/25> ;
      zoo:text "Dissimulare feras tacitique accedere possent," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/51/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/51> ;
      zoo:text "Sparsa malost, ne dira trahant contagia uulgi." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/15/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/15> ;
      zoo:text "quocirca et iaculis habilem perpendimus usum: neu leve vulnus eat neu sit brevis impetus illi. ipsa arcu Lyciaque suos Diana pharetra armavit comites: ne tela relinquite divae: magnum opus et volucres quondam fecere sagittae. disce agedum et validis dilectum hastilibus omnem. plurima Threiciis nutritur vallibus Hebri cornus et umbrosae Veneris per litora myrtus taxique pinusque Altinatesque genestae et magis incomptos opera iuturus agrestis" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/48/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/48> ;
      zoo:text "Antire auxiliis et primas uincere causas." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/48/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/48> ;
      zoo:text "Pluruma per catulos rabies inuictaque tardis" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/54/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/54> ;
      zoo:text "Saepe trahi uictosque malo grauiore magistros." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/23/text/11>
      a       zoo:Paragraph ;
      zoo:identifier 11 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/23> ;
      zoo:text "Hyrcano et uanae tantum Calydonia linguae" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/31/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/31> ;
      zoo:text "Hic et semiferam thoum de sanguine prolem" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/56/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/56> ;
      zoo:text "o quisquis misero fas umquam in supplice fregit, quis pretio fratrum meliorisque ausus amici sollicitare caput patriosve lacessere divos, illum agat infandae comes huc audacia culpae: discet commissa quantum deus ultor in ira pone sequens valeat. sed cui bona pectore mens est obsequiturqueque deo, deus illam molliter aram lambit et ipse, suos ubi contigit ignis honores, defugit a sacris rursumque reconditur antro:" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/24/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/24> ;
      zoo:text "Et pictam macula uertraham delige falsa." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/19/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/19> ;
      zoo:text "Sunt qui Seras alant, genus intractabilis irae :" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/21/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/21> ;
      zoo:text "quid, freta si Morinum dubio refluentia ponto veneris atque ipsos libeat penetrare Britannos? o quanta est merces et quantum impendia supra, si non ad speciem mentiturosque decores (parvis haec una est catulis iactura Britannis), at magnum cum venit opus promendaque virtus et vocat extremo praeceps discrimine mavors: non tunc egregios tantum admirere Molossos," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/13/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/13> ;
      zoo:text "Iussit adire suas et pandere gentibus artes ." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/36/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/36> ;
      zoo:text "Dum tepida indulget terris clementia mundi." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/43/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/43> ;
      zoo:text "Haec tua militia est. quin et Mauortia bello" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/18/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/18> ;
      zoo:text "Sed natura sagax: Perses in utroque paratus." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/4/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/4> ;
      zoo:text "Tunc ipsum medio cassem qui nascitur ore" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/56/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/56> ;
      zoo:text "mens est" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/51/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/51> ;
      zoo:text "Miscuit et summam conplectitur ignis in unam." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/21/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/21> ;
      zoo:text "Non tunc egregios tantum admirere Molossos." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/25/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/25> ;
      zoo:text "Illis omne decus, quod nunc, metagontes, habetis," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/2/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/2> ;
      zoo:text "Sed primum auspicium deus artibus altaque circa" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/51/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/51> ;
      zoo:text "Quodsi dat spatium clemens et promonet ortu" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/18/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/18> ;
      zoo:text "Mille canum patriae ductique ab origine mores" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/54/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/54> ;
      zoo:text "Vulcano condicta domus. quam subter eunti" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/24/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/24> ;
      zoo:text "Petroniusost haec fama cano, uolucresque Sycambros" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/61/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/61> ;
      zoo:text "Crura; quis Eleas potior lustranit harenas ?" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/38/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/38> ;
      zoo:text "Dum seruata cauis potant Mareotica gemmis" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/19/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/19> ;
      zoo:text "At contra faciles magnique Lycaones armis." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/13/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/13> ;
      zoo:text "Auctoremque operi dignata inscribere magno" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/36/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/36> ;
      zoo:text "Iamque illum inpatiens aequae uehementia sortis" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/4/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/4> ;
      zoo:text "Illa operum patiens, illa usus linea longi." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/51/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/51> ;
      zoo:text "Morbus, disce uias et qua sinit artibus exi." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/56/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/56> ;
      zoo:text "Pone sequens ualeat. sed cui bona pectore" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/48/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/48> ;
      zoo:text "(Vermiculum dixere) mala atque incondita pestis." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/8/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/8> ;
      zoo:text "Imbiberit, tanto respondet longior usus." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/9/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/9> ;
      zoo:text "Sunt quibus inmundo decerptae uolture plumae" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/24/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/24> ;
      zoo:text "Aut uersuta sequi leporis uestigia parui," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/54/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/54> ;
      zoo:text "Stagna sedent uenis oleoque madentia uiuo." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/18/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/18> ;
      zoo:text "Quoique sua. magna indocilis dat proelia Medus" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/19/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/19> ;
      zoo:text "Sed non Hyrcano satis est uehementia gentis" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/38/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/38> ;
      zoo:text "Nardiferumque metunt Gangen uitiisque ministrant." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/26/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/26> ;
      zoo:text "sed primum celsa lorum cervice ferentem, Glympice, te silvis egit Boeotius Hagnon, Hagnon Astylides, Hagnon, quem plurima semper gratia per nostros unum testabitur usus. hic trepidas artis et vix novitate sedentes vidit qua propior peteret via nec sibi turbam contraxit comitem nec vasa tenentia longe: unus praesidium atque operi spes magna petito adsumptus metagon lustrat per nota ferarum pascua, per fontes, per quas trivere latebras." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/13/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/13> ;
      zoo:text "Ergo illum primis nemorum dea finxit in armis" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/36/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/36> ;
      zoo:text "Extulit : adfectat materna regna sub aluo," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/37/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/37> ;
      zoo:text "Illius et manibus uires sit cura futuras" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/4/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/4> ;
      zoo:text "Limbum et quadruplicis tormento adstringere limbos :" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/51/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/51> ;
      zoo:text "Tunc et odorato medicata bitumina uino" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/18/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/18> ;
      zoo:text "Magnaque diuersos extollit gloria Celtas." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/56/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/56> ;
      zoo:text "Discet commissa quantum deus ultor in ira" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/10/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/10> ;
      zoo:text "tantum inter nivei iungantur vellera cygni, et satis armorum est. haec clara luce coruscant terribiles species, at vulture dirus ab atro turbat odor silvas meliusque alterna valet res. sed quam clara tuis et pinguis pluma sub armis, tam mollis tactu et non sit creberruma nexu, ne reprensa suis properantem linea pennis implicet atque ipso mendosa coarguat usu." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/9/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/9> ;
      zoo:text "Instrumentum operis fuit et non parua facultas." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/48/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/48> ;
      zoo:text "Namque subit nodis qua lingua tenacibus haeret" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/8/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/8> ;
      zoo:text "Magnum opus ettangi, nisi curauincitur, inpar." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/38/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/38> ;
      zoo:text "lacte novam pubem facilique tuebere maza, nec luxus alios avidaeque impendia vitae noscant: haec magno redit indulgentia damno. nec mirum: humanos non est magis altera sensus, tollit ni ratio et vitiis adeuntibus obstat. haec illast Pharios quae fregit noxia reges, dum servata cavis potant Mareotica gemmis nardiferumque metunt Gangen vitiisque ministrant." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/55/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/55> ;
      zoo:text "Hic dictu mirum atque alias ignobile monstrum" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/24/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/24> ;
      zoo:text "Tangit opus pauidosque iuuat conpellere dorcas" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/26/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/26> ;
      zoo:text "Pascua, per fontes, per quas triuere latebras." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/61/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/61> ;
      zoo:text "Admittant. non omne meas genus audet in artis." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/18/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/18> ;
      zoo:text "Cura prior, siue indomitos uehementior hostis" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/32/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/32> ;
      zoo:text "In Venerem iungam. tum sortis cura secunda," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/19/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/19> ;
      zoo:text "Tanta suae : petiere ultro fera semina siluis ;" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/37/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/37> ;
      zoo:text "Haec de pignoribus, nec te mea carmina fallent." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/31/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/31> ;
      zoo:text "Nam genus exiguum et pudeat quam informe fateri," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/62/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/62> ;
      zoo:text "Scilicet et Parthis inter sua mollia rura" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/51/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/51> ;
      zoo:text "at si deformis lacerum dulcedine corpus persequitur scabies, longi via pessima leti: in primo accessu tristis medicina, sed una pernicies redimenda anima, quae prima sequaci sparsa malost, ne dira trahant contagia vulgus. quodsi dat spatium clemens et promonet ortu morbus, disce vias et qua sinit artibus exi. tunc et odorato medicata bitumina vino Hipponiasque pices neglectaeque unguen amurcae miscuit et summam complectitur ignis in unam." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/43/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/43> ;
      zoo:text "Stat Fatum supra totumque auidissimus Orcus" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/37/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/37> ;
      zoo:text "Perpensare: leuis deducet pondere fratres." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/50/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/50> ;
      zoo:text "Ac sic offectus oculique uenena maligni" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/13/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/13> ;
      zoo:text "Et quidam totos clauserunt ensibus" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/45/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/45> ;
      zoo:text "At si pernicies angusto pascitur ore, contra pande viam fallentisque argue causas morborum: in vitio facilis medcina recenti; sed tacta impositis mulcent pecuaria palmis (id satis) aut nigrae circum picis unguine signant; quodsi destricto levis est in vulnere noxa, ipse habet auxilium validae natale salivae. illa gravis labes et curis altior illis, cum vitium causae totis egere latentes corporibus seraque aperitur noxia summa." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/44/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/44> ;
      zoo:text "Mortis enim patuere uiae. tum pura monebo" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/9/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/9> ;
      zoo:text "Exige si qua meis respondet ab artibus ergo" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/25/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/25> ;
      zoo:text "Sparta suos et Creta suos promittit alumnos :" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/51/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/51> ;
      zoo:text "Hipponiasqué pices neclectaeque unguen amurcae" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/64/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/64> ;
      zoo:text "sic et Strymonio facilis tutela Bisaltae: possent Aetnaeas utinam se ferre per arces, qui ludus Siculis. quid tum, si turpia colla aut tenuis dorso curvatur spina? per illos cantatus Graiis Acragas victaeque fragosum Nebroden liquere fera: (o quantus in armis ille meis quoius dociles pecuaria fetus sufficient) quis Chaonios contendere contra ausit, vix merita quos signat Achaia palma?" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/4/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/4> ;
      zoo:text "armorum casses, plagiique exordia, restes, prima iubent tenui nascentem iungere filo limbum et quadruplicis tormento adstringere limbos: illa operum patiens, illa usus linea longi tunc ipsum e medio cassem quo nascitur ore per senos circum usque sinus laqueabis, ut omni concipiat tergo, si quisquam est plurimus, hostem. at" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/26/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/26> ;
      zoo:text "Vnus praesidium atque operi spes magna petito" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/55/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/55> ;
      zoo:text "Aduersis speciebus ruptoque e pectore montis" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/24/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/24> ;
      zoo:text "Et sequitur natura fauens. at te leue si qua" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/61/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/61> ;
      zoo:text "Est uitium ex animo, sunt quos imbellia fallant" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/18/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/18> ;
      zoo:text "Nudo Marte premas seu bellum ex arte ministres." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/16/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/16> ;
      zoo:text "Detrahe : frondosas grauat indulgentia siluas." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/19/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/19> ;
      zoo:text "Dat Venus accessus et blando foedere iungit." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/27/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/27> ;
      zoo:text "primae lucis opus: tum signa vapore ferino intemerata legens si quast qua fallitur eius turba loci, maiore secat spatia extera gyro; atque hic egressu iam tum sine fraude reperto incubuit, spatiis qualis permissa Lechaeis Thessalium quadriga decus, quam gloria patrum excitat et primae spes ambitiosa coronae." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/32/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/32> ;
      zoo:text "Et primum expertos animi, quae gratia primast," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/62/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/62> ;
      zoo:text "Mansit honor : ueniat Caudini saxa Taburni" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/37/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/37> ;
      zoo:text "Protinus et cultus alios et debita fetae" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/31/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/31> ;
      zoo:text "Et subiere astu et paruis domuere lacertis." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/36/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/36> ;
      zoo:text "Signa dabunt ipsi. teneris uix artibus haeret" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/36/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/36> ;
      zoo:text "Ille tuos olim non defecturus honores." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/43/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/43> ;
      zoo:text "Pascitur et nigris orbem circumsonat alis." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/50/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/50> ;
      zoo:text "Vicit tutela pax impetrata deorum." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/13/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/13> ;
      zoo:text "Dentibus et gemina subiere hastilia furca" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/44/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/44> ;
      zoo:text "Circum labra sequi tenuique includere filo." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/39/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/39> ;
      zoo:text "sic et Achaemenio cecidisti, Lydia, Cyro: atqui dives eras ac fluminis aurea venis. scilicet ad summam ne quid restaret habendi, tu quoque luxuriae fictas dum colligis artes et sequeris demens alienam, Graecia, culpam, o quantum et quotiens decoris frustrata paterni! at qualis nostris, quam simplex mensa Camillis! qui tibi cultus erat post tot, Serrane, triumphos!" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/26/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/26> ;
      zoo:text "Adsumptus metagon lustrat per nota ferarum" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/49/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/49> ;
      zoo:text "Quid priscas artes inuentaque simplicis aeui" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/9/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/9> ;
      zoo:text "Gratia, quae uires fallat conlata ferinas." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/31/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/31> ;
      zoo:text "Thoes commissos (clarissima fama) leones" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/23/text/12>
      a       zoo:Paragraph ;
      zoo:identifier 12 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/23> ;
      zoo:text "Exibit uitium patre emendata Molosso." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/24/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/24> ;
      zoo:text "Scilicet ex omni florem uirtute capessunt" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/33/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/33> ;
      zoo:text "sint celsi vultus, sint hirtae frontibus aures, os magnum, et patulis agitatos naribus ignes spirent, adstricti succingant ilia ventres, cauda brevis longumque latus discretaque collo caesaries neu pexa nimis neu frigoris illa impatiens; validis tum surgat pectus ab armis, quod magnos capiat motus magnisque supersit." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/55/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/55> ;
      zoo:text "Venit ouans Austris et multo flumine flammae" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/19/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/19> ;
      zoo:text "Tunc et mansuetis tuto ferus errat adulter" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/62/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/62> ;
      zoo:text "Garganumue trucem aut Ligurinas desuper Alpes," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/37/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/37> ;
      zoo:text "Blandimenta feres curaque sequere merentem :" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/43/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/43> ;
      zoo:text "Vulnera et errantes per tot diuortia morbos" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/3/text/2>
      a       zoo:Paragraph ;
      zoo:identifier 2 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/3> ;
      zoo:text "Mentem omnes nemorum, mentem de fontibus omnes" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/50/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/50> ;
      zoo:text "Et uiuum lapidem et circa Melitesia nectunt" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/13/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/13> ;
      zoo:text "Omne moris excepit onus. tum stricta uerutis" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/19/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/19> ;
      zoo:text "In stabulis ultroque grauem succedere tigrin" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/49/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/49> ;
      zoo:text "Blanditur mensis Cereremque efflagitat ore." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/9/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/9> ;
      zoo:text "Omnia temptantem qua laus erat obuia passa est," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/25/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/25> ;
      zoo:text "Constaret silua : sed uirtus irrita damno est." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/18/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/18> ;
      zoo:text "Lustramus ? prima illa canum, non ulla per artis" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/31/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/31> ;
      zoo:text "Siue mora uocis seu nudi ad pignera Martis." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/55/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/55> ;
      zoo:text "Emicat : ipse manu ramum pallente sacerdos" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/32/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/32> ;
      zoo:text "Ne renuat species aut qua detractet honorem." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/62/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/62> ;
      zoo:text "Ante opus excussis cadet unguibus. et tamen illi" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/57/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l/57> ;
      zoo:text "huic fas auxilium et Vulcania tangere dona. nec mora, si medias exedit noxia fibras, his lave praesidiis adfectaque corpora mulce: regnantem excuties morbum. deus auctor, et ipsa artem aluit natura suam. quae robore pestis acrior aut leto propior via? sed tamen illi hinc venit auxilium valida vehementius ira. quod primam si fallet opem dimissa facultas, at tu praecipitem qua spes est proxima labem adgredere: in subito subita et medicina tumultu." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/61/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/61> ;
      zoo:text "Restat equos finire notis, quos arma Dianae" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/37/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/37> ;
      zoo:text "Illa perinde suos, ut erit deuincta, minores" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/7/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/7> ;
      zoo:text "Ignibus et claro Plias se prompserit ortu." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/3/text/1>
      a       zoo:Paragraph ;
      zoo:identifier 1 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/3> ;
      zoo:text "Adsciuere tuo comites sub numine diuae" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/43/text/3>
      a       zoo:Paragraph ;
      zoo:identifier 3 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/43> ;
      zoo:text "Causasque adfectusque canum tua tuerist." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/50/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/50> ;
      zoo:text "Curalia et magicis adiutas cantibus herbas." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/13/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/13> ;
      zoo:text "Induit et proni moderatus uulneris iram" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/56/text/9>
      a       zoo:Paragraph ;
      zoo:identifier 9 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/56> ;
      zoo:text "Lambit et ipse suos ubi contigit ignis honores," .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/19/text/8>
      a       zoo:Paragraph ;
      zoo:identifier 8 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/19> ;
      zoo:text "Ausus canis maiore tulit de sanguine fetum." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/9/text/4>
      a       zoo:Paragraph ;
      zoo:identifier 4 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/9> ;
      zoo:text "Hinc decus et famae primum inpetrauit honorem." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/49/text/6>
      a       zoo:Paragraph ;
      zoo:identifier 6 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/49> ;
      zoo:text "Ecce aderit factique oblitus uulneris ultro" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/4/text/7>
      a       zoo:Paragraph ;
      zoo:identifier 7 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/4> ;
      zoo:text "Concipiat tergo, si quisquam est plurimus, hostem." .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/25/text/5>
      a       zoo:Paragraph ;
      zoo:identifier 5 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/25> ;
      zoo:text "At uestrum non uile genus, non patria. uulgo" .

<http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/54/text/10>
      a       zoo:Paragraph ;
      zoo:identifier 10 ;
      zoo:isPartOf <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/54> ;
      zoo:text "Tura foco, struitur ramis felicibus ara." .


<http://ns.inria.fr/zoomathia/annotation/51bc28a772a208fdeee6f12c11fc459ff9ac4db4>
