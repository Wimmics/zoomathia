                        ] ;
                oa:hasSource <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/l_2/1/text>
              ] .

<http://ns.inria.fr/zoomathia/annotation/d91faef5c2aa309c831df0480c40ebe29b34fb52>
      a       zoo:AutomaticAnnotation ;
      oa:hasBody <http://dbpedia.org/resource/Spirit_possession> ;
      oa:hasTarget
              [ oa:hasSelector
                        [ a       oa:TextPositionSelector , oa:TextQuoteSelector ;
