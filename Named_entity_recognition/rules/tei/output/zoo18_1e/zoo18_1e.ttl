<http://ns.inria.fr/zoomathia/annotation/5089cfee642a6f01654e06271dda52001c2cb93e>
      a       zoo:AutomaticAnnotation ;
      oa:hasBody <https://opentheso.huma-num.fr/?idc=107576&idt=th310> ;
      oa:hasTarget
              [ oa:hasSelector
                        [ a       oa:TextPositionSelector , oa:TextQuoteSelector ;
