              ] .

<http://ns.inria.fr/zoomathia/annotation/3e1a78c82bfe2f5b3deda9b28cd99e1a629672f0>
      a       zoo:AutomaticAnnotation ;
      oa:hasBody <https://opentheso.huma-num.fr/?idc=105983&idt=th310> ;
      oa:hasTarget
              [ oa:hasSelector
                        [ a       oa:TextPositionSelector , oa:TextQuoteSelector ;
                          oa:exact "fat"
                        ] ;
                oa:hasSource <http://ns.inria.fr/zoomathia/HIPPOCRATES/on_regimen_in_acute_diseases_appendix,_spurious/e/10/text/1>
              ] .

