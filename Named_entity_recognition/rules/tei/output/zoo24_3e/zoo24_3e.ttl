              ] .

<http://ns.inria.fr/zoomathia/annotation/579d2c9cc4b398dc706c2b161a6f4316a7efec04>
      a       zoo:AutomaticAnnotation ;
      oa:hasBody <http://dbpedia.org/resource/Blond> ;
      oa:hasTarget
