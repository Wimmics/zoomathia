<http://ns.inria.fr/zoomathia/BASILIUS/ὁμιλίαι_θʹ_εἰς_τὴν_ἑξαήμερον/g>
      a       zoo:Oeuvre ;
      zoo:author "BASILIUS" ;
      zoo:date "1999" ;
      zoo:editor "Unknown editor" ;
