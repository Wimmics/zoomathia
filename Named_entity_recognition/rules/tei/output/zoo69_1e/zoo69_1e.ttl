                        ] ;
                oa:hasSource <http://ns.inria.fr/zoomathia/PHILO_ALEXANDRINUS/on_the_eternity_of_the_world/e/99/text/1>
              ] .

<http://ns.inria.fr/zoomathia/annotation/e5f671977fb240ff985b2a42d97a7fc44309423b>
      a       zoo:AutomaticAnnotation ;
      oa:hasBody <http://dbpedia.org/resource/Water> ;
      oa:hasTarget
              [ oa:hasSelector
                        [ a       oa:TextPositionSelector , oa:TextQuoteSelector ;
                          oa:exact "water"
                        ] ;
                oa:hasSource <http://ns.inria.fr/zoomathia/PHILO_ALEXANDRINUS/on_the_eternity_of_the_world/e/87/text/1>
              ] .

<http://ns.inria.fr/zoomathia/annotation/945a5e1d07995f96ca9d69cfaafc6d8916f7fcc9>
      a       zoo:AutomaticAnnotation ;
      oa:hasBody <https://opentheso.huma-num.fr/?idc=107576&idt=th310> ;
