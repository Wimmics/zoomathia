              ] .

<http://ns.inria.fr/zoomathia/annotation/80df6203fa3180925283ea22618676be82e9149a>
      a       zoo:AutomaticAnnotation ;
      oa:hasBody <https://opentheso.huma-num.fr/?idc=106471&idt=th310> ;
      oa:hasTarget
