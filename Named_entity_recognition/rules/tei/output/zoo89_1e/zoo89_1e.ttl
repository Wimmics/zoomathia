<http://ns.inria.fr/zoomathia/annotation/636db926056c21b21c7dae9019fbe8f0ff938bbf>
      a       zoo:AutomaticAnnotation ;
      oa:hasBody <https://opentheso.huma-num.fr/?idc=105468&idt=th310> ;
      oa:hasTarget
