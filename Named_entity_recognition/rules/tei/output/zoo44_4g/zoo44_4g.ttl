<http://ns.inria.fr/zoomathia/PLUTARCHUS/περὶ_τοῦ_τὰ_ἄλογα_λόγῳ_χρῆσθαι/g>
      a       zoo:Oeuvre ;
      zoo:author "PLUTARCHUS" ;
      zoo:date "1895" ;
      zoo:editor "Grēgorios N. Vernardakēs" ;
