<http://ns.inria.fr/zoomathia/XENOPHON/agesilaus/e/11/14/text/1>
      a       zoo:Paragraph ;
      zoo:hasAnnotation <http://ns.inria.fr/zoomathia/annotation/01c6198b1eb8281e955c5f898d42efafe95a9626> , <http://ns.inria.fr/zoomathia/annotation/19ab755e3e94290d0fe63969446de3739991fec5> , <http://ns.inria.fr/zoomathia/annotation/9e3d01bb51d5bea96eb7d44ba1481bb3a7095d9b> , <http://ns.inria.fr/zoomathia/annotation/eade4e873b4f4702cd93f3d5f15e3ff50a06df05> , <http://ns.inria.fr/zoomathia/annotation/3022530be6df457e0fac09c1dfc74ad74b0736e9> , <http://ns.inria.fr/zoomathia/annotation/9e9cb4bc1b358a947cca4c87288ddc95601daa01> , <http://ns.inria.fr/zoomathia/annotation/b15b64fd27c1b1eb62cdc2a8890ad69095a911cc> , <http://ns.inria.fr/zoomathia/annotation/2309989166576a4039236d2a3b89fdbf26c3ede5> , <http://ns.inria.fr/zoomathia/annotation/557522c9b7df0f3b8dc5e9ba2b61a531bd5e7737> , <http://ns.inria.fr/zoomathia/annotation/16dbadedfc59da5f988b71c1c9eb876c5098ca6c> , <http://ns.inria.fr/zoomathia/annotation/4d1ed197e5e8e25440036035f1ff9d992dddb273> , <http://ns.inria.fr/zoomathia/annotation/f085213c4b9f8a6f6abbb22e81aad9f15c4e1983> .

