                        ] ;
                oa:hasSource <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/e/52/text/1>
              ] .

<http://ns.inria.fr/zoomathia/annotation/9be89ce44a62e31209634e4c201eb17d89c9db78>
      a       zoo:AutomaticAnnotation ;
      oa:hasBody <http://dbpedia.org/resource/Life> ;
      oa:hasTarget
              [ oa:hasSelector
                        [ a       oa:TextPositionSelector , oa:TextQuoteSelector ;
                          oa:exact "life"
                        ] ;
                oa:hasSource <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/e/51/text/1>
              ] .

<http://ns.inria.fr/zoomathia/annotation/57c3778cdd983752dea19c6d148e30613fe5b2f0>
      a       zoo:AutomaticAnnotation ;
      oa:hasBody <https://opentheso.huma-num.fr/?idc=105909&idt=th310> ;
