              ] .

<http://ns.inria.fr/zoomathia/annotation/4713bc119743699ceaac8199e72b090f73da40c4>
      a       zoo:AutomaticAnnotation ;
      oa:hasBody <http://dbpedia.org/resource/University_of_Oxford> ;
      oa:hasTarget
              [ oa:hasSelector
                        [ a       oa:TextPositionSelector , oa:TextQuoteSelector ;
                          oa:exact "great"
                        ] ;
                oa:hasSource <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/e/43/text/1>
              ] .

<http://ns.inria.fr/zoomathia/annotation/066a652da75367bcdc5d093301db4af057a3c143>
      a       zoo:AutomaticAnnotation ;
      oa:hasBody <http://dbpedia.org/resource/Leisure> ;
      oa:hasTarget
              [ oa:hasSelector
                        [ a       oa:TextPositionSelector , oa:TextQuoteSelector ;
                          oa:exact "rest"
                        ] ;
                oa:hasSource <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/e/36/text/1>
              ] .

<http://ns.inria.fr/zoomathia/annotation/8585dbf61ff53e1f1fc6e4a72486dccb0b96df70>
      a       zoo:AutomaticAnnotation ;
      oa:hasBody <https://opentheso.huma-num.fr/?idc=pcrtxotyT9vuQM&idt=th310> ;
      oa:hasTarget
              [ oa:hasSelector
                        [ a       oa:TextPositionSelector , oa:TextQuoteSelector ;
                          oa:exact "Adonis"
                        ] ;
                oa:hasSource <http://ns.inria.fr/zoomathia/GRATTIUS/cynegetica/e/8/text/1>
              ] .

<http://ns.inria.fr/zoomathia/annotation/8757e4bfbda1aa892c55ceb563031c4dde812455>
