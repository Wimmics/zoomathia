      zoo:isPartOf <http://ns.inria.fr/zoomathia/SEMONIDES_AMORGINUS/ἐλεγεῖα_σημωνίδου/g/1> ;
      zoo:text "σίσυν παχεῖαν" .

<http://ns.inria.fr/zoomathia/SEMONIDES_AMORGINUS/ἐλεγεῖα_σημωνίδου/g/1/text/177>
      a       zoo:Paragraph ;
