      zoo:isPartOf <http://ns.inria.fr/zoomathia/SEMONIDES_AMORGINUS/ἐλεγεῖα_σημωνίδου/g/1> ;
      zoo:text "ἥτις δέ τοι μάλιστα σωφρονεῖν δοκεῖ," .

<http://ns.inria.fr/zoomathia/SEMONIDES_AMORGINUS/ἐλεγεῖα_σημωνίδου/g/1/text/176>
      a       zoo:Paragraph ;
