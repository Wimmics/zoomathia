<http://ns.inria.fr/zoomathia/annotation/b94a4db52ae9437b38266487bb49038b3cbef016>
      a       zoo:AutomaticAnnotation ;
      oa:hasBody <http://dbpedia.org/resource/Fore,_County_Westmeath> ;
      oa:hasTarget
              [ oa:hasSelector
                        [ a       oa:TextPositionSelector , oa:TextQuoteSelector ;
